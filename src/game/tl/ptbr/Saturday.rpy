# game/Saturday.rpy:12
translate ptbr saturday_53ff9b18:

    # unk "{cps=22}{font=ui/belligerent.ttf}I knew you'd be back..."
    unk "{cps=22}{font=ui/belligerent.ttf}Eu sabia que você voltaria..."

# game/Saturday.rpy:13
translate ptbr saturday_22f326c6:

    # unk "{cps=15}{font=ui/belligerent.ttf}You all come back eventually..."
    unk "{cps=15}{font=ui/belligerent.ttf}Todos vocês acabam voltando no final..."

# game/Saturday.rpy:14
translate ptbr saturday_e74710dd:

    # unk "{cps=15}{font=ui/belligerent.ttf}Why do you try to run away in the first place...?"
    unk "{cps=15}{font=ui/belligerent.ttf}Por que você tenta fugir, pra começo de conversa...?"

# game/Saturday.rpy:15
translate ptbr saturday_e7639f89:

    # unk "{cps=15}{font=ui/belligerent.ttf}It doesn't matter..."
    unk "{cps=15}{font=ui/belligerent.ttf}Não importa..."

# game/Saturday.rpy:18
translate ptbr saturday_167f8812:

    # unk "{cps=15}{font=ui/belligerent.ttf}Even though you're here you're going to try and run again..."
    unk "{cps=15}{font=ui/belligerent.ttf}Mesmo estando aqui, você vai tentar fugir de novo..."

# game/Saturday.rpy:19
translate ptbr saturday_5d7b02d3:

    # unk "{cps=15}{font=ui/belligerent.ttf}Just stop..."
    unk "{cps=15}{font=ui/belligerent.ttf}Só pare..."

# game/Saturday.rpy:20
translate ptbr saturday_7235425a:

    # unk "{cps=15}{font=ui/belligerent.ttf}Because just like this town..."
    unk "{cps=15}{font=ui/belligerent.ttf}Porque, assim como esta cidade..."

# game/Saturday.rpy:21
translate ptbr saturday_812b5685:

    # unk "{cps=15}{font=ui/belligerent.ttf}You're only moving in circles..."
    unk "{cps=15}{font=ui/belligerent.ttf}Você só está andando em círculos..."

# game/Saturday.rpy:35
translate ptbr saturday_9a0538c0:

    # m "— Yeah mom, I brought it."
    m "— Sim, mãe, eu trouxe."

# game/Saturday.rpy:36
translate ptbr saturday_dfb98e96:

    # m "— No, no I've got everything."
    m "— Não, não, eu peguei tudo."

# game/Saturday.rpy:37
translate ptbr saturday_ace1c37e:

    # m "— No, TJ's with us, we picked him up yesterday..."
    m "— Não, o TJ tá com a gente, nós pegamos ele ontem..."

# game/Saturday.rpy:38
translate ptbr saturday_02e14b22:

    # m "— No I...I {i}did{/i} call you yesterday, there was no answer."
    m "— Não, eu... Eu {i}liguei{/i} pra você ontem, mas ninguém atendeu."

# game/Saturday.rpy:39
translate ptbr saturday_b24ae358:

    # m "— Fine. Yeah, I'll try more than once next time."
    m "— Tá bom. É, eu vou tentar ligar mais do que uma vez na próxima."

# game/Saturday.rpy:40
translate ptbr saturday_003dae88:

    # m "— So I'm...Of course they're clean!"
    m "— Então eu tô... Lógico que estão limpas!"

# game/Saturday.rpy:41
translate ptbr saturday_a2aac618:

    # m "— Listen, I'm driving right now, so—"
    m "— Escuta, eu tô dirigindo agora, então—"

# game/Saturday.rpy:42
translate ptbr saturday_a8f864f9:

    # m "— Yeah, so I shouldn't be on the phone, should I? I'm gonna hang up."
    m "— É, então eu não deveria estar no celular, né? Vou desligar."

# game/Saturday.rpy:43
translate ptbr saturday_e1b0d5d5:

    # m "— Okay, love you, too... bye."
    m "— Tá, também te amo... tchau."

# game/Saturday.rpy:44
translate ptbr saturday_3c9f07c8:

    # "I sigh and finally hang up the phone, dropping it on my lap."
    "Eu suspiro e finalmente desligo o telefone, largando-o no meu colo."

# game/Saturday.rpy:45
translate ptbr saturday_475e90ff:

    # "TJ, next to me in the passenger seat, stretches back and scratches behind his ear."
    "TJ, do meu lado no banco do passageiro, se espreguiça e coça atrás da orelha."

# game/Saturday.rpy:46
translate ptbr saturday_8d83d075:

    # t "— Aww, that's cute. It's been a while since I've seen your mom. How is she?"
    t "— Aww, que fofo. Faz tempo que eu não vejo a sua mãe. Como ela tá?"

# game/Saturday.rpy:47
translate ptbr saturday_8619f2c6:

    # "I shrug."
    "Eu dou de ombros."

# game/Saturday.rpy:48
translate ptbr saturday_80c31c52:

    # m "— Fine, I think. She wouldn't tell me if she wasn't, anyway."
    m "— Bem, eu acho. Ela não me contaria se não estivesse, de qualquer jeito."

# game/Saturday.rpy:49
translate ptbr saturday_7959e2ed:

    # "TJ taps a foot against the dashboard before yawning."
    "TJ bate o pé no painel antes de bocejar."

# game/Saturday.rpy:50
translate ptbr saturday_11aa54b9:

    # t "— Wow, it feels like we've been driving for daaays."
    t "— Nossa, parece que a gente tá dirigindo há diiiaaasss."

# game/Saturday.rpy:51
translate ptbr saturday_f6013096:

    # "Normally TJ wasn't one to whine, but the long drive was obviously getting to him."
    "Normalmente o TJ não era de reclamar, mas a viagem longa tava obviamente cansando ele."

# game/Saturday.rpy:52
translate ptbr saturday_3494a7d0:

    # "It was getting to all of us, honestly."
    "Sinceramente, estava afetando todo nós."

# game/Saturday.rpy:53
translate ptbr saturday_845e65b7:

    # "I look over at him."
    "Eu dou uma olhada pra ele."

# game/Saturday.rpy:54
translate ptbr saturday_c2c4484e:

    # m "— We're almost there. Why don't you listen to some music, or something?"
    m "— A gente tá quase lá. Por que você não ouve um pouco de música ou algo assim?"

# game/Saturday.rpy:55
translate ptbr saturday_c220d3c0:

    # t "— My phone's been dead for the past two hours. I didn't know it would take us eight hours to get there."
    t "— Meu celular tá descarregado faz umas duas horas. Eu não sabia que ia levar oito horas pra chegar lá."

# game/Saturday.rpy:56
translate ptbr saturday_3f739ce1:

    # "I sigh."
    "Eu suspiro."

# game/Saturday.rpy:57
translate ptbr saturday_d07fb9c8:

    # "Whether that dig was purposeful or not, I still feel a little embarrassed."
    "Se essa alfinetada foi de propósito ou não, eu ainda me sinto um pouco envergonhado."

# game/Saturday.rpy:58
translate ptbr saturday_d3cb5b0e:

    # "I'll admit, I got us lost for a few hours. Route 93 is hard to find, even with the GPS."
    "Eu admito, eu nos deixei perdidos por algumas horas. A Rota 93 é difícil de achar, mesmo com o GPS."

# game/Saturday.rpy:59
translate ptbr saturday_ff3c280c:

    # "It's no wonder that Echo's in the state it's in."
    "Não é à toa que Echo tá no estado que tá."

# game/Saturday.rpy:60
translate ptbr saturday_2f56919e:

    # j "— You should have brought a book, those don't run out of batteries."
    j "— Você deveria ter trazido um livro, eles não ficam sem bateria."

# game/Saturday.rpy:61
translate ptbr saturday_9e0e327a:

    # "I look up into the rearview mirror and see Jenna hold up a hefty book titled 'Cognition'."
    "Eu olho pelo espelho retrovisor e vejo a Jenna segurando um livro grosso intitulado 'Cognição'."

# game/Saturday.rpy:62
translate ptbr saturday_613345d4:

    # "TJ sighs."
    "TJ suspira."

# game/Saturday.rpy:63
translate ptbr saturday_11529a3e:

    # t "— All of my books are on my phone..."
    t "— Todos os meus livros tão no meu celular..."

# game/Saturday.rpy:64
translate ptbr saturday_9c7d0b81:

    # m "— Why don't you listen to the radio?"
    m "— Por que você não ouve o rádio?"

# game/Saturday.rpy:65
translate ptbr saturday_33316d09:

    # "TJ starts to reach for the dial."
    "TJ começa a esticar a mão pro botão do rádio."

# game/Saturday.rpy:66
translate ptbr saturday_f0fb6f14:

    # j "— Don't bother, all we get out here are hick stations. I have some music on my phone, though."
    j "— Nem tenta, a única coisa que pega aqui são rádios de caipira. Mas eu tenho umas músicas no meu celular."

# game/Saturday.rpy:67
translate ptbr saturday_e55b548e:

    # j "— Do you have an AUX cable, Chase?"
    j "— Você tem um cabo de áudio, Chase?"

# game/Saturday.rpy:68
translate ptbr saturday_77add1bf:

    # m "— In this clunker? No, but like I said, we're almost there."
    m "— Nessa lata velha? Não, mas como eu disse, a gente tá quase chegando."

# game/Saturday.rpy:69
translate ptbr saturday_0d1b9f6f:

    # "Just having the three of us here is a little awkward...unbalanced."
    "Estar só nós três aqui é meio estranho... desbalanceado."

# game/Saturday.rpy:70
translate ptbr saturday_42f6f117:

    # "I wonder if completing our little group will bring back that old chemistry."
    "Eu me pergunto se completar o nosso grupinho vai trazer de volta aquela velha química."

# game/Saturday.rpy:71
translate ptbr saturday_bfe0733d:

    # "Thinking about seeing Carl, Flynn, and Leo again makes my heart skip a beat."
    "Pensar em ver o Carl, o Flynn e o Leo de novo faz meu coração bater mais forte."

# game/Saturday.rpy:73
translate ptbr saturday_b6df5546:

    # "GPS" "— Take exit 127 onto Flint Road."
    "GPS" "\"Pegue a saída 127 para a Flint Road.\""

# game/Saturday.rpy:74
translate ptbr saturday_445f1390:

    # "I jerk back to the present and press on the brakes as I swerve onto the exit ramp."
    "Eu volto para o presente num solavanco e piso no freio, entrando bruscamente na rampa de saída."

# game/Saturday.rpy:78
translate ptbr saturday_f869c2d8:

    # t "— Whoa!"
    t "— Opa!"

# game/Saturday.rpy:79
translate ptbr saturday_93549c38:

    # m "— Sorry! Sorry..."
    m "— Foi mal! Desculpa..."

# game/Saturday.rpy:81
translate ptbr saturday_731af7c0:

    # t "— Chase! Come on, pay attention."
    t "— Chase! Qual é, presta atenção."

# game/Saturday.rpy:82
translate ptbr saturday_e8754218:

    # "TJ adds a little giggle to lighten the chastisement, but my face gets hot anyway."
    "TJ dá uma risadinha pra aliviar a bronca, mas meu rosto esquenta do mesmo jeito."

# game/Saturday.rpy:83
translate ptbr saturday_6da3b5e2:

    # m "— Hey, me and Jenna went three hours out of our way to pick you up from CCU, you could have taken the bus."
    m "— Ei, a Jenna e eu desviamos três horas do caminho pra te buscar na CCU, você podia ter pego o ônibus."

# game/Saturday.rpy:84
translate ptbr saturday_78d9f730:

    # t "— No, no, I'm grateful. I'd just rather this not be the place I die, haha."
    t "— Não, não, eu tô agradecido. Eu só prefiro que esse não seja o lugar onde eu morra, haha..."

# game/Saturday.rpy:85
translate ptbr saturday_bdca8b65:

    # "We continue down Flint road for about fifteen minutes in silence while I avoid the ever-increasing number of potholes in the road."
    "A gente continua pela Flint Road por uns quinze minutos em silêncio enquanto eu evito o número cada vez maior de buracos na rua."

# game/Saturday.rpy:86
translate ptbr saturday_5c261286:

    # "I think we're all a little nervous now as we get closer to our destination."
    "Eu acho que nós todos estamos um pouco nervosos agora que nos aproximamos do nosso destino."

# game/Saturday.rpy:87
translate ptbr saturday_1b3bfa97:

    # "Unsurprisingly, there isn't another car in sight."
    "Como era de se esperar, não há nenhum outro carro à vista."

# game/Saturday.rpy:88
translate ptbr saturday_b15b19a7:

    # j "— You guys excited?"
    j "— Vocês estão animados?"

# game/Saturday.rpy:89
translate ptbr saturday_511ef9ca:

    # "I look in my rearview mirror again and see that Jenna has put down her book, staring out the window."
    "Eu olho pelo meu espelho retrovisor de novo e vejo que a Jenna abaixou o livro, olhando pela janela."

# game/Saturday.rpy:90
translate ptbr saturday_d981dbb5:

    # "I actually haven't given a whole lot of thought as to how I feel about the whole thing."
    "Na verdade, eu não parei muito pra pensar em como me sinto sobre tudo isso."

# game/Saturday.rpy:94
translate ptbr saturday_27bc5abb:

    # m "— It'll be great to see everyone again. It's been way too long."
    m "— Vai ser ótimo ver todo mundo de novo. Faz tempo demais."

# game/Saturday.rpy:97
translate ptbr saturday_5bc96c9d:

    # m "— Meh, I'm assuming we'll all just pick up where we left off."
    m "— Meh, eu presumo que a gente só vai continuar de onde parou."

# game/Saturday.rpy:100
translate ptbr saturday_31cd3826:

    # m "— I dunno, it's been a while since we've all been together. Think things will be the same?"
    m "— Sei lá, faz tempo que nós não ficamos todos juntos. Acha que as coisas vão ser as mesmas?"

# game/Saturday.rpy:101
translate ptbr saturday_ea1d243d:

    # j "— I meant Echo. Are you excited to go back?"
    j "— Eu quis dizer sobre Echo. Vocês estão animados pra voltar?"

# game/Saturday.rpy:102
translate ptbr saturday_2d6ee573:

    # m "— Oh."
    m "— Ah."

# game/Saturday.rpy:103
translate ptbr saturday_0ef4fc0a:

    # "I didn't really know how to answer that."
    "Eu não sabia muito bem como responder aquilo."

# game/Saturday.rpy:104
translate ptbr saturday_bdb6be1c:

    # "Is excited the right word?"
    "Será que animado é a palavra certa?"

# game/Saturday.rpy:105
translate ptbr saturday_0ba5a853:

    # "It's sure as hell stressful."
    "Com certeza é estressante pra caralho."

# game/Saturday.rpy:106
translate ptbr saturday_ba185805:

    # t "— As long as we can go for a hike."
    t "— Contanto que a gente possa fazer uma trilha."

# game/Saturday.rpy:107
translate ptbr saturday_e89a2006:

    # t "— I don't wanna be sitting around in the motel all day."
    t "— Não quero ficar sentado de bobeira no motel o dia todo."

# game/Saturday.rpy:108
translate ptbr saturday_66686c17:

    # j "— Well it beats having a heat stroke in the desert. Are you seriously hiking the trail?"
    j "— Bom, é melhor do que ter uma insolação no deserto. Você vai mesmo fazer a trilha?"

# game/Saturday.rpy:109
translate ptbr saturday_49166a8c:

    # t "— Oh come on, it'll be fun! At least I know Chase'll come."
    t "— Ah qual é, vai ser divertido! Pelo menos eu sei que o Chase vai vir."

# game/Saturday.rpy:110
translate ptbr saturday_eb6b8f5f:

    # "TJ smiles at me, raising his brows."
    "TJ sorri pra mim, erguendo as sobrancelhas."

# game/Saturday.rpy:111
translate ptbr saturday_3999c398:

    # "It's too hard to say no to such an eager face...at least right now."
    "É difícil demais dizer não pra um rosto tão empolgado... pelo menos agora."

# game/Saturday.rpy:112
translate ptbr saturday_176a4927:

    # m "— Yeah, yeah, of course."
    m "— Sim, sim, claro."

# game/Saturday.rpy:113
translate ptbr saturday_26ff62cc:

    # j "— Anyway, it sounds like you've only got the boys on your mind, Chase."
    j "— De qualquer jeito, parece que você só tem os garotos na cabeça, Chase."

# game/Saturday.rpy:114
translate ptbr saturday_ffe605fe:

    # j "— ...Leo, maybe?"
    j "— ...O Leo, talvez?"

# game/Saturday.rpy:116
translate ptbr saturday_2d88c4bd:

    # "GPS" "— Make a slight right onto Lake Emma Road."
    "GPS" "\"Vire ligeiramente à direita para a Lake Emma Road.\""

# game/Saturday.rpy:117
translate ptbr saturday_6df43fd7:

    # "I ignore Jenna, pretending to be distracted with adjusting the GPS."
    "Eu ignoro a Jenna, fingindo estar distraído ajustando o GPS."

# game/Saturday.rpy:118
translate ptbr saturday_fde3ed82:

    # "A few more minutes of silence pass before Jenna speaks up again."
    "Mais alguns minutos de silêncio se passam antes que a Jenna fale de novo."

# game/Saturday.rpy:119
translate ptbr saturday_22ddccf7:

    # j "— Soo, this news thing you're making, what's it about, exactly?"
    j "— Entãão, esse lance de notícias que você tá fazendo, é sobre o quê exatamente?"

# game/Saturday.rpy:120
translate ptbr saturday_7757afa0:

    # "I swerve a little to avoid another pothole."
    "Eu desvio um pouco pra evitar outro buraco."

# game/Saturday.rpy:121
translate ptbr saturday_c2f8a061:

    # m "— A news packet."
    m "— Um pacote de notícias."

# game/Saturday.rpy:122
translate ptbr saturday_d6a1d323:

    # m "— If you remember there was that one crazy thing that happened here in the early 1900s."
    m "— Se você se lembra, teve aquela coisa maluca que aconteceu aqui no começo dos anos 1900."

# game/Saturday.rpy:123
translate ptbr saturday_a4212359:

    # m "— I read a little bit about it and it's pretty fucked up."
    m "— Eu li um pouco sobre isso e é bem fodido."

# game/Saturday.rpy:124
translate ptbr saturday_207a550b:

    # t "— Come on, Chase, language."
    t "— Qual é, Chase, o linguajar."

# game/Saturday.rpy:125
translate ptbr saturday_a2d63667:

    # m "— Just thought I'd do a little more digging."
    m "— Só pensei em investigar um pouco mais a fundo."

# game/Saturday.rpy:126
translate ptbr saturday_4a23424f:

    # m "— Honestly, though, I just need to make something that looks good enough to pass with."
    m "— Sinceramente, no entanto, eu só preciso fazer algo que pareça bom o bastante pra passar."

# game/Saturday.rpy:127
translate ptbr saturday_00edbaef:

    # j "— Well that sounds kinda fun. Are you going to have enough time to hang out? I know Leo made some plans."
    j "— Bom, isso parece um tanto divertido. Você vai ter tempo o bastante pra sair com a gente? Sei que o Leo fez uns planos."

# game/Saturday.rpy:128
translate ptbr saturday_9dc89e5a:

    # "This whole thing was Leo's idea, actually."
    "Essa coisa toda foi ideia do Leo, na verdade."

# game/Saturday.rpy:129
translate ptbr saturday_8a585091:

    # "When I told him that I'd be coming down to Echo for spring break he suggested we all use it as an excuse to have a reunion."
    "Quando eu falei pra ele que ia vir pra Echo nas férias de primavera, ele sugeriu que a gente usasse isso como desculpa pra fazer um reencontro."

# game/Saturday.rpy:130
translate ptbr saturday_fd32237e:

    # "He says it hasn't been the same since the three of us left."
    "Ele diz que não é a mesma coisa desde que nós três fomos embora."

# game/Saturday.rpy:131
translate ptbr saturday_d61ca551:

    # m "— Yeah, I should. I just need some b-roll and shots of the old, creepy locations."
    m "— Sim, eu devo ter. Só preciso de umas filmagens de apoio e umas cenas dos lugares velhos e assustadores."

# game/Saturday.rpy:132
translate ptbr saturday_1d034233:

    # m "— Shouldn't take too long."
    m "— Não deve demorar muito."

# game/Saturday.rpy:133
translate ptbr saturday_4630a5a4:

    # "I catch a flash of blue and see the lake to our right."
    "Eu capto um clarão azul e vejo o lago à nossa direita."

# game/Saturday.rpy:134
translate ptbr saturday_3ed81d0b:

    # "The conversation dies down a bit and pretty soon we're all lost in our own thoughts."
    "A conversa morre um pouco e logo nós estamos todos perdidos em nossos próprios pensamentos."

# game/Saturday.rpy:135
translate ptbr saturday_a5666e8b:

    # "Finally, we round a bend and I start to catch some glimpses of the town."
    "Finalmente, a gente faz uma curva e eu começo a ter uns vislumbres da cidade."

# game/Saturday.rpy:136
translate ptbr saturday_0b8965a2:

    # "The tall, rusted signs for the gas station and motel loom over the rest of the old community."
    "As placas altas e enferrujadas do posto de gasolina e do motel se erguem sobre o resto da velha comunidade."

# game/Saturday.rpy:137
translate ptbr saturday_815237d2:

    # "Lake Emma Road merges right onto Main Street, where the motel is at."
    "A Lake Emma Road entra à direita na Main Street, onde fica o motel."

# game/Saturday.rpy:138
translate ptbr saturday_1d4eebf0:

    # "Soon enough we're turning into the parking lot."
    "Não muito tempo depois a gente está entrando no estacionamento."

# game/Saturday.rpy:142
translate ptbr saturday_32c7fd69:

    # "There are only a few other cars in the parking lot."
    "Há apenas alguns poucos carros no estacionamento."

# game/Saturday.rpy:145
translate ptbr saturday_e0987369:

    # "I park in the closest spot next to the door and switch off the ignition, relieved to be done with the driving."
    "Eu estaciono na vaga mais próxima da porta do nosso quarto e desligo o motor, aliviado por ter terminado de dirigir."

# game/Saturday.rpy:146
translate ptbr saturday_c1fcf9d5:

    # "I sit back for a moment, rubbing my eyes."
    "Eu recosto por um momento, esfregando meus olhos."

# game/Saturday.rpy:147
translate ptbr saturday_23f5c192:

    # m "— Uuugh. I hope you're grateful, TJ. I never wanna drive that long again."
    m "— Uuugh. Espero que você esteja grato TJ. Nunca mais quero dirigir por tanto tempo de novo."

# game/Saturday.rpy:148
translate ptbr saturday_6526b078:

    # t "— Thaaaanks, Chase!"
    t "— Vaaaleuuu, Chase!"

# game/Saturday.rpy:150
translate ptbr saturday_a45fc748:

    # "TJ hops out of the car, clearly happy to be out."
    "TJ pula fora do carro, claramente feliz por estar lá fora."

# game/Saturday.rpy:153
translate ptbr saturday_540020b7:

    # t "— Eeeuuuuugghhh!"
    t "— Eeeuuuuugghhh!"

# game/Saturday.rpy:154
translate ptbr saturday_636f2325:

    # "TJ puts his paws to his back and stretches out from toes to ear tufts, and I hear a few cracks."
    "TJ coloca as patas nas costas e se espreguiça dos dedos dos pés até os tufos das orelhas, e eu escuto uns estalos."

# game/Saturday.rpy:155
translate ptbr saturday_4f0197f3:

    # t "— Gosh, it feels good to be out of there."
    t "— Meu deus, é bom demais tá fora desse carro."

# game/Saturday.rpy:156
translate ptbr saturday_376deff5:

    # "I smile as I follow him out and stretch as well, though less flamboyantly. It's good to see TJ reverting back to his old, cheerful self."
    "Eu sorrio enquanto sigo ele pra fora e me espreguiço também, embora com menos extravagância. É bom ver o TJ voltando ao seu velho e alegre eu."

# game/Saturday.rpy:159
translate ptbr saturday_d034efad:

    # j "— Alright, I made the reservations, so I'll check us in."
    j "— Certo, eu fiz as reservas, então vou fazer o nosso check-in."

# game/Saturday.rpy:160
translate ptbr saturday_c8ea0559:

    # j "— You boys wanna bring in our stuff?"
    j "— Vocês, garotos, querem trazer as nossas coisas?"

# game/Saturday.rpy:161
translate ptbr saturday_999d7440:

    # t "— Sure!"
    t "— Pode deixar!"

# game/Saturday.rpy:165
translate ptbr saturday_e14938b6:

    # "Me and TJ head around to the trunk of the car, getting our bags and camera equipment while Jenna heads inside."
    "TJ e eu damos a volta até o porta-malas do carro, pegando nossas malas e equipamento de câmera enquanto a Jenna entra."

# game/Saturday.rpy:169
translate ptbr saturday_d68efe35:

    # "I'm pleasantly surprised."
    "Eu estou positivamente surpreso."

# game/Saturday.rpy:170
translate ptbr saturday_85899092:

    # "While it's a bit musty, the room is spacious and generally clean, a lot more than I was expecting from a town like Echo."
    "Embora tenha um cheiro de mofo, o quarto é espaçoso e no geral limpo, bem mais do que eu esperava de uma cidade como Echo."

# game/Saturday.rpy:171
translate ptbr saturday_c0439a96:

    # "Although I've lived in the town for most of my life, I've never actually been in the motel."
    "Embora eu tenha morado na cidade pela maior parte da minha vida, eu nunca estive de fato no motel."

# game/Saturday.rpy:173
translate ptbr saturday_faa4cf3c:

    # t "— Hey, this is nice! And two double beds?"
    t "— Ei, isso até que está bom! E duas camas de casal?"

# game/Saturday.rpy:175
translate ptbr saturday_8a39f568:

    # j "— Yeah, thought I'd get one of the nicer rooms, since everything here is dirt cheap."
    j "— É, achei melhor pegar um dos quartos mais legais, já que tudo aqui é barato pra caramba."

# game/Saturday.rpy:176
translate ptbr saturday_705f287e:

    # "TJ sets his bags down on the bed."
    "TJ coloca as malas dele na cama."

# game/Saturday.rpy:177
translate ptbr saturday_b5357bf1:

    # t "— So I guess this'll be me and Chase's bed."
    t "— Então eu acho que essa vai ser a minha cama e a do Chase."

# game/Saturday.rpy:178
translate ptbr saturday_0a5d4bce:

    # t "— Jenna can have her own, obviously."
    t "— A Jenna pode ter a dela, obviamente."

# game/Saturday.rpy:179
translate ptbr saturday_2b068180:

    # j "— That's...nice of you, TJ. Anyway, here are your keycards."
    j "— Isso é... gentil da sua parte, TJ. De qualquer jeito, aqui estão os cartões de vocês."

# game/Saturday.rpy:180
translate ptbr saturday_0c7308c2:

    # "She hands us both our keycards, which I slip into my back pocket."
    "Ela entrega os nossos dois cartões, que eu enfio no meu bolso de trás."

# game/Saturday.rpy:181
translate ptbr saturday_af534cf8:

    # t "— So, when we gonna eat? I'm starving!"
    t "— Então, quando a gente vai comer? Eu tô faminto!"

# game/Saturday.rpy:182
translate ptbr saturday_61851c14:

    # "My stomach grumbles. We haven't eaten since breakfast and it's late afternoon at this point."
    "Meu estômago ronca. A gente não come desde o café da manhã e já é final de tarde a esse ponto."

# game/Saturday.rpy:183
translate ptbr saturday_881b6f14:

    # "I pull out my phone, checking over my texts with Leo."
    "Eu pego meu celular, checando minhas mensagens com o Leo."

# game/Saturday.rpy:184
translate ptbr saturday_36c0a787:

    # m "— Leo said he's gonna get us some sandwiches from the diner."
    m "— Leo disse que vai pegar uns sanduíches pra gente na lanchonete."

# game/Saturday.rpy:185
translate ptbr saturday_0ed81ae7:

    # t "— Did you tell—"
    t "— Você avisou..."

# game/Saturday.rpy:186
translate ptbr saturday_5a5603ac:

    # m "— Yes, I told him to substitute the bread with lettuce for yours, TJ."
    m "— Sim, eu falei pra ele trocar o pão por alface no seu, TJ."

# game/Saturday.rpy:187
translate ptbr saturday_2c7ccf40:

    # t "— Nice!"
    t "— Boa!"

# game/Saturday.rpy:188
translate ptbr saturday_875c0a5c:

    # j "— Alright, well, I've texted everyone that we're here. Let's at least unpack."
    j "— Certo, bom, eu mandei mensagem pra todo mundo avisando que chegamos. Vamos pelo menos desfazer as malas."

# game/Saturday.rpy:189
translate ptbr saturday_54cc2d19:

    # j "— It's going to get crowded and I don't want all our stuff in the way."
    j "— Vai ficar cheio aqui e eu não quero todas as nossas coisas no meio do caminho."

# game/Saturday.rpy:195
translate ptbr saturday_6b58769a:

    # "Half-an-hour later we've got all our stuff packed away in the motel drawers."
    "Meia hora depois, a gente guardou todas as nossas coisas nas gavetas do motel."

# game/Saturday.rpy:196
translate ptbr saturday_3d3a0e04:

    # "Now, I'm sitting on the bed, toying with my camera equipment while TJ watches TV and Jenna organizes her school work."
    "Agora, eu estou sentado na cama, brincando com meu equipamento de câmera enquanto o TJ assiste TV e a Jenna organiza as coisas da faculdade."

# game/Saturday.rpy:197
translate ptbr saturday_bb911c0b:

    # t "— You know you're on vacation, right?"
    t "— Você sabe que tá de férias, né?"

# game/Saturday.rpy:198
translate ptbr saturday_cae25fc9:

    # t "— And didn't you already get into grad school? You should relax."
    t "— E você já não entrou pra pós-graduação? Você deveria relaxar."

# game/Saturday.rpy:199
translate ptbr saturday_8942a686:

    # j "— That's exactly why I need to be keeping up."
    j "— É exatamente por isso que eu preciso me manter em dia."

# game/Saturday.rpy:201
translate ptbr saturday_142d4b6f:

    # "There's a knock at the door and, being the closest, I get up to answer it."
    "Tem uma batida na porta e, eu sendo o mais próximo, me levanto pra atender."

# game/Saturday.rpy:202
translate ptbr saturday_ad2f8e34:

    # m "— I'll get it!"
    m "— Eu atendo!"

# game/Saturday.rpy:204
translate ptbr saturday_f31a60dc:

    # "I look through the peephole excitedly and see a beanie cap with a pair of some very familiar horns poking through it."
    "Eu olho pelo olho mágico animado e vejo uma touca com um par de chifres muito familiares saindo dela."

# game/Saturday.rpy:205
translate ptbr saturday_9dc01fd9:

    # "I grin as I unlock the door and swing it open."
    "Eu dou um sorriso enquanto destranco a porta e a abro."

# game/Saturday.rpy:207
translate ptbr saturday_48aa6cc4:

    # m "— Carl!"
    m "— Carl!"

# game/Saturday.rpy:208
translate ptbr saturday_98a39349:

    # c "— Chase!"
    c "— Chase!"

# game/Saturday.rpy:209
translate ptbr saturday_0c69c842:

    # "I slap paws with him and pull him into a hug."
    "Eu bato nas patas com ele e o puxo para um abraço."

# game/Saturday.rpy:210
translate ptbr saturday_4117c8e5:

    # "...and immediately get a whiff of the pungent scent of pot."
    "...e imediatamente sinto um cheiro forte de maconha."

# game/Saturday.rpy:211
translate ptbr saturday_6499a819:

    # "Despite that, his embrace is warm and plush, and his belly squishes against my body like a pillow through his jacket."
    "Apesar disso, o abraço dele é quente e macio, e sua barriga esmaga contra o meu corpo como um travesseiro através da jaqueta."

# game/Saturday.rpy:212
translate ptbr saturday_78cd5abe:

    # "There is an underlying sturdiness, though, and I feel his biceps bulge around my shoulders."
    "Há uma firmeza subjacente, no entanto, e eu sinto os bíceps dele crescerem ao redor dos meus ombros."

# game/Saturday.rpy:213
translate ptbr saturday_30a5421b:

    # "Had he been working out?"
    "Ele esteve malhando?"

# game/Saturday.rpy:214
translate ptbr saturday_3819a03b:

    # "I put my paws on his shoulders and push him back, looking him over."
    "Eu coloco minhas patas nos ombros dele e o empurro para trás, dando uma olhada nele."

# game/Saturday.rpy:215
translate ptbr saturday_52b42ebe:

    # "He's changed a bit since I've last seen him. He's definitely bulkier, and the fur on his face is a bit shaggier."
    "Ele mudou um pouco desde a última vez que o vi. Ele definitivamente tá mais forte, e o pelo no rosto tá um pouco mais bagunçado."

# game/Saturday.rpy:216
translate ptbr saturday_9c3ab1c6:

    # "His eyes are a little red, and his expression is a little glazed, like he's daydreaming about someplace far away from here."
    "Os olhos dele estão um pouco vermelhos, e sua expressão tá um pouco vidrada, como se estivesse sonhando acordado em algum lugar bem longe daqui."

# game/Saturday.rpy:217
translate ptbr saturday_17b959e7:

    # m "— Still getting blazed, huh?"
    m "— Ainda enchendo a cara de maconha, né?"

# game/Saturday.rpy:218
translate ptbr saturday_0c4cc046:

    # c "— You know it."
    c "— Pode apostar."

# game/Saturday.rpy:219
translate ptbr saturday_c3e05855:

    # "His jokey nature drops a bit as he gives me a genuine smile."
    "Sua natureza brincalhona diminui um pouco enquanto ele me dá um sorriso genuíno."

# game/Saturday.rpy:220
translate ptbr saturday_07ca519b:

    # c "— It's good to see you again."
    c "— É bom ver você de novo."

# game/Saturday.rpy:221
translate ptbr saturday_dc362c99:

    # "I feel warm inside as I smile back."
    "Sinto um calorzinho por dentro ao sorrir de volta."

# game/Saturday.rpy:222
translate ptbr saturday_fe3c01a1:

    # m "— You too."
    m "— Você também."

# game/Saturday.rpy:223
translate ptbr saturday_35f3df27:

    # j "— Is that Carl I hear?"
    j "— É o Carl que eu tô ouvindo?"

# game/Saturday.rpy:225
translate ptbr saturday_e740cc33:

    # "Carl and I step back into the room, the ram remaining slouched as we do."
    "Carl e eu voltamos pro quarto, com ele continuando encolhido enquanto entramos."

# game/Saturday.rpy:229
translate ptbr saturday_5bd0584b:

    # c "— Hey Jenna."
    c "— Oi Jenna."

# game/Saturday.rpy:230
translate ptbr saturday_134f3e29:

    # j "— Carl! How've you been?"
    j "— Carl! Como você está?"

# game/Saturday.rpy:231
translate ptbr saturday_b9004d78:

    # c "— Not bad, just livin' life, like I'mma be..."
    c "— Nada mal, só levando a vida, como eu vou estar..."

# game/Saturday.rpy:232
translate ptbr saturday_1c996e21:

    # "It sounds like he's starting to sing the lyrics to a song, but he trails off as we all look at him expectantly."
    "Parece que ele tá começando a cantar a letra de uma música, mas a voz vai sumindo enquanto a gente fica olhando pra ele com expectativa."

# game/Saturday.rpy:233
translate ptbr saturday_be8bd06a:

    # "He just smiles back."
    "Ele só sorri de volta."

# game/Saturday.rpy:234
translate ptbr saturday_ac94747a:

    # m "— Huh?"
    m "— Hã?"

# game/Saturday.rpy:237
translate ptbr saturday_b8bd7ab1:

    # c "— Hey, is that TJ?"
    c "— Ei, esse é o TJ?"

# game/Saturday.rpy:238
translate ptbr saturday_fb484cac:

    # t "— Hi!"
    t "— Oi!"

# game/Saturday.rpy:239
translate ptbr saturday_0b54fa72:

    # "Though he's smiling happily, TJ is outright crinkling his nose."
    "Apesar de estar sorrindo feliz, o TJ tá enrugando o nariz sem a menor cerimônia."

# game/Saturday.rpy:240
translate ptbr saturday_9c18714a:

    # t "— Still up to your old habits, huh?"
    t "— Ainda com seus velhos hábitos, hein?"

# game/Saturday.rpy:241
translate ptbr saturday_d31e01d3:

    # "Carl shrugs."
    "O Carl dá de ombros."

# game/Saturday.rpy:242
translate ptbr saturday_def60f60:

    # "I'm starting to remember that it's something he does a lot. It's his answer to almost everything."
    "Eu tô começando a me lembrar que isso é uma coisa que ele faz bastante. É a resposta dele pra quase tudo."

# game/Saturday.rpy:243
translate ptbr saturday_0ddbec17:

    # "It gets quiet for a moment, then I clap my paws together."
    "O ambiente fica em silêncio por um momento, aí eu bato minhas patas uma na outra."

# game/Saturday.rpy:244
translate ptbr saturday_e099070e:

    # m "— So, what have you been up to, Carl?"
    m "— Então, o que você tem feito, Carl?"

# game/Saturday.rpy:245
translate ptbr saturday_ae8c070e:

    # m "— You're not online that often."
    m "— Você não fica online com tanta frequência."

# game/Saturday.rpy:246
translate ptbr saturday_d31e01d3_1:

    # "Carl shrugs."
    "O Carl dá de ombros."

# game/Saturday.rpy:247
translate ptbr saturday_df66750a:

    # c "— Oh, you know...just hangin' out."
    c "— Ah, cê sabe... só de bobeira."

# game/Saturday.rpy:249
translate ptbr saturday_8380d505:

    # j "— Must be kinda boring, considering it's Echo."
    j "— Deve ser um pouco entediante, considerando que é Echo."

# game/Saturday.rpy:250
translate ptbr saturday_fff014f3:

    # c "— Not going outside helps, haha."
    c "— Não sair de casa ajuda, haha."

# game/Saturday.rpy:251
translate ptbr saturday_ee240b27:

    # t "— You been able to find a job? I know they closed the old Corner Market you used to work at."
    t "— Você tem conseguido achar um emprego? Eu sei que fecharam o velho Corner Market que você costumava trabalhar."

# game/Saturday.rpy:253
translate ptbr saturday_d8444523:

    # c "— Yeaah, been kinda hard since pretty much everything's closing around here."
    c "— Ééé, tem sido meio difícil já que praticamente tudo tá fechando por aqui."

# game/Saturday.rpy:254
translate ptbr saturday_94083e57:

    # c "— On top of that I still don't have a car that can get me to Payton."
    c "— Além disso, eu ainda não tenho um carro que possa me levar até Payton."

# game/Saturday.rpy:255
translate ptbr saturday_1f6b51b8:

    # t "— Oof, that's right."
    t "— Nossa, verdade."

# game/Saturday.rpy:256
translate ptbr saturday_3c19704b:

    # t "— You crashed the one your parents got you."
    t "— E você ainda bateu aquele que os seus pais te deram."

# game/Saturday.rpy:258
translate ptbr saturday_695c7caf:

    # "TJ's grinning sympathetically, but Carl hunches further into himself, looking sulky."
    "TJ sorri com simpatia, mas o Carl se encolhe ainda mais, parecendo emburrado."

# game/Saturday.rpy:260
translate ptbr saturday_e05e4fbd:

    # c "— Man, don't kill my vibe."
    c "— Cara, não corta a minha brisa."

# game/Saturday.rpy:261
translate ptbr saturday_46c75239:

    # j "— What about school, been thinking about going back?"
    j "— E a faculdade, tem pensado em voltar?"

# game/Saturday.rpy:263
translate ptbr saturday_163eeea6:

    # c "— N-not really, maybe..."
    c "— N-não muito, talvez..."

# game/Saturday.rpy:264
translate ptbr saturday_4f26c6d5:

    # "Carl's starting to lose that faraway look as he narrows his eyes."
    "Carl tá começando a perder aquele olhar distante enquanto aperta os olhos."

# game/Saturday.rpy:266
translate ptbr saturday_358d8c59:

    # j "— You should! You went for what, a semester?"
    j "— Você deveria! Você foi por o que, um semestre?"

# game/Saturday.rpy:267
translate ptbr saturday_6a5b6acd:

    # j "— That's not really enough time to tell if you're really cut out for college."
    j "— Isso não é tempo suficiente pra saber se você realmente leva jeito pra faculdade."

# game/Saturday.rpy:268
translate ptbr saturday_bc6c6990:

    # j "— Classes get easier to handle once you get used to it."
    j "— As aulas ficam mais fáceis de lidar depois que você se acostuma."

# game/Saturday.rpy:269
translate ptbr saturday_dbc348c3:

    # c "— Yeah, well, it wasn't exactly the school work that was the problem."
    c "— É, bom, não eram exatamente as tarefas da faculdade que eram o problema."

# game/Saturday.rpy:270
translate ptbr saturday_6bf137c0:

    # t "— You cooouuld try smoking less weed, that might help."
    t "— Você poooderia tentar fumar menos maconha, isso talvez ajude."

# game/Saturday.rpy:272
translate ptbr saturday_f076f777:

    # c "— Wh—wha…?"
    c "— O q—que…?"

# game/Saturday.rpy:274
translate ptbr saturday_86c68627:

    # c "— Is this—was I set up for an intervention, or something?"
    c "— Isso é—foi uma armadilha pra uma intervenção, ou algo assim?"

# game/Saturday.rpy:275
translate ptbr saturday_be0d8dab:

    # "Carl looks over at me, as if asking for help."
    "Carl olha pra mim, como se pedisse por ajuda."

# game/Saturday.rpy:276
translate ptbr saturday_c4c1c014:

    # m "— Hey, don't look at me. I had to deal with them for the past ten hours."
    m "— Ei, não olhe pra mim. Tive que lidar com eles nas últimas dez horas."

# game/Saturday.rpy:277
translate ptbr saturday_bd58b797:

    # c "— Yeah, guess I just forgot how naggy they can be."
    c "— É, acho que eu só tinha esquecido de como eles podem ser chatos."

# game/Saturday.rpy:278
translate ptbr saturday_f07d5b45:

    # t "— That's because we care about you, Carl!"
    t "— Isso é porque nós nos importamos com você, Carl!"

# game/Saturday.rpy:279
translate ptbr saturday_66a9f003:

    # j "— Anyway, I'm pretty sure Chase has been missing you ever since you left school."
    j "— De qualquer jeito, eu tenho certeza de que o Chase tem sentido a sua falta desde que você saiu da faculdade."

# game/Saturday.rpy:280
translate ptbr saturday_0305df63:

    # "Carl and I were in the same class throughout school. As a result, we entered college together."
    "O Carl e eu estávamos na mesma turma durante a escola toda. Como resultado, nós entramos na faculdade juntos."

# game/Saturday.rpy:281
translate ptbr saturday_72e80bbf:

    # "We even roomed together for that one semester, which was a lot of fun. Of course I had missed him."
    "Nós até dividimos o quarto naquele um semestre, o que foi bem divertido. É claro que eu tinha sentido falta dele."

# game/Saturday.rpy:282
translate ptbr saturday_c61b468d:

    # "Carl seems pretty eager to get off the topic, though."
    "Carl parece bem ansioso pra mudar de assunto, no entanto."

# game/Saturday.rpy:284
translate ptbr saturday_906eeb97:

    # c "— Speaking of school, didn't you get accepted into Weston, Jenna?"
    c "— Falando em faculdade, você não foi aceita em Weston, Jenna?"

# game/Saturday.rpy:285
translate ptbr saturday_bc982fee:

    # j "— Yep! Going into experimental psych. I start in the fall."
    j "— Sim! Vou fazer psicologia experimental. Eu começo no outono."

# game/Saturday.rpy:286
translate ptbr saturday_0bc1874f:

    # c "— That's pretty cool, congrats."
    c "— Isso é bem legal, parabéns."

# game/Saturday.rpy:287
translate ptbr saturday_0867ce31:

    # "Carl turns back to me."
    "Carl se vira pra mim."

# game/Saturday.rpy:288
translate ptbr saturday_0e3b0811:

    # c "— And you're into...journalism, right?"
    c "— E você tá em... jornalismo, certo?"

# game/Saturday.rpy:289
translate ptbr saturday_68194ee3:

    # "He looks over the equipment, looking confused."
    "Ele dá uma olhada no equipamento, parecendo confuso."

# game/Saturday.rpy:290
translate ptbr saturday_ccf58752:

    # c "— What's all this?"
    c "— Que que é tudo isso?"

# game/Saturday.rpy:292
translate ptbr saturday_5565b8c7:

    # m "— Oh! Yeah, one of the reasons why I'm out here."
    m "— Ah! É, uma das razões pelas quais eu tô aqui."

# game/Saturday.rpy:293
translate ptbr saturday_3e3d9dd7:

    # m "— I'm doing a news segment on Echo."
    m "— Eu tô fazendo uma reportagem sobre Echo."

# game/Saturday.rpy:294
translate ptbr saturday_3e6c0ac2:

    # c "— Sounds like the feel-good movie of the year, Chase."
    c "— Parece o filme alto-astral do ano, Chase."

# game/Saturday.rpy:295
translate ptbr saturday_bdb69469:

    # m "— That's what you get out of the feel-good town of the century, Carl."
    m "— É isso que se tira da cidade alto-astral do século, Carl."

# game/Saturday.rpy:296
translate ptbr saturday_5eec415d:

    # c "— Hehe, yeah."
    c "— Hehe, é."

# game/Saturday.rpy:297
translate ptbr saturday_83c05e13:

    # "Carl scratches his muzzle before turning to TJ."
    "Carl coça o focinho antes de se virar pro TJ."

# game/Saturday.rpy:298
translate ptbr saturday_ceee00f7:

    # c "— And you're doing...what again?"
    c "— E você tá fazendo... o que mesmo?"

# game/Saturday.rpy:299
translate ptbr saturday_2ffd10fa:

    # c "— Sports...something...Bible olympics?"
    c "— Esportes... alguma coisa... Olimpíadas Bíblicas?"

# game/Saturday.rpy:300
translate ptbr saturday_b9ee7ab3:

    # t "— Athletic training, but yes, it's a Christian school."
    t "— Treinamento atlético, mas sim, é uma escola Cristã."

# game/Saturday.rpy:301
translate ptbr saturday_076bf9a1:

    # "Carl gives a thumbs up."
    "Carl faz um sinal de joia."

# game/Saturday.rpy:302
translate ptbr saturday_ed8a9f85:

    # c "— Super. So we gonna eat? I'm hungry as hell."
    c "— Legal. Então a gente vai comer? Eu tô com uma fome do inferno."

# game/Saturday.rpy:303
translate ptbr saturday_62a5797b:

    # t "— Hell is a little extreme, there, Carl."
    t "— Inferno é um pouco extremo, Carl."

# game/Saturday.rpy:304
translate ptbr saturday_c4ca1ea1:

    # t "— Not even YOU can be that hungry, hehe."
    t "— Nem VOCÊ pode estar com tanta fome assim, hehe."

# game/Saturday.rpy:305
translate ptbr saturday_e9f87b21:

    # c "— Mhm, sure. Where's Leo, he's bringing the sandwiches, right?"
    c "— Mhm, sei. Cadê o Leo, ele tá trazendo os sanduíches, né?"

# game/Saturday.rpy:306
translate ptbr saturday_79b88cf6:

    # j "— He actually just texted me that he's here. He was picking up Flynn."
    j "— Na verdade, ele acabou de me mandar mensagem dizendo que chegou. Ele tava indo buscar o Flynn."

# game/Saturday.rpy:307
translate ptbr saturday_639cc246:

    # t "— So we're all gonna be here! Just like old times."
    t "— Então todo mundo vai estar aqui! Que nem nos velhos tempos."

# game/Saturday.rpy:308
translate ptbr saturday_730cb584:

    # "TJ almost looks like that little kid lynx again, his ears twitching around with excitement."
    "TJ quase parece aquele lincezinho de novo, com as orelhas se contorcendo de empolgação."

# game/Saturday.rpy:311
translate ptbr saturday_8b5c0245:

    # c "— Ooh, there they are."
    c "— Ooh, lá estão eles."

# game/Saturday.rpy:316
translate ptbr saturday_fd9dbabd:

    # "I grip the bedspread and watch as Carl moves around the corner to open the door."
    "Eu aperto a colcha e observo enquanto Carl vira a esquina pra abrir a porta."

# game/Saturday.rpy:317
translate ptbr saturday_33350a54:

    # "I hear it open, followed by the distinctive deep, brassy voice of Flynn."
    "Eu ouço ela abrir, seguido pela distinta voz grave e metálica do Flynn."

# game/Saturday.rpy:319
translate ptbr saturday_8467746b:

    # f "— Hey, why are YOU getting the door, fatty?"
    f "— Ei, por que VOCÊ tá atendendo a porta, gordão?"

# game/Saturday.rpy:320
translate ptbr saturday_bef6eb42:

    # c "— To get my sandwiches, dickface. I've got the munchies like a mother."
    c "— Pra pegar os meus sanduíches, seu buceta. Tô com uma larica da porra."

# game/Saturday.rpy:321
translate ptbr saturday_efdd113a:

    # c "— Er...where are they?"
    c "— Er... cadê eles?"

# game/Saturday.rpy:322
translate ptbr saturday_65d7cec7:

    # f "— Leo has them...here he is."
    f "— O Leo tá com eles... aqui tá ele."

# game/Saturday.rpy:323
translate ptbr saturday_f042c63a:

    # l "— Hey, they all in there?"
    l "— Ei, tão todos aí dentro?"

# game/Saturday.rpy:324
translate ptbr saturday_53869636:

    # "My heart skips a beat and my tail thumps the bed as I hear Leo's high baritone."
    "Meu coração bate mais forte e meu rabo bate na cama enquanto eu ouço a voz barítona aguda do Leo."

# game/Saturday.rpy:325
translate ptbr saturday_f9118c7e:

    # "There's some bustling before they start coming around the corner, bringing me face-to-face with the rest of my childhood friends."
    "Tem um certo alvoroço antes que eles comecem a virar a esquina, me deixando cara a cara com o resto dos meus amigos de infância."

# game/Saturday.rpy:328
translate ptbr saturday_399f3aac:

    # "Flynn comes first, slinking in casually, his posture loose and relaxed, slouching."
    "O Flynn vem primeiro, entrando de fininho e casualmente, com sua postura solta e relaxada, um pouco desleixada."

# game/Saturday.rpy:329
translate ptbr saturday_90576388:

    # "Unlike Carl, though, his slouch makes him look like he just doesn't give a fuck, as opposed to just trying to make himself seem smaller."
    "Diferente do Carl, no entanto, a postura dele faz parecer que ele só tá pouco se fodendo, ao contrário de só tentar parecer menor."

# game/Saturday.rpy:330
translate ptbr saturday_94c02e0d:

    # "He wasn't a shy guy, as evidenced by his open shirt."
    "Ele não era um cara tímido, como evidenciado pela sua camisa aberta."

# game/Saturday.rpy:331
translate ptbr saturday_a46ffaa0:

    # f "— And who you callin' a dickface?"
    f "— E quem você tá chamando de buceta?"

# game/Saturday.rpy:332
translate ptbr saturday_64a2417a:

    # "Flynn knocks Carl on the head, which made a loud thunking sound, but Carl just grins throughout."
    "O Flynn dá um cascudo na cabeça do Carl, que faz um som oco e alto, mas o Carl só fica sorrindo."

# game/Saturday.rpy:333
translate ptbr saturday_749f4486:

    # f "— Hey Jenna, TJ, Chase."
    f "— E aí Jenna, TJ, Chase."

# game/Saturday.rpy:334
translate ptbr saturday_1caf4a51:

    # "He nods to each of us in turn, rubbing his knuckles."
    "Ele acena pra cada um de nós, esfregando os nós dos dedos."

# game/Saturday.rpy:339
translate ptbr saturday_4b9efec1:

    # "Immediately following him, his arms wrapped around two big, brown, paper bags, is Leo."
    "Logo atrás dele, com os braços enrolados em duas sacolas grandes de papel pardo, tá o Leo."

# game/Saturday.rpy:340
translate ptbr saturday_19f61756:

    # "He smiles over the tops of the bags, sweeping the room with his eyes along with his tall rectangular ears."
    "Ele sorri por cima das sacolas, varrendo o quarto com seus olhos junto com suas orelhas altas e retangulares."

# game/Saturday.rpy:341
translate ptbr saturday_32ae0643:

    # "He pauses on Jenna, then TJ, before finding me."
    "Ele pausa na Jenna, depois no TJ, antes de me encontrar."

# game/Saturday.rpy:342
translate ptbr saturday_bf6848a5:

    # "His face immediately breaks into a full-on grin as he walks over to the bed I'm sitting on, setting down the bags."
    "Seu rosto imediatamente se abre num sorriso enorme enquanto ele caminha até a cama em que estou sentado, deixando as sacolas de lado."

# game/Saturday.rpy:343
translate ptbr saturday_6dd92c10:

    # "As he comes to a stop in front of me I reach out my paw to slap his, like I did with Carl."
    "Enquanto ele para na minha frente, eu estico minha pata pra bater na dele, assim como fiz com o Carl."

# game/Saturday.rpy:344
translate ptbr saturday_5eaaf745:

    # "Instead, he grabs it to yank me up right into a tight bearhug, nearly squeezing the air out of me."
    "Em vez disso, ele a agarra pra me puxar pra um abraço de urso apertado, quase espremendo o ar pra fora de mim."

# game/Saturday.rpy:345
translate ptbr saturday_5a4fe0d0:

    # l "— Chase!"
    l "— Chase!"

# game/Saturday.rpy:346
translate ptbr saturday_69642db8:

    # l "— Man, I missed you..."
    l "— Cara, senti sua falta..."

# game/Saturday.rpy:347
translate ptbr saturday_c4ab377a:

    # "Just like Carl, it seems like Leo's gotten bigger, and stronger. He lifted me up without even trying."
    "Assim como o Carl, parece que o Leo ficou maior, e mais forte. Ele me levantou sem nem tentar."

# game/Saturday.rpy:348
translate ptbr saturday_73fce836:

    # "The tension I've been feeling in my chest melts away like an ice cube on an Echo sidewalk."
    "A tensão que eu tava sentindo no meu peito derrete como um cubo de gelo numa calçada de Echo."

# game/Saturday.rpy:349
translate ptbr saturday_cef668aa:

    # "Everything's fine."
    "Tá tudo bem."

# game/Saturday.rpy:350
translate ptbr saturday_f8ce09b4:

    # "All of that worry about how he was going to react was for nothing."
    "Toda aquela preocupação sobre como ele ia reagir foi à toa."

# game/Saturday.rpy:351
translate ptbr saturday_25dfa3c9:

    # "...The hug IS lasting kinda long, though."
    "...O abraço TÁ durando um pouco demais, no entanto."

# game/Saturday.rpy:352
translate ptbr saturday_5325a2fa:

    # "I can feel everyone else looking at us."
    "Eu consigo sentir que todo mundo tá olhando pra gente."

# game/Saturday.rpy:353
translate ptbr saturday_5a34df46:

    # j "— And just like that he forgets we exist."
    j "— E assim do nada ele esquece que a gente existe."

# game/Saturday.rpy:354
translate ptbr saturday_8dc833f3:

    # "Leo finally does pull back, then, smacking me on the shoulder before turning to greet Jenna and TJ."
    "Leo finalmente se afasta, então, me dando um tapinha no ombro antes de se virar pra cumprimentar a Jenna e o TJ."

# game/Saturday.rpy:356
translate ptbr saturday_7c442513:

    # "I shakily sit back down, feeling a whole lot better now that the introductions are out of the way."
    "Eu me sento de novo meio trêmulo, me sentindo bem melhor agora que as introduções acabaram."

# game/Saturday.rpy:359
translate ptbr saturday_b255ef96:

    # f "— Fuck, leave Carl in a room for five seconds and it smells like a goddamn skunk sauna."
    f "— Porra, deixa o Carl numa sala por cinco segundos e fica cheirando a uma porra de sauna de gambá."

# game/Saturday.rpy:360
translate ptbr saturday_fdfb4a17:

    # f "— The weed is just oozin' out of your pores at this point."
    f "— A maconha tá literalmente saindo pelos seus poros a essa altura."

# game/Saturday.rpy:361
translate ptbr saturday_d41a92de:

    # "Flynn theatrically plugs his nostrils as he pulls the window open a crack."
    "O Flynn fecha as narinas de forma teatral enquanto abre uma fresta da janela."

# game/Saturday.rpy:363
translate ptbr saturday_24f712d3:

    # "Carl rolls his eyes, slouching further and jamming his paws in his pockets."
    "O Carl revira os olhos, se encolhendo mais e enfiando as patas nos bolsos."

# game/Saturday.rpy:364
translate ptbr saturday_7c927090:

    # c "— Oh shut up. I think everyone here agrees that my smell is a lot better than your shedding."
    c "— Ah cala a boca. Acho que todo mundo aqui concorda que o meu cheiro é bem melhor que a sua troca de pele."

# game/Saturday.rpy:365
translate ptbr saturday_e8d4e066:

    # c "— Nothing like leaving a big pile of lizard dust on the couch for the next person."
    c "— Nada como deixar uma pilha grande de poeira de lagarto no sofá pra próxima pessoa."

# game/Saturday.rpy:366
translate ptbr saturday_cf1433f6:

    # c "— And by the way, dude, that skunk comment was speciesist."
    c "— E a propósito, cara, esse comentário sobre gambá foi especista."

# game/Saturday.rpy:367
translate ptbr saturday_510b83d3:

    # f "— And that lizard comment wasn't?"
    f "— E aquele comentário sobre lagarto não foi?"

# game/Saturday.rpy:369
translate ptbr saturday_0e719be8:

    # "Flynn turns to me, fanning air in from the outside with his hand."
    "Flynn se vira pra mim, abanando o ar de fora com a mão."

# game/Saturday.rpy:370
translate ptbr saturday_d57fb9a7:

    # f "— What's worse, Chase: Carl's smell, or my...dustin' off?"
    f "— O que é pior, Chase: o cheiro do Carl, ou a minha... poeirinha?"

# game/Saturday.rpy:372
translate ptbr saturday_36f0404f:

    # c "— Ha! Dusting off? That's not a thing!"
    c "— Rá! Poeirinha? Isso não existe!"

# game/Saturday.rpy:373
translate ptbr saturday_bbd4c0c1:

    # c "— Try saying 'white flakes that chip off of me with every step I take...except when I scratch my ass, then it's like a fucking blizzard of dead skin"
    c "— Tenta falar 'flocos brancos que soltam de mim a cada passo que dou... exceto quando eu coço a minha bunda, aí é tipo uma porra de nevasca de pele morta"

# game/Saturday.rpy:374
translate ptbr saturday_7c12cda7:

    # c "— ...and some of it might land in your mouth.'"
    c "— ...e um pouco pode parar na sua boca.'"

# game/Saturday.rpy:375
translate ptbr saturday_e402eb8c:

    # c "— That's what you should call it!"
    c "— É assim que você deveria chamar isso!"

# game/Saturday.rpy:376
translate ptbr saturday_17a76432:

    # f "— Hey, you furballs do it too...it's just less noticeable."
    f "— Ei, vocês bolas de pelo fazem isso também... é só menos perceptível."

# game/Saturday.rpy:377
translate ptbr saturday_0f06df46:

    # f "— Either way, it's hot in here!"
    f "— De qualquer forma, tá quente aqui!"

# game/Saturday.rpy:378
translate ptbr saturday_e161adf7:

    # c "— Aren't you cold-blooded?"
    c "— Você não tem sangue frio?"

# game/Saturday.rpy:379
translate ptbr saturday_35ca015c:

    # f "— Someone turn down the goddamn thermostat!"
    f "— Alguém abaixa a porra do termostato!"

# game/Saturday.rpy:383
translate ptbr saturday_6e169b48:

    # t "— Somebody turn down your language, haha!"
    t "— Alguém abaixa o seu palavreado, haha!"

# game/Saturday.rpy:384
translate ptbr saturday_9ccfbc2f:

    # "TJ says it to him like a cheerful kindergarten teacher pep-talking a student into using his words."
    "TJ diz isso pra ele como uma professora de jardim de infância animada incentivando um aluno a usar as palavras dele."

# game/Saturday.rpy:385
translate ptbr saturday_2c8a8489:

    # f "— ..."
    f "— ..."

# game/Saturday.rpy:386
translate ptbr saturday_88c12fcb:

    # t "— ..."
    t "— ..."

# game/Saturday.rpy:387
translate ptbr saturday_f6ef5dc1:

    # "They stare at each other for about five seconds, Flynn's expression like a stone, while TJ slowly loses his smile."
    "Eles se encaram por uns cinco segundos, a expressão do Flynn que nem pedra, enquanto o TJ perde lentamente o sorriso."

# game/Saturday.rpy:389
translate ptbr saturday_f30aee05:

    # t "— Uh..."
    t "— Uh..."

# game/Saturday.rpy:390
translate ptbr saturday_b40f4660:

    # f "— Well Jesus butt-fucking Christ, I'll be sure to watch that."
    f "— Bom, Jesus Cristo, puta que pariu, eu vou ter certeza de prestar atenção nisso."

# game/Saturday.rpy:391
translate ptbr saturday_8d1208d0:

    # t "— Flynn!"
    t "— Flynn!"

# game/Saturday.rpy:395
translate ptbr saturday_14de3ac0:

    # "TJ actually looks pretty upset, but Flynn just reaches out and yanks him into a choke-hold, the much shorter lynx easily dwarfed by the lizard."
    "O TJ até parece bem chateado, mas o Flynn só estica o braço e prende ele numa gravata, com o lince bem mais baixo parecendo minúsculo perto do lagarto."

# game/Saturday.rpy:396
translate ptbr saturday_5a15c018:

    # f "— Ah, shut up ya priss, I'm just kiddin'!"
    f "— Ah, cala a boca seu fresco, eu só tô brincando!"

# game/Saturday.rpy:397
translate ptbr saturday_8e5a8065:

    # "TJ half-heartedly fights the hold."
    "TJ luta sem muita vontade contra a gravata."

# game/Saturday.rpy:398
translate ptbr saturday_93b6b1e4:

    # "I guess TJ thought he'd get some respect, now that we're all adults."
    "Acho que o TJ pensou que ele ganharia algum respeito, agora que somos todos adultos."

# game/Saturday.rpy:399
translate ptbr saturday_ac1783cc:

    # t "— Hey, ow!"
    t "— Ei, ai!"

# game/Saturday.rpy:400
translate ptbr saturday_219bda46:

    # t "— Y—you still said it!"
    t "— V-você ainda disse isso!"

# game/Saturday.rpy:401
translate ptbr saturday_6997d45c:

    # "Normally I might step in to help, but its been a while since I've seen Flynn and TJ go at it."
    "Normalmente eu até entraria no meio pra ajudar, mas faz um tempo que eu não vejo o Flynn e o TJ brigarem."

# game/Saturday.rpy:402
translate ptbr saturday_7f4a8825:

    # "It's just too funny to stop."
    "É engraçado demais pra parar."

# game/Saturday.rpy:403
translate ptbr saturday_b14409ee:

    # f "— Look, no lightnin'! So much for your almighty go—OOF!"
    f "— Olha, nenhum raio! Pelo visto seu Deus todo-poderoso... OOF!"

# game/Saturday.rpy:404
translate ptbr saturday_977ed819:

    # "TJ jabs his elbow back into Flynn's stomach, doubling the lizard over for a second."
    "TJ dá uma cotovelada pra trás no estômago do Flynn, dobrando o lagarto no meio por um segundo."

# game/Saturday.rpy:405
translate ptbr saturday_ca0b8ce1:

    # t "— Ha! See? God works in mysterious wa—OW!"
    t "— Rá! Tá vendo? Deus trabalha de formas misterios—AI!"

# game/Saturday.rpy:406
translate ptbr saturday_cffdb32b:

    # "Flynn reaches up and grabs at one of the tufts on TJ's ears and yanks, earning a yowl from the feline."
    "Flynn alcança e agarra um dos tufos na orelha do TJ e puxa, ganhando um uivo do felino."

# game/Saturday.rpy:407
translate ptbr saturday_fd8b1ea1:

    # c "— Foul! Species features!"
    c "— Falta! Características da espécie!"

# game/Saturday.rpy:408
translate ptbr saturday_52ac085f:

    # "Species features was something we made up to make our tussles a little more fair."
    "Características da espécie era algo que inventamos pra deixar nossas lutas um pouco mais justas."

# game/Saturday.rpy:409
translate ptbr saturday_e7700eec:

    # "It involved any distinct physical difference between our species that might pose as a disadvantage like my tail, Jenna's ears, or TJ's ear tufts."
    "Envolvia qualquer diferença física distinta entre nossas espécies que pudesse representar uma desvantagem, tipo meu rabo, as orelhas da Jenna, ou os tufos da orelha do TJ."

# game/Saturday.rpy:410
translate ptbr saturday_48e7ab86:

    # "Carl was especially keen on it. Being a ram his horns were often used as leverage against him."
    "O Carl era especialmente a favor disso. Sendo um carneiro, seus chifres frequentemente eram usados como alavanca contra ele."

# game/Saturday.rpy:411
translate ptbr saturday_ed0002fe:

    # j "— TJ! Come get your sandwich."
    j "— TJ! Vem pegar seu sanduíche."

# game/Saturday.rpy:412
translate ptbr saturday_b77361d5:

    # "TJ finally yanks himself out of Flynn's grasp, smoothing down his fur as he tries to look as dignified as possible."
    "TJ finalmente se puxa pra fora do aperto do Flynn, alisando o pelo enquanto tenta parecer o mais digno possível."

# game/Saturday.rpy:413
translate ptbr saturday_28a1e012:

    # t "— Well, I can see things haven't changed..."
    t "— Bom, eu vejo que as coisas não mudaram..."

# game/Saturday.rpy:414
translate ptbr saturday_870e56aa:

    # "With that, TJ walks over to the table to get his food."
    "Com isso, TJ caminha até a mesa pra pegar a comida dele."

# game/Saturday.rpy:416
translate ptbr saturday_b7fd02df:

    # "I can't help but laugh."
    "Eu não consigo deixar de rir."

# game/Saturday.rpy:417
translate ptbr saturday_e5640034:

    # m "— Hehe, I think TJ won that one by technicality."
    m "— Hehe, acho que o TJ ganhou essa por um detalhe técnico."

# game/Saturday.rpy:418
translate ptbr saturday_d405c809:

    # c "— Or did he? He might have fouled, too."
    c "— Será que ganhou mesmo? Ele pode ter cometido falta também."

# game/Saturday.rpy:419
translate ptbr saturday_729e9090:

    # c "— Flynn's got a soft lizard belly, haha."
    c "— A barriga de lagarto do Flynn é macia, haha."

# game/Saturday.rpy:420
translate ptbr saturday_04ab4bb2:

    # "Flynn snorts, rubbing his stomach."
    "Flynn bufa, esfregando o estômago."

# game/Saturday.rpy:421
translate ptbr saturday_65373133:

    # f "— Oh, don't even try to tell me about soft, asshole. It looks like you swallowed a beach ball."
    f "— Ah, nem tenta me falar de macio, cuzão. Parece que você engoliu uma bola de praia."

# game/Saturday.rpy:422
translate ptbr saturday_e18a83e9:

    # c "— Speaking of which, food!"
    c "— Falando nisso, comida!"

# game/Saturday.rpy:425
translate ptbr saturday_16e0eafd:

    # "We all pass the bags around to get our food."
    "Nós passamos as sacolas ao redor pra pegar nossa comida."

# game/Saturday.rpy:426
translate ptbr saturday_da0461bb:

    # "A chicken sandwich for Jenna and TJ, roast beef for me and Leo, and three large veggie burgers that almost take up their own bag for Carl."
    "Um sanduíche de frango pra Jenna e o TJ, rosbife pra mim e pro Leo, e três hambúrgueres vegetarianos grandes que quase ocupam a própria sacola pro Carl."

# game/Saturday.rpy:428
translate ptbr saturday_92d5a2e9:

    # "Flynn, as usual, isn't eating anything. I think it's a lizard thing."
    "O Flynn, como de costume, não tá comendo nada. Acho que é coisa de lagarto."

# game/Saturday.rpy:429
translate ptbr saturday_0c9f2c51:

    # "I keep my seat on the bed as I unwrap the foil around my sandwich."
    "Eu me mantenho sentado na cama enquanto desembrulho o papel-alumínio do meu sanduíche."

# game/Saturday.rpy:430
translate ptbr saturday_c344d392:

    # "The smell wafts up from the beef, making my mouth water, and bringing some memories up with it."
    "O cheiro sobe da carne, me dando água na boca, e trazendo algumas memórias junto."

# game/Saturday.rpy:431
translate ptbr saturday_533fec5b:

    # "We'd all spent many nights at the old diner. I can remember the night me and Carl graduated."
    "Nós todos tínhamos passado muitas noites na velha lanchonete. Eu consigo me lembrar da noite em que eu e o Carl nos formamos."

# game/Saturday.rpy:432
translate ptbr saturday_13d5af14:

    # "Leo took us all straight from Payton High to the diner, skipping out on the all-night graduation party for sandwiches and milkshakes."
    "O Leo levou a gente direto da Payton High pra lanchonete, pulando a festa de formatura que duraria a noite toda por sanduíches e milkshakes."

# game/Saturday.rpy:433
translate ptbr saturday_e7cd21e7:

    # "I take a huge bite and a yellow bell pepper slips out the other end, landing back in the foil."
    "Eu dou uma mordida enorme e um pimentão amarelo escorrega pelo outro lado, caindo de volta no papel-alumínio."

# game/Saturday.rpy:434
translate ptbr saturday_7e425015:

    # l "— Whoah! Slow down, you're going to choke."
    l "— Ei! Vai devagar, cê vai engasgar."

# game/Saturday.rpy:435
translate ptbr saturday_d0a6e89d:

    # "Suddenly, I'm almost falling over to the side as something heavy plants itself next to me on the bed."
    "De repente, eu quase caio pro lado quando algo pesado se planta do meu lado na cama."

# game/Saturday.rpy:437
translate ptbr saturday_ff808e43:

    # "I quickly grab a napkin and bring it to my muzzle, wiping away the grease."
    "Eu pego rápido um guardanapo e levo pro focinho, limpando a gordura."

# game/Saturday.rpy:438
translate ptbr saturday_e1ae294b:

    # m "— Ey, Leo..."
    m "— Ei, Leo..."

# game/Saturday.rpy:439
translate ptbr saturday_65cb68cc:

    # "Leo chuckles at my embarrassment and unwraps his own sandwich."
    "Leo ri do meu constrangimento e desembrulha o próprio sanduíche."

# game/Saturday.rpy:440
translate ptbr saturday_63512c7d:

    # l "— Sorry if the bread is a little soggy. {i}Garrobo{/i} over here took his sweet time getting to the car."
    l "— Desculpa se o pão estiver meio murcho. O {i}Garrobo{/i} aqui demorou uma vida pra chegar no carro."

# game/Saturday.rpy:444
translate ptbr saturday_84290fa1:

    # f "— Hey! Working in the town hall is serious business."
    f "— Ei! Trabalhar na prefeitura é coisa séria."

# game/Saturday.rpy:445
translate ptbr saturday_d5f2f728:

    # f "— I don't have a family business I can just waltz out of, like you."
    f "— Eu não tenho um negócio de família de onde eu possa simplesmente sair, que nem você."

# game/Saturday.rpy:447
translate ptbr saturday_9dc17c31:

    # c "— Hey, Flynn. I'll bet you that I can eat this whole burger in one minute."
    c "— Ei, Flynn. Aposto com você que eu consigo comer esse hambúrguer inteiro em um minuto."

# game/Saturday.rpy:448
translate ptbr saturday_2c8a8489_1:

    # f "— ..."
    f "— ..."

# game/Saturday.rpy:449
translate ptbr saturday_9af0ba3c:

    # f "— Is that a fucking joke? Of course you can."
    f "— Isso é uma porra de uma piada? É claro que você consegue."

# game/Saturday.rpy:450
translate ptbr saturday_7e66afc8:

    # c "— Hahahahaha! Yeah...But what about TWO burgers?"
    c "— Hahahahaha! É... mas e se forem DOIS hambúrgueres?"

# game/Saturday.rpy:454
translate ptbr saturday_81907dae:

    # l "— Don't choke, Carl."
    l "— Não vai engasgar, Carl."

# game/Saturday.rpy:455
translate ptbr saturday_ca923c96:

    # "I decide to keep the conversation on Leo's job, since that's the whole reason why he's still here."
    "Eu decido manter a conversa no trabalho do Leo, já que essa é toda a razão pela qual ele ainda tá aqui."

# game/Saturday.rpy:456
translate ptbr saturday_ae8f80b2:

    # m "— Is business still pretty good?"
    m "— O negócio ainda tá indo bem?"

# game/Saturday.rpy:457
translate ptbr saturday_59730911:

    # l "— Yes! Payton's getting bigger, so is the number of customers."
    l "— Sim! Payton tá ficando maior, assim como o número de clientes."

# game/Saturday.rpy:458
translate ptbr saturday_70253646:

    # m "— I guess it's a good thing your dad moved it out of Echo, huh?"
    m "— Acho que foi uma boa o seu pai ter tirado de Echo, hein?"

# game/Saturday.rpy:459
translate ptbr saturday_f92816d6:

    # l "— For sure. The place is turning into a ghost town."
    l "— Com certeza. O lugar tá virando uma cidade fantasma."

# game/Saturday.rpy:460
translate ptbr saturday_70193917:

    # l "— It probably will be in another decade or two."
    l "— Provavelmente vai ser daqui a uma ou duas décadas."

# game/Saturday.rpy:461
translate ptbr saturday_5ace45ad:

    # m "— By some standards it already is."
    m "— Por alguns padrões já é."

# game/Saturday.rpy:462
translate ptbr saturday_cfe60d44:

    # "I take another bite of my sandwich, biting right into another bell pepper."
    "Eu dou outra mordida no meu sanduíche, mordendo bem num outro pimentão."

# game/Saturday.rpy:463
translate ptbr saturday_1332201c:

    # "I'd forgotten how good the diner food is."
    "Eu tinha esquecido o quão boa é a comida da lanchonete."

# game/Saturday.rpy:468
translate ptbr saturday_50591bde:

    # "I notice TJ sitting next to Jenna at the table, picking unhappily at his lettuce wrapped chicken."
    "Eu noto o TJ sentado do lado da Jenna na mesa, cutucando infeliz no seu frango enrolado na alface."

# game/Saturday.rpy:469
translate ptbr saturday_a4f8365f:

    # "Jenna seems to as well as she leans towards him."
    "A Jenna parece notar também enquanto se inclina na direção dele."

# game/Saturday.rpy:470
translate ptbr saturday_8a873f12:

    # j "— What's wrong, TJ?"
    j "— Qual o problema, TJ?"

# game/Saturday.rpy:471
translate ptbr saturday_acf1d678:

    # t "— It's just...nevermind, it doesn't matter."
    t "— É só que... deixa pra lá, não importa."

# game/Saturday.rpy:472
translate ptbr saturday_090d0631:

    # j "— Are you sure?"
    j "— Tem certeza?"

# game/Saturday.rpy:473
translate ptbr saturday_43de0079:

    # t "— It's just the mayo, I forget they put it on everything here, hehe."
    t "— É só a maionese, eu esqueço que eles colocam em tudo por aqui, hehe."

# game/Saturday.rpy:474
translate ptbr saturday_547e8e0e:

    # "Jenna lifts up the bun on her sandwich, inspecting its contents."
    "Jenna levanta o pão do sanduíche dela, inspecionando o que tem dentro."

# game/Saturday.rpy:475
translate ptbr saturday_92305ab7:

    # j "— Hmm, none of the mayo really got on my chicken. Here—"
    j "— Hmm, nada da maionese pegou de verdade no meu frango. Toma—"

# game/Saturday.rpy:476
translate ptbr saturday_014c1c6a:

    # t "— No, you don't have—"
    t "— Não, você não precis—"

# game/Saturday.rpy:477
translate ptbr saturday_f66e4698:

    # "Jenna picks up TJ's sandwich and swaps out his grilled chicken."
    "Jenna pega o sanduíche do TJ e troca o frango grelhado dele."

# game/Saturday.rpy:478
translate ptbr saturday_8718ae5a:

    # "She rips off the layer of mayo-tainted lettuce from his lettuce bun before swapping her chicken in."
    "Ela arranca a camada de alface manchada de maionese do pão de alface dele antes de trocar pelo frango dela."

# game/Saturday.rpy:479
translate ptbr saturday_cf09271c:

    # j "— There! How's that?"
    j "— Pronto! E agora?"

# game/Saturday.rpy:480
translate ptbr saturday_036f9b81:

    # t "— Th—thanks..."
    t "— O-obrigado..."

# game/Saturday.rpy:482
translate ptbr saturday_fc3848f0:

    # "It's then that TJ looks up and sees Leo and I staring at him. I see his ears flatten in embarrassment."
    "É aí que o TJ levanta a cabeça e vê o Leo e eu encarando ele. Eu vejo as orelhas dele se abaixarem de vergonha."

# game/Saturday.rpy:483
translate ptbr saturday_34682b18:

    # t "— What!?"
    t "— Que foi!?"

# game/Saturday.rpy:484
translate ptbr saturday_5e91cb3d:

    # l "— Hehe, nothing TJ, nothing."
    l "— Hehe, nada TJ, nada."

# game/Saturday.rpy:488
translate ptbr saturday_f30550e5:

    # m "— So are your parents still letting you live in the house here in Echo?"
    m "— Então os seus pais ainda estão deixando você morar na casa aqui em Echo?"

# game/Saturday.rpy:489
translate ptbr saturday_805180c2:

    # l "— Yes, we actually tried to sell it last year, but of course no one bought."
    l "— Sim, a gente na verdade tentou vender no ano passado, mas é claro que ninguém comprou."

# game/Saturday.rpy:490
translate ptbr saturday_a5932b53:

    # l "— I think two people came to look, but took off once they saw the town."
    l "— Acho que duas pessoas vieram dar uma olhada, mas foram embora assim que viram a cidade."

# game/Saturday.rpy:491
translate ptbr saturday_44b72cc4:

    # l "— Anyway, my parents are living in Payton in a house twice as big as the old one."
    l "— De qualquer forma, os meus pais tão morando em Payton numa casa duas vezes maior do que a velha."

# game/Saturday.rpy:492
translate ptbr saturday_c5b41621:

    # m "— Well, it must be pretty cool living in your own house."
    m "— Bom, deve ser bem legal morar na sua própria casa."

# game/Saturday.rpy:493
translate ptbr saturday_290e5554:

    # l "— My parents aren't constantly breathing down my neck so that's, you know, nice. "
    l "— Os meus pais não tão o tempo todo respirando no meu pescoço, então isso é, sabe, legal."

# game/Saturday.rpy:494
translate ptbr saturday_1b3c2a42:

    # "Leo's already finished his first sandwich, and now he's unwrapping the second."
    "O Leo já terminou o primeiro sanduíche dele, e agora ele tá desembrulhando o segundo."

# game/Saturday.rpy:495
translate ptbr saturday_b90836f4:

    # "He sure could eat a lot."
    "Ele com certeza conseguia comer muito."

# game/Saturday.rpy:496
translate ptbr saturday_08831451:

    # m "— How many people are still here, anyway? In the town, I mean."
    m "— Quantas pessoas ainda tão aqui, afinal? Na cidade, eu quero dizer."

# game/Saturday.rpy:497
translate ptbr saturday_d25048c9:

    # "Leo takes another bite and I hear the crunch of the peppers through his muzzle. He chews thoughtfully for a moment before swallowing."
    "Leo dá outra mordida e eu escuto o barulho dos pimentões pelo focinho dele. Ele mastiga pensativo por um momento antes de engolir."

# game/Saturday.rpy:498
translate ptbr saturday_7b18c7af:

    # l "— Hmm, not too sure. Of course I know almost everyone here, but most don't actually live here anymore."
    l "— Hmm, não tenho muita certeza. É claro que eu conheço quase todo mundo aqui, mas a maioria não mora mais aqui de verdade."

# game/Saturday.rpy:499
translate ptbr saturday_4b35938b:

    # l "— Most everyone's turned their old house into a sort of vacation home, now."
    l "— Quase todo mundo transformou a velha casa numa espécie de casa de férias, agora."

# game/Saturday.rpy:500
translate ptbr saturday_63439dbc:

    # m "— Really, why?"
    m "— Sério, por quê?"

# game/Saturday.rpy:501
translate ptbr saturday_c2ad3b98:

    # "I can't imagine anyone coming here for a vacation..."
    "Não consigo imaginar ninguém vindo pra cá pra passar as férias..."

# game/Saturday.rpy:502
translate ptbr saturday_64e1efe3:

    # "...unless your hobbies are meth or dying of heat stroke."
    "...a menos que seus hobbies sejam metanfetamina ou morrer de insolação."

# game/Saturday.rpy:503
translate ptbr saturday_67db2415:

    # l "— Well, they've all got their old houses here, and it's cheap to build."
    l "— Bom, todos eles têm as velhas casas aqui, e é barato construir."

# game/Saturday.rpy:504
translate ptbr saturday_ace4b991:

    # l "— And the town is actually trying to turn that old lake into a recreational thing."
    l "— E a cidade na verdade tá tentando transformar aquele velho lago em algo recreativo."

# game/Saturday.rpy:505
translate ptbr saturday_aa984d1e:

    # m "— Lake Emma?"
    m "— Lago Emma?"

# game/Saturday.rpy:506
translate ptbr saturday_c5e351af:

    # l "— Yeah. They're putting in docks and stuff."
    l "— É. Eles tão colocando píeres e coisas do tipo."

# game/Saturday.rpy:507
translate ptbr saturday_887e49fb:

    # m "— Huh..."
    m "— Hã..."

# game/Saturday.rpy:508
translate ptbr saturday_4b308593:

    # "Lake Emma is the old reservoir just a few minutes outside of town. As kids, we used to play around there all the time."
    "Lago Emma é o velho reservatório a apenas alguns minutos fora da cidade. Quando crianças, nós costumávamos brincar por lá o tempo todo."

# game/Saturday.rpy:509
translate ptbr saturday_ddb9cb3b:

    # "It was generally an ugly place; dead fish on the banks, a terrible smell, and mosquitoes everywhere."
    "No geral era um lugar feio; peixes mortos nas margens, um cheiro terrível e mosquitos por toda parte."

# game/Saturday.rpy:510
translate ptbr saturday_aacd6b41:

    # "Then again, it could have changed since then. I haven't been there in...twelve years now. None of us have."
    "Pensando bem, pode ter mudado desde então. Já faz... doze anos que não vou lá. Nenhum de nós pisou mais lá."

# game/Saturday.rpy:511
translate ptbr saturday_7e91ae9a:

    # "Thinking about the lake is making my stomach tighten again, forcing away my appetite in the process."
    "Pensar no lago tá fazendo meu estômago apertar de novo, forçando o meu apetite a ir embora no processo."

# game/Saturday.rpy:512
translate ptbr saturday_c3d30dfc:

    # "It's been so long at this point, I need to learn to get over things..."
    "Já faz tanto tempo a essa altura, eu preciso aprender a superar as coisas..."

# game/Saturday.rpy:513
translate ptbr saturday_d1051442:

    # "Actually, that reminds me."
    "Na verdade, isso me lembra de uma coisa."

# game/Saturday.rpy:514
translate ptbr saturday_ca350828:

    # "The others are pretty deep in their own conversations, but I lower my voice anyway, leaning into Leo."
    "Os outros tão bem fundo em suas próprias conversas, mas eu abaixo minha voz mesmo assim, me inclinando pro Leo."

# game/Saturday.rpy:515
translate ptbr saturday_29f60f11:

    # m "— Hey, Leo."
    m "— Ei, Leo."

# game/Saturday.rpy:516
translate ptbr saturday_91bfb0e0:

    # l "— Mmmh?"
    l "— Mmmh?"

# game/Saturday.rpy:517
translate ptbr saturday_390b3200:

    # "Leo turns to me. He had been in the middle of a massive bite and now he has a bell pepper half hanging out of his muzzle."
    "Leo se vira pra mim. Ele tava no meio de uma mordida enorme e agora ele tem metade de um pimentão pendurado no focinho."

# game/Saturday.rpy:518
translate ptbr saturday_e2d5320a:

    # "That throws off my train of thought for a second."
    "Isso me faz perder a linha de raciocínio por um segundo."

# game/Saturday.rpy:519
translate ptbr saturday_872411f0:

    # m "— Uuuh...oh yeah. So I wanted to get some shots of the lake for my project."
    m "— Uuuh... ah é. Então, eu queria tirar umas fotos do lago pro meu projeto."

# game/Saturday.rpy:520
translate ptbr saturday_e6750897:

    # "Leo ducks his head to pull out the pepper from his muzzle, only to shove it back in a second later."
    "Leo abaixa a cabeça pra tirar o pimentão do focinho, só pra enfiar de volta um segundo depois."

# game/Saturday.rpy:521
translate ptbr saturday_1c9196cf:

    # "He chews for a while, but his ears are still tipped towards me, so I go on."
    "Ele mastiga por um tempo, mas as orelhas dele ainda tão inclinadas na minha direção, então eu continuo."

# game/Saturday.rpy:522
translate ptbr saturday_69656627:

    # m "— It's kind of important to Echo's history. Anyway, you told me that on Monday everyone's free during lunch."
    m "— É meio importante pra história de Echo. De qualquer forma, você me disse que na segunda todo mundo tá livre durante o almoço."

# game/Saturday.rpy:523
translate ptbr saturday_4e01bcab:

    # "I can tell by the set of Leo's ears that he knows where I'm going, and he's not too into the idea."
    "Eu consigo perceber pelo jeito das orelhas do Leo que ele sabe onde eu quero chegar, e ele não tá muito a fim da ideia."

# game/Saturday.rpy:524
translate ptbr saturday_7c1a1ad2:

    # "I quickly go on."
    "Eu continuo rápido."

# game/Saturday.rpy:525
translate ptbr saturday_2c5697a2:

    # m "— Of course, we don't have to, but it's been a long time, and if the town is making it look better, it could be fun..."
    m "— Claro, a gente não precisa, mas faz muito tempo, e se a cidade tá deixando melhor, pode ser divertido..."

# game/Saturday.rpy:526
translate ptbr saturday_7375adbb:

    # l "— Listen, Chase..."
    l "— Escuta, Chase..."

# game/Saturday.rpy:527
translate ptbr saturday_277e9fb7:

    # "I feel my face burn a little under the fur."
    "Eu sinto meu rosto queimar um pouco por baixo do pelo."

# game/Saturday.rpy:528
translate ptbr saturday_3acc4ed8:

    # m "— Sorry, it was a dumb idea..."
    m "— Desculpa, foi uma ideia idiota..."

# game/Saturday.rpy:529
translate ptbr saturday_1673c73d:

    # l "— No no, Chase, if it were up to me, I'd definitely do it, it's just..."
    l "— Não, não, Chase, se dependesse de mim, eu definitivamente faria isso, é só que..."

# game/Saturday.rpy:530
translate ptbr saturday_f21ace16:

    # "Leo looks towards Flynn, and I do as well, finding him still bantering with Carl."
    "Leo olha em direção ao Flynn, e eu faço o mesmo, vendo ele ainda trocando farpas com o Carl."

# game/Saturday.rpy:535
translate ptbr saturday_cb6a651a:

    # f "— It doesn't matter how fucking fast you eat, I'm not gonna be impressed."
    f "— Não importa a porra da velocidade que você coma, eu não vou ficar impressionado."

# game/Saturday.rpy:536
translate ptbr saturday_6bf934f0:

    # "He's got that classic Flynn look on his face where he's pressing his lips together, trying not to smile."
    "Ele tá com aquela cara clássica de Flynn em que ele aperta os lábios, tentando não sorrir."

# game/Saturday.rpy:537
translate ptbr saturday_60a358b1:

    # c "— What if I ate all THREE?"
    c "— E se eu comesse os TRÊS?"

# game/Saturday.rpy:538
translate ptbr saturday_a7bbb63e:

    # f "— You've already eaten most of the first one, so that's not gonna happen now, is it?"
    f "— Você já comeu a maior parte do primeiro, então isso não vai acontecer agora, né?"

# game/Saturday.rpy:542
translate ptbr saturday_f4eb28c4:

    # "I look back down at my sandwich."
    "Eu volto a olhar pro meu sanduíche."

# game/Saturday.rpy:543
translate ptbr saturday_d4e8da48:

    # "I suddenly feel really guilty. Here I am, back after three years, just assuming that I know how everyone feels."
    "De repente me sinto muito culpado. Aqui estou eu, de volta depois de três anos, apenas assumindo que eu sei como todo mundo se sente."

# game/Saturday.rpy:544
translate ptbr saturday_4b0e5119:

    # "Now I'm kinda feeling like an impostor."
    "Agora eu meio que tô me sentindo um impostor."

# game/Saturday.rpy:545
translate ptbr saturday_d30a5f04:

    # "Leo notices, like he always did, and he nudges me with his shoulder."
    "Leo nota, como ele sempre fazia, e me dá um empurrãozinho com o ombro."

# game/Saturday.rpy:546
translate ptbr saturday_6af1c279:

    # l "— Hey, don't worry about it, it's not your fault."
    l "— Ei, não se preocupa com isso, não é sua culpa."

# game/Saturday.rpy:547
translate ptbr saturday_7b8491d8:

    # "Suddenly, Leo's ears perk up, and I know he's suddenly had an idea."
    "De repente, as orelhas do Leo se levantam, e eu sei que ele teve uma ideia de repente."

# game/Saturday.rpy:548
translate ptbr saturday_d945644c:

    # "His ears made him easily readable, just as reading people came easily to him."
    "As orelhas dele o tornavam fácil de ler, assim como ler pessoas era algo fácil pra ele."

# game/Saturday.rpy:549
translate ptbr saturday_91db531f:

    # "It made it all the more impressive that he was able to tell what most of us were thinking, considering my short, stubby ears."
    "Isso tornava ainda mais impressionante que ele era capaz de saber o que a maioria de nós estava pensando, considerando as minhas orelhas curtas e atarracadas."

# game/Saturday.rpy:550
translate ptbr saturday_29ae864d:

    # "...Or Flynn's lack thereof."
    "...Ou a falta delas no caso do Flynn."

# game/Saturday.rpy:551
translate ptbr saturday_7f685c36:

    # l "— Listen, there's a cool little spot by the river that's actually pretty close to the lake."
    l "— Escuta, tem um lugarzinho legal perto do rio que na verdade é bem perto do lago."

# game/Saturday.rpy:552
translate ptbr saturday_ab40ccc7:

    # l "— We could have lunch and you could walk over and get your shots!"
    l "— A gente podia almoçar e você poderia ir até lá tirar as suas fotos!"

# game/Saturday.rpy:553
translate ptbr saturday_19b80190:

    # "The idea makes me feel a bit better."
    "A ideia me faz me sentir um pouco melhor."

# game/Saturday.rpy:554
translate ptbr saturday_3467b650:

    # m "— Alright, that could be fun. Also, this motel doesn't have a pool, so it'll be really nice to swim in something."
    m "— Tá bom, isso pode ser divertido. E também, esse motel não tem piscina, então vai ser muito bom nadar em alguma coisa."

# game/Saturday.rpy:555
translate ptbr saturday_c1617655:

    # l "— Heh, otters and their waters. Anyway, I'll have to ask Flynn, but I think he'll be okay with it."
    l "— Heh, lontras e suas águas. Enfim, eu vou ter que perguntar pro Flynn, mas acho que ele vai ficar de boa com isso."

# game/Saturday.rpy:560
translate ptbr saturday_8158f8a1:

    # f "— What would REALLY impress me is if you didn't eat the rest."
    f "— O que me impressionaria DE VERDADE é se você não comesse o resto."

# game/Saturday.rpy:561
translate ptbr saturday_406326a0:

    # c "— ..."
    c "— ..."

# game/Saturday.rpy:562
translate ptbr saturday_3f312140:

    # c "— You're a funny guy, Flynn."
    c "— Você é um cara engraçado, Flynn."

# game/Saturday.rpy:563
translate ptbr saturday_52c38fc5:

    # "Carl goes right back to shoving the next burger into his mouth as Flynn looks on in mild disgust."
    "Carl volta a enfiar o próximo hambúrguer na boca enquanto o Flynn olha com certo nojo."

# game/Saturday.rpy:564
translate ptbr saturday_6e461419:

    # "He suddenly notices us watching him and he gives us an odd look, but that slowly morphs into a smirk as he focuses on Leo."
    "De repente ele nota que a gente tá olhando pra ele e lança um olhar estranho, mas que se transforma devagar num sorriso malicioso enquanto ele foca no Leo."

# game/Saturday.rpy:565
translate ptbr saturday_2857d94b:

    # f "— You're lookin' pretty happy there, Leo. Not like you've been for the past three years."
    f "— Você tá parecendo bem feliz aí, Leo. Não como você tem estado nos últimos três anos."

# game/Saturday.rpy:569
translate ptbr saturday_0dd06364:

    # "I furrow my brow in confusion and look up at Leo. I see him shift and he's giving Flynn a look that I don't quite understand."
    "Eu franzo a testa confuso e olho pro Leo. Eu vejo ele se mexer e dar pro Flynn um olhar que eu não entendo direito."

# game/Saturday.rpy:570
translate ptbr saturday_a1f47678:

    # l "— Well of course I'm happy to see us all back together again."
    l "— Bom, é claro que eu tô feliz em ver todos nós de volta juntos de novo."

# game/Saturday.rpy:571
translate ptbr saturday_da721ed1:

    # "I look from Leo to Flynn, and it's pretty easy to imagine a bolt of electricity between them."
    "Eu olho do Leo pro Flynn, e é bem fácil imaginar um raio de eletricidade entre eles."

# game/Saturday.rpy:576
translate ptbr saturday_83639221:

    # f "— You should have seen him, Chase. He'd go days without smiling."
    f "— Você devia ter visto ele, Chase. Ele passava dias sem sorrir."

# game/Saturday.rpy:577
translate ptbr saturday_2202cec5:

    # c "— Agreed, Leo's been kind of a dick ever since you guys left."
    c "— Concordo, o Leo tem sido meio idiota desde que vocês foram embora."

# game/Saturday.rpy:578
translate ptbr saturday_9d7a981e:

    # f "— Isn't Jenna a counselor? Hey, you should have a session with Leo."
    f "— A Jenna não é conselheira? Ei, você devia ter uma sessão com o Leo."

# game/Saturday.rpy:583
translate ptbr saturday_64d8f080:

    # j "— Um, I'm still an undergrad. I'm not going into counseling, anyway."
    j "— Hum, eu ainda tô na graduação. Eu não vou pra área de aconselhamento, de qualquer forma."

# game/Saturday.rpy:584
translate ptbr saturday_d26d191c:

    # j "— That would just make me sad."
    j "— Isso só me deixaria triste."

# game/Saturday.rpy:585
translate ptbr saturday_a2ac4bda:

    # "TJ is busy trying to hold his sandwich together and eat it at the same time, not very successfully, but he looks up as well."
    "O TJ tá ocupado tentando segurar o sanduíche e comer ao mesmo tempo, sem muito sucesso, mas ele levanta a cabeça também."

# game/Saturday.rpy:586
translate ptbr saturday_36e7beea:

    # t "— Leo depressed? It's hard to imagine you NOT smiling. You seemed fine online."
    t "— O Leo depressivo? É difícil imaginar você NÃO sorrindo. Você parecia bem online."

# game/Saturday.rpy:587
translate ptbr saturday_790e164b:

    # j "— Has something been going on, Leo?"
    j "— Tem acontecido alguma coisa, Leo?"

# game/Saturday.rpy:591
translate ptbr saturday_18059d04:

    # "For the first time since he's arrived, Leo looks truly uncomfortable."
    "Pela primeira vez desde que chegou, o Leo parece verdadeiramente desconfortável."

# game/Saturday.rpy:592
translate ptbr saturday_06216bdb:

    # "You don't see him like that very often."
    "Você não vê ele assim com muita frequência."

# game/Saturday.rpy:593
translate ptbr saturday_c5d3418a:

    # "Flynn, on the other hand, has his trying-not-to-smirk face on."
    "O Flynn, por outro lado, tá com a sua cara de tentando-não-sorrir."

# game/Saturday.rpy:595
translate ptbr saturday_19ea8486:

    # l "— Wh-I-I..."
    l "— O-q-Eu-Eu..."

# game/Saturday.rpy:596
translate ptbr saturday_f7952baf:

    # "Leo pauses, pinned down by everyone's eyes in the room, then he takes a frustrated breath."
    "Leo pausa, imobilizado pelos olhos de todos na sala, então ele solta um suspiro frustrado."

# game/Saturday.rpy:597
translate ptbr saturday_55b6bf0a:

    # l "— Can't people be sad sometimes? Yes, things have been more...have been harder, but I'm fine."
    l "— As pessoas não podem ficar tristes de vez em quando? Sim, as coisas têm sido mais... têm sido mais difíceis, mas eu tô bem."

# game/Saturday.rpy:598
translate ptbr saturday_13b03fed:

    # l "— I think it's pretty clear that FLYNN-"
    l "— Eu acho que tá bem claro que o FLYNN—"

# game/Saturday.rpy:599
translate ptbr saturday_ab24d5c4:

    # "Leo flicks his long muzzle at the lizard."
    "Leo aponta o focinho comprido pro lagarto."

# game/Saturday.rpy:600
translate ptbr saturday_416c4b51:

    # l "— -Is just trying to get some reactions."
    l "—Tá só tentando conseguir algumas reações."

# game/Saturday.rpy:604
translate ptbr saturday_b89effca:

    # f "— Suuure, I'm just sayin' you're back to your old self. But seriously, it's great..."
    f "— Claaaaro, eu só tô dizendo que você voltou a ser o que era. Mas, falando sério, é ótimo..."

# game/Saturday.rpy:608
translate ptbr saturday_f6057f13:

    # "Leo makes a snorting sound."
    "Leo faz um som de bufo."

# game/Saturday.rpy:609
translate ptbr saturday_83cdbf68:

    # "I'm about to ask Leo what's so stressful when he lifts his paw up again to take a bite of his almost-finished sandwich."
    "Eu tô prestes a perguntar pro Leo o que é tão estressante quando ele levanta a pata de novo pra dar uma mordida no seu sanduíche quase terminado."

# game/Saturday.rpy:611
translate ptbr saturday_1abf6d0d:

    # "I go quiet as I look at his paw."
    "Eu fico quieto enquanto olho pra pata dele."

# game/Saturday.rpy:612
translate ptbr saturday_e169a1a8:

    # "A silver anchor, tied around his wrist with leather. The word otter is etched into the shank of the anchor, the name Chase is engraved into the stock."
    "Uma âncora de prata, amarrada ao redor do pulso dele com couro. A palavra lontra tá cravada na haste da âncora, o nome Chase tá gravado no cepo."

# game/Saturday.rpy:613
translate ptbr saturday_99fb4784:

    # "Why was he still..."
    "Por que ele ainda tava..."

# game/Saturday.rpy:614
translate ptbr saturday_6e4cbcbb:

    # t "— CHASE!"
    t "— CHASE!"

# game/Saturday.rpy:615
translate ptbr saturday_f6244b72:

    # "I jump as TJ's voice breaks through my trance, bouncing on the bed once I come down."
    "Eu dou um pulo quando a voz do TJ quebra o meu transe, quicando na cama assim que eu caio."

# game/Saturday.rpy:616
translate ptbr saturday_1f97f1d4:

    # "Leo looks at me as the bed wobbles, an eyebrow raised."
    "Leo olha pra mim enquanto a cama balança, com uma sobrancelha levantada."

# game/Saturday.rpy:620
translate ptbr saturday_44ab1429:

    # "TJ puts a paw to his muzzle."
    "TJ coloca uma pata no focinho."

# game/Saturday.rpy:621
translate ptbr saturday_c81040f8:

    # t "— Oops! Sorry, you were just kinda staring off into space."
    t "— Opa! Desculpa, você só tava meio que olhando pro nada."

# game/Saturday.rpy:622
translate ptbr saturday_5df2e16c:

    # m "— Yeah, uh, just thinkin' about stuff. What's up?"
    m "— É, ah, só pensando em umas coisas. O que foi?"

# game/Saturday.rpy:623
translate ptbr saturday_6762d116:

    # t "— We were just talking about {i}The Last Game{/i}. Didn't you tell me that you saw that movie on the drive here?."
    t "— A gente tava falando sobre {i}O Último Jogo{/i}. Você não me disse que assistiu a esse filme na viagem pra cá?"

# game/Saturday.rpy:629
translate ptbr saturday_7cf91e25:

    # c "— I really don't get you right now, TJ...{i}The Last Game{/i} was the WORST Lion's Brigade movie!"
    c "— Eu realmente não te entendo agora, TJ... {i}O Último Jogo{/i} foi o PIOR filme da Brigada do Leão!"

# game/Saturday.rpy:633
translate ptbr saturday_c60420f9:

    # f "— You're just mad 'cuz they didn't follow the comics."
    f "— Você só tá puto porque eles não seguiram os quadrinhos."

# game/Saturday.rpy:638
translate ptbr saturday_8060978b:

    # t "— Yeah, Carl, as a movie it was just better...I'm sure the comics are great too, though, hehe."
    t "— É, Carl, como filme foi só melhor... eu tenho certeza que os quadrinhos são ótimos também, no entanto, hehe."

# game/Saturday.rpy:642
translate ptbr saturday_3f5a507f:

    # f "— Naw, the comics are shit. Carl tried showin' 'em to me once."
    f "— Nah, os quadrinhos são uma merda. O Carl tentou me mostrar eles uma vez."

# game/Saturday.rpy:647
translate ptbr saturday_2ce5cbfd:

    # c "— Bwah!!??"
    c "— Queh!!??"

# game/Saturday.rpy:648
translate ptbr saturday_ebe8cd3a:

    # c "— See? This is the problem. They never follow the source material and no one cares because they have no respect for the originals, man."
    c "— Tá vendo? Esse é o problema. Eles nunca seguem o material de origem e ninguém liga porque não têm nenhum respeito pelos originais, cara."

# game/Saturday.rpy:652
translate ptbr saturday_80dae186:

    # l "— You're waaay too picky, Carl. {i}The Last Game{/i} was a great movie!"
    l "— Você é muuuito exigente, Carl. {i}O Último Jogo{/i} foi um ótimo filme!"

# game/Saturday.rpy:653
translate ptbr saturday_9d0bad7d:

    # c "— Not you too, Leo!"
    c "— Você também não, Leo!"

# game/Saturday.rpy:658
translate ptbr saturday_04425449:

    # t "— I don't know, I think Lion's Brigade was always a bit too violent for me, what with all the shooting and punching."
    t "— Eu não sei, eu acho que a Brigada do Leão sempre foi um pouco violenta demais pra mim, com todos os tiros e socos."

# game/Saturday.rpy:659
translate ptbr saturday_48786f47:

    # t "— I've always liked the Trinity Weasel. She's the thinking man's superheroine."
    t "— Eu sempre gostei da Doninha Trinity. Ela é a super-heroína do homem que pensa."

# game/Saturday.rpy:660
translate ptbr saturday_98ab8954:

    # "Carl waves his paw dismissively."
    "Carl acena a pata com desdém."

# game/Saturday.rpy:661
translate ptbr saturday_a9e2ea3d:

    # c "— The Trinity comics have always been pretty lame. They're jerk-off fodder for lonely nerds...and so's the movie."
    c "— Os quadrinhos da Trinity sempre foram bem fracos. Eles são material de punheta pra nerds solitários... e o filme também."

# game/Saturday.rpy:662
translate ptbr saturday_7c78e382:

    # l "— Ha! You mean like yourself?"
    l "— Rá! Você quer dizer igual a você?"

# game/Saturday.rpy:664
translate ptbr saturday_83b7a320:

    # c "— Hey..."
    c "— Ei..."

# game/Saturday.rpy:668
translate ptbr saturday_5e428159:

    # f "— Hold up, we're talking about Trinity now? Julia Blasco...She's hella fine!"
    f "— Peraí, a gente tá falando da Trinity agora? Julia Blasco... ela é muito gostosa!"

# game/Saturday.rpy:669
translate ptbr saturday_ebd526cb:

    # f "— Never seen an ass like hers on a weasel before."
    f "— Nunca vi uma bunda como a dela numa doninha antes."

# game/Saturday.rpy:674
translate ptbr saturday_e3afe8c1:

    # j "— That's because it's fake."
    j "— Isso é porque ela é falsa."

# game/Saturday.rpy:680
translate ptbr saturday_aed19cfc:

    # t "— N—no, I just like the story."
    t "— N-não, eu só gosto da história."

# game/Saturday.rpy:681
translate ptbr saturday_7dba8b33:

    # t "— It's really kind of deep, if you think about it."
    t "— É meio profunda de verdade, se você parar pra pensar."

# game/Saturday.rpy:682
translate ptbr saturday_a1240a27:

    # f "— It was hard to think about when half the shots are slo-mo and she's doing all these flips and backbends and shit."
    f "— Foi difícil de pensar nisso quando metade das cenas é em câmera lenta e ela tá dando um monte de mortal, cambalhota e essas merdas."

# game/Saturday.rpy:687
translate ptbr saturday_46d8627d:

    # j "— Hmm? I didn't think that was your sort of thing anyway, Flynn?"
    j "— Hum? Eu não achei que esse fosse o seu tipo de coisa de qualquer forma, Flynn?"

# game/Saturday.rpy:688
translate ptbr saturday_63106da6:

    # "Flynn doesn't have time to retort before Jenna shifts her attention, seemingly coming to TJ's defense."
    "Flynn não tem tempo de retrucar antes da Jenna mudar a atenção dela, parecendo vir em defesa do TJ."

# game/Saturday.rpy:689
translate ptbr saturday_8e76d9b2:

    # j "— Come on, Trinity DOES have more story going on than your average superhero movie."
    j "— Qual é, Trinity TEM mais história rolando do que a média dos seus filmes de super-herói."

# game/Saturday.rpy:690
translate ptbr saturday_9e0d8219:

    # j "— I think it's great that you like her character over all the meat-heads."
    j "— Eu acho ótimo que você goste da personagem dela mais do que de todos aqueles caras musculosos."

# game/Saturday.rpy:691
translate ptbr saturday_3d1757d9:

    # l "— Yeah, they just stuck in all the boob shots to reel in the dummies."
    l "— É, eles só enfiaram todas aquelas cenas de peitos pra atrair os idiotas."

# game/Saturday.rpy:697
translate ptbr saturday_39f7c4aa:

    # f "— Of course that's easy for someone like {i}you{/i} to say. Besides, I see what's going on here."
    f "— Claro que é fácil pra alguém como {i}você{/i} dizer. Além disso, eu tô vendo o que tá rolando aqui."

# game/Saturday.rpy:698
translate ptbr saturday_d3454884:

    # f "— Maybe you should watch {i}Luche Lobo{/i}, TJ. He's shirtless the whole time."
    f "— Talvez você devesse assistir {i}Luche Lobo{/i}, TJ. Ele fica sem camisa o tempo todo."

# game/Saturday.rpy:700
translate ptbr saturday_a3589361:

    # "TJ's ears go flat, tufts pointed at the ground."
    "As orelhas do TJ se abaixam, com os tufos apontados pro chão."

# game/Saturday.rpy:702
translate ptbr saturday_dc27ad43:

    # f "— I'd better stop it with all this saucy talk. The only way this could get any more awkward is if ya got sprung!"
    f "— É melhor eu parar com todo esse papo picante. A única maneira de isso ficar mais constrangedor é se você ficar de pau duro!"

# game/Saturday.rpy:703
translate ptbr saturday_606946e1:

    # "We all groan in unison, but TJ shoots right back:"
    "Nós todos gememos em uníssono, mas o TJ devolve na lata:"

# game/Saturday.rpy:705
translate ptbr saturday_b1433fa6:

    # t "— And knowing you, that's {i}exactly{/i} what you want to happen, isn't it, Flynn?"
    t "— E conhecendo você, isso é {i}exatamente{/i} o que você quer que aconteça, não é, Flynn?"

# game/Saturday.rpy:709
translate ptbr saturday_592b203e:

    # "That gets a few surprised chuckles."
    "Isso arranca algumas risadas surpresas."

# game/Saturday.rpy:710
translate ptbr saturday_5f7c68ca:

    # c "— Daaaamn TJ, where'd that come from?"
    c "— Caaaaraio TJ, de onde veio isso?"

# game/Saturday.rpy:711
translate ptbr saturday_466c55a9:

    # "It isn't that it is a particularly good joke. It's that it came from TJ that makes it so funny."
    "Não é que seja uma piada particularmente boa. É que veio do TJ que torna tão engraçado."

# game/Saturday.rpy:712
translate ptbr saturday_6274e21f:

    # "I don't think I've ever heard him talk like that."
    "Eu não acho que já ouvi ele falar desse jeito."

# game/Saturday.rpy:714
translate ptbr saturday_07187f69:

    # "Even Flynn can't keep from grinning a little bit."
    "Até o Flynn não consegue evitar de dar um sorrisinho."

# game/Saturday.rpy:716
translate ptbr saturday_54ac4343:

    # "We talk late into the afternoon."
    "A gente conversa até o fim da tarde."

# game/Saturday.rpy:717
translate ptbr saturday_8e1677dc:

    # "At this point all of my worries have disappeared, leaving a happy, warm feeling in its place."
    "A essa altura todas as minhas preocupações desapareceram, deixando um sentimento feliz e caloroso no lugar."

# game/Saturday.rpy:718
translate ptbr saturday_b92447f0:

    # "It seems silly that I'd been so nervous earlier. In fact, I'm starting to look forward to the rest of the week."
    "Parece bobeira que eu estivesse tão nervoso mais cedo. Na verdade, eu tô começando a ficar ansioso pelo resto da semana."

# game/Saturday.rpy:722
translate ptbr saturday_65a5a5f4:

    # l "— Alright, alright."
    l "— Tá bom, tá bom."

# game/Saturday.rpy:723
translate ptbr saturday_0dcfc7bb:

    # "Leo steps forward, indicating that we should all shut up."
    "Leo dá um passo à frente, indicando que todos nós devíamos calar a boca."

# game/Saturday.rpy:724
translate ptbr saturday_4352de76:

    # l "— Now, we all need to remember that Chase is here to do his school project, so that comes first."
    l "— Agora, a gente precisa se lembrar de que o Chase tá aqui pra fazer o projeto da faculdade dele, então isso vem em primeiro lugar."

# game/Saturday.rpy:725
translate ptbr saturday_0644f5d2:

    # l "— But! I did make a few other plans for things that we can do on his off time."
    l "— Mas! Eu fiz alguns outros planos de coisas que podemos fazer no tempo livre dele."

# game/Saturday.rpy:726
translate ptbr saturday_a9aad8dd:

    # l "— I'm pretty sure all of us know that we're going to Southwest Adventures tomorrow, so I'll pick these two up—"
    l "— Tenho quase certeza que todo mundo sabe que vamos pro Southwest Adventures amanhã, então eu vou pegar esses dois—"

# game/Saturday.rpy:727
translate ptbr saturday_f54e80cd:

    # "He jerks his head towards Flynn and Carl."
    "Ele aponta com a cabeça pro Flynn e pro Carl."

# game/Saturday.rpy:728
translate ptbr saturday_4e0ea33e:

    # l "—then swing by the motel to get you guys at 9, alright?"
    l "—e depois dou uma passada no motel pra pegar vocês às 9, beleza?"

# game/Saturday.rpy:729
translate ptbr saturday_6802401b:

    # j "— Sounds good."
    j "— Parece bom."

# game/Saturday.rpy:730
translate ptbr saturday_4a146edf:

    # l "— Then I was thinking about doing some stuff in Payton towards the end of the week, but we'll make those plans later."
    l "— Aí eu tava pensando em fazer umas coisas em Payton lá pro fim da semana, mas a gente faz esses planos depois."

# game/Saturday.rpy:731
translate ptbr saturday_1d50b169:

    # l "— In between those times we should find time to hang out as well, make the most of this."
    l "— Entre esses momentos a gente devia achar um tempo pra dar uns rolês também, aproveitar ao máximo isso."

# game/Saturday.rpy:732
translate ptbr saturday_72c9c1d4:

    # "Leo looks about done, but suddenly snaps his fingers, as if remembering something."
    "O Leo parece ter terminado, mas de repente estala os dedos, como se lembrasse de algo."

# game/Saturday.rpy:733
translate ptbr saturday_6b8f550d:

    # l "— Oh yeah! Chase, I saw you had a camera."
    l "— Ah é! Chase, eu vi que você tava com uma câmera."

# game/Saturday.rpy:734
translate ptbr saturday_17e17c6f:

    # l "— Think you could get a pic of us? It would be nice for all of us to have something that isn't camera phone quality."
    l "— Acha que consegue tirar uma foto da gente? Seria legal pra todos nós ter alguma coisa que não seja na qualidade da câmera do celular."

# game/Saturday.rpy:735
translate ptbr saturday_8baa3959:

    # m "— Oh, sure. I was messing with the self-timer earlier."
    m "— Ah, claro. Eu tava mexendo no temporizador automático mais cedo."

# game/Saturday.rpy:736
translate ptbr saturday_17c0c40a:

    # m "— Should be able to get it to work."
    m "— Acho que consigo fazer funcionar."

# game/Saturday.rpy:739
translate ptbr saturday_0e4a084d:

    # "After a few minutes of me adjusting the tripod, and Leo adjusting everyone at the end of one of the beds, we manage to get into position."
    "Depois de alguns minutos comigo ajustando o tripé, e o Leo ajeitando todo mundo no pé de uma das camas, a gente consegue entrar em posição."

# game/Saturday.rpy:740
translate ptbr saturday_55a70de6:

    # m "— Aaaalright, here goes..."
    m "— Taaaá bom, lá vai..."

# game/Saturday.rpy:741
translate ptbr saturday_98a65776:

    # "I set the timer and fast-walk to the spot Leo saved for me."
    "Eu defino o temporizador e ando rápido pro lugar que o Leo guardou pra mim."

# game/Saturday.rpy:751
translate ptbr saturday_55f86cec:

    # "For the next two hours we watch a movie on TV, not really paying attention, mostly catching up with each other on how we'd been."
    "Pelas próximas duas horas a gente assiste a um filme na TV, sem prestar atenção de verdade, mais pondo o papo em dia sobre como a gente tava."

# game/Saturday.rpy:752
translate ptbr saturday_c0280a20:

    # "It's good to be back and it feels like we're all just picking up where we left off three years ago."
    "É bom estar de volta e a sensação é de que a gente tá só recomeçando de onde a gente parou três anos atrás."

# game/Saturday.rpy:753
translate ptbr saturday_909fb121:

    # "It's really nice."
    "É bem legal."

# game/Saturday.rpy:754
translate ptbr saturday_690535b2:

    # "Finally, at about 10, Leo, Carl, and Flynn head out."
    "Finalmente, lá pelas 10, o Leo, o Carl e o Flynn vão embora."

# game/Saturday.rpy:755
translate ptbr saturday_ac56f3d2:

    # "I spend the next twenty minutes tinkering with the equipment, making sure it's all in order for shooting the next day."
    "Eu passo os próximos vinte minutos mexendo no equipamento, tendo certeza de que tá tudo em ordem pra filmar no dia seguinte."

# game/Saturday.rpy:756
translate ptbr saturday_f4b6e5cd:

    # "Once TJ finishes getting ready for bed in the bathroom, I do as well before getting into bed, head-to-toe with TJ."
    "Assim que o TJ termina de se arrumar pra dormir no banheiro, eu faço o mesmo antes de deitar na cama, de cabeça pros pés com o TJ."

# game/Saturday.rpy:757
translate ptbr saturday_4e65724c:

    # "There's a soft glow from the corner as Jenna sits at the table reading something."
    "Tem um brilho suave vindo do canto onde a Jenna tá sentada na mesa lendo alguma coisa."

# game/Saturday.rpy:758
translate ptbr saturday_d0578e75:

    # "I lay in bed, staring at the ceiling, waiting for her to go to sleep..."
    "Eu deito na cama, encarando o teto, esperando ela ir dormir..."

# game/Saturday.rpy:763
translate ptbr saturday_0e605e7a:

    # "There's a chain attached to my ankle as I walk away from the lake, my legs and feet caked in mud."
    "Tem uma corrente presa no meu tornozelo enquanto eu me afasto do lago, minhas pernas e pés cobertos de lama."

# game/Saturday.rpy:764
translate ptbr saturday_a611cb07:

    # "I look back, seeing the chain snaking back around the rocks and reeds before disappearing into the water."
    "Eu olho pra trás, vendo a corrente rastejando de volta ao redor das pedras e do junco antes de sumir na água."

# game/Saturday.rpy:765
translate ptbr saturday_08c41525:

    # "Looking ahead again, I see Leo. He's smiling, waving at me."
    "Olhando pra frente de novo, eu vejo o Leo. Ele tá sorrindo, acenando pra mim."

# game/Saturday.rpy:766
translate ptbr saturday_5dc18b8d:

    # "I walk towards him and the chain stays slack, pulling easily out of the water."
    "Eu ando na direção dele e a corrente continua frouxa, saindo com facilidade da água."

# game/Saturday.rpy:767
translate ptbr saturday_971e333e:

    # "— There's an anchor in the lake,\" I say."
    "— Tem uma âncora no lago\", eu digo."

# game/Saturday.rpy:768
translate ptbr saturday_5df1d6e2:

    # "I stare at him, but he doesn't say anything and just keeps on smiling."
    "Eu encaro ele, mas ele não diz nada e só continua sorrindo."

# game/Saturday.rpy:769
translate ptbr saturday_79595e4a:

    # "I crouch on the rocks, wrapping the chain around my wrist a few times."
    "Eu me agacho nas pedras, enrolando a corrente no meu pulso algumas vezes."

# game/Saturday.rpy:770
translate ptbr saturday_446375c0:

    # "Leo kneels next to me, rubbing my back and sticking out his arm to compare our \"bracelets\", saying that everyone gets one."
    "O Leo se ajoelha do meu lado, esfregando minhas costas e esticando o braço dele pra comparar nossos \"braceletes\", dizendo que todo mundo ganha um."

# game/Saturday.rpy:771
translate ptbr saturday_5f0556cb:

    # "He seems happy, but now I'm stuck here. I can't even stand up to walk."
    "Ele parece feliz, mas agora eu tô preso aqui. Eu não consigo nem me levantar pra andar."

translate ptbr strings:

    # game/Saturday.rpy:91
    old "— Yeah"
    new "— Sim."

    # game/Saturday.rpy:91
    old "— Not really."
    new "— Na verdade não."

    # game/Saturday.rpy:91
    old "— I'm nervous."
    new "— Estou nervoso."

