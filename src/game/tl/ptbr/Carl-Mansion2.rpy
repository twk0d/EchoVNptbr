# game/Carl-Mansion2.rpy:3
translate ptbr mansion2_8bb1c3ac:

    # ra "\"Jenna?\""
    ra "\"Jenna?\""

# game/Carl-Mansion2.rpy:6
translate ptbr mansion2_b675e6ff:

    # "Jenna stands there stoically, holding what looks like a small, wooden stool."
    "Jenna está de pé ali, estoica, segurando o que parece ser um pequeno banquinho de madeira."

# game/Carl-Mansion2.rpy:7
translate ptbr mansion2_d0f54cdf:

    # m "\"Jenna!? What—how did you get here?\""
    m "\"Jenna!? O que... como você veio parar aqui?\""

# game/Carl-Mansion2.rpy:9
translate ptbr mansion2_30eeaf64:

    # "Jenna slowly sets the stool down, slowly seeming to recognize me."
    "Jenna lentamente coloca o banquinho no chão, parecendo me reconhecer aos poucos."

# game/Carl-Mansion2.rpy:10
translate ptbr mansion2_fe4249df:

    # "I lean forward to feel my ankle, the pain radiating from it in hot pulses."
    "Eu me inclino para frente para tocar no meu tornozelo, a dor irradiando dele em pulsações quentes."

# game/Carl-Mansion2.rpy:12
translate ptbr mansion2_4aefcda4:

    # j "\"Chase? Are you okay? What happened to your leg?\""
    j "\"Chase? Você tá bem? O que aconteceu com a sua perna?\""

# game/Carl-Mansion2.rpy:13
translate ptbr mansion2_ce53400b:

    # m "\"I...sprained it.\""
    m "\"Eu... torci.\""

# game/Carl-Mansion2.rpy:15
translate ptbr mansion2_e9c04dd9:

    # ra "\"Hey Jenna. It's been a while!\""
    ra "\"Oi Jenna. Quanto tempo!\""

# game/Carl-Mansion2.rpy:16
translate ptbr mansion2_b3971889:

    # "I look over at Carl who's still curled up on his side, his arms wrapped around himself."
    "Olho para o Carl, que ainda está encolhido de lado, com os braços cruzados ao redor de si mesmo."

# game/Carl-Mansion2.rpy:17
translate ptbr mansion2_2f4521ca:

    # m "\"Carl! You okay?\""
    m "\"Carl! Você tá bem?\""

# game/Carl-Mansion2.rpy:18
translate ptbr mansion2_ecc6b3c5:

    # "Then to Jenna;"
    "Depois para a Jenna:"

# game/Carl-Mansion2.rpy:19
translate ptbr mansion2_67bc18a9:

    # m "\"Did you hit him?\""
    m "\"Você bateu nele?\""

# game/Carl-Mansion2.rpy:21
translate ptbr mansion2_52b1cdff:

    # "Jenna walks past Carl and crouches down next to my leg."
    "Jenna passa pelo Carl e se agacha perto da minha perna."

# game/Carl-Mansion2.rpy:22
translate ptbr mansion2_5b6eddbc:

    # j "\"This looks really bad.\""
    j "\"Isso parece muito ruim.\""

# game/Carl-Mansion2.rpy:23
translate ptbr mansion2_39bec0d3:

    # m "\"Yeah...Carl, are you okay?\""
    m "\"É... Carl, você tá bem?\""

# game/Carl-Mansion2.rpy:24
translate ptbr mansion2_1967a487:

    # c "\"Mmmmgh....\""
    c "\"Mmmmgh....\""

# game/Carl-Mansion2.rpy:25
translate ptbr mansion2_678aebe3:

    # "Carl grunts and turns over to face us, a hand to his chest."
    "Carl resmunga e se vira para nos encarar, com a mão no peito."

# game/Carl-Mansion2.rpy:26
translate ptbr mansion2_549524be:

    # c "\"Jenna? What the fuck was that?\""
    c "\"Jenna? Que porra foi essa?\""

# game/Carl-Mansion2.rpy:27
translate ptbr mansion2_eba3d918:

    # "Jenna looks at my ankle a while longer before standing up and looking around."
    "Jenna olha para o meu tornozelo por mais um tempo antes de se levantar e olhar ao redor."

# game/Carl-Mansion2.rpy:28
translate ptbr mansion2_30e07793:

    # "When it doesn't look like she's going to answer, Carl sits up."
    "Quando parece que ela não vai responder, Carl se senta."

# game/Carl-Mansion2.rpy:30
translate ptbr mansion2_35775fd4:

    # c "\"How did you find us here?\""
    c "\"Como você achou a gente aqui?\""

# game/Carl-Mansion2.rpy:31
translate ptbr mansion2_ada04cea:

    # "Raven perks up."
    "Raven se anima."

# game/Carl-Mansion2.rpy:32
translate ptbr mansion2_1ec4a1d0:

    # ra "\"Yeah! Is there a way out?\""
    ra "\"É! Tem alguma saída?\""

# game/Carl-Mansion2.rpy:34
translate ptbr mansion2_f5d687e4:

    # "Jenna finally looks down at Carl and I note the complete lack of concern in her eyes."
    "Jenna finalmente olha para o Carl, e noto a completa falta de preocupação nos olhos dela."

# game/Carl-Mansion2.rpy:35
translate ptbr mansion2_12dac4c9:

    # j "\"I came to your house looking for TJ and ended up going to the basement.\""
    j "\"Fui na sua casa procurar o TJ e acabei indo pro porão.\""

# game/Carl-Mansion2.rpy:36
translate ptbr mansion2_9210c0ff:

    # "She looks down the hall again."
    "Ela olha para o corredor de novo."

# game/Carl-Mansion2.rpy:37
translate ptbr mansion2_1a76ad2a:

    # j "\"And I ended up here somehow. I blacked out before I did, so I don't know how to get out.\""
    j "\"E vim parar aqui de alguma forma. Eu apaguei antes disso, então não sei como sair.\""

# game/Carl-Mansion2.rpy:38
translate ptbr mansion2_e73be72a:

    # "Carl finally stands up, wearily eying the stool held loosely in Jenna's hand before bending down to help me back up."
    "Carl finalmente se levanta, olhando desconfiado para o banquinho na mão da Jenna antes de se abaixar para me ajudar a levantar."

# game/Carl-Mansion2.rpy:39
translate ptbr mansion2_6f234c2a:

    # c "\"Your leg okay?\""
    c "\"Sua perna tá bem?\""

# game/Carl-Mansion2.rpy:40
translate ptbr mansion2_ba72dffc:

    # "He grunts into my ear as he slides my arm over his shoulder and slowly pulls me back up onto his back."
    "Ele resmunga no meu ouvido enquanto passa meu braço pelo ombro dele e me puxa devagar para as costas dele de novo."

# game/Carl-Mansion2.rpy:41
translate ptbr mansion2_9b8f6759:

    # m "\"M—mostly. I think I kinda twisted it up again.\""
    m "\"M—mais ou menos. Acho que meio que torci de novo.\""

# game/Carl-Mansion2.rpy:43
translate ptbr mansion2_da9ed82d:

    # "Carl grunts again and turns back to Jenna, now with me on his back."
    "Carl resmunga de novo e se vira para a Jenna, agora comigo nas costas."

# game/Carl-Mansion2.rpy:44
translate ptbr mansion2_e5cfe638:

    # c "\"Well, that's pretty fucked up just to blindly swing at someone around a corner.\""
    c "\"Bem, isso é muita sacanagem, bater às cegas em alguém na esquina de um corredor.\""

# game/Carl-Mansion2.rpy:46
translate ptbr mansion2_268b1410:

    # j "\"No. What's fucked up is waking up in a place you have no memory of going to.\""
    j "\"Não. Sacanagem é acordar num lugar onde você não faz a menor ideia de como foi parar.\""

# game/Carl-Mansion2.rpy:48
translate ptbr mansion2_7fce1e7a:

    # "Jenna's sharp muzzle points right at Carl, glaring."
    "O focinho pontudo da Jenna aponta direto para o Carl, fuzilando-o com os olhos."

# game/Carl-Mansion2.rpy:49
translate ptbr mansion2_877ab411:

    # "Carl stutters for a second, clearly not expecting to have Jenna snap back at him."
    "Carl gagueja por um segundo, claramente sem esperar que a Jenna respondesse atravessado."

# game/Carl-Mansion2.rpy:50
translate ptbr mansion2_42779d54:

    # c "\"H—hey, this isn't my fault. We have no idea where we're at either.\""
    c "\"E—ei, isso não é culpa minha. A gente também não tem ideia de onde tá.\""

# game/Carl-Mansion2.rpy:52
translate ptbr mansion2_06cb71b8:

    # ra "\"Why are you guys fighting?\""
    ra "\"Por que vocês estão brigando?\""

# game/Carl-Mansion2.rpy:53
translate ptbr mansion2_004181d6:

    # "Raven looks innocently between the two of them, his ears perked."
    "Raven olha inocentemente de um para o outro, com as orelhas em pé."

# game/Carl-Mansion2.rpy:54
translate ptbr mansion2_bccc5024:

    # "It's a good question and I watch Jenna closely from over Carl's shoulder."
    "É uma boa pergunta, e observo a Jenna de perto por cima do ombro do Carl."

# game/Carl-Mansion2.rpy:55
translate ptbr mansion2_899b0c37:

    # "She just glares at Carl, arms folded."
    "Ela só encara o Carl de braços cruzados."

# game/Carl-Mansion2.rpy:56
translate ptbr mansion2_db93ce33:

    # "Did she blame him for this, somehow?"
    "Será que ela culpava ele por isso, de alguma forma?"

# game/Carl-Mansion2.rpy:58
translate ptbr mansion2_2fff21a6:

    # "After a few seconds of awkward silence, Carl speaks up."
    "Depois de alguns segundos de um silêncio constrangedor, Carl se pronuncia."

# game/Carl-Mansion2.rpy:60
translate ptbr mansion2_c220b90b:

    # c "\"Well, you hit me for one. I don't know why YOU are so mad at me.\""
    c "\"Bem, pra começar, você me bateu. Não sei por que VOCÊ tá tão brava comigo.\""

# game/Carl-Mansion2.rpy:62
translate ptbr mansion2_12a6eac7:

    # "Jenna looks back at Carl and I see the tenseness in her shoulders slowly loosen."
    "Jenna olha para o Carl e vejo a tensão nos ombros dela diminuir lentamente."

# game/Carl-Mansion2.rpy:64
translate ptbr mansion2_5eaaffac:

    # j "\"I'm sorry...I'm just a little uptight after waking up here.\""
    j "\"Desculpa... Só tô um pouco tensa depois de acordar aqui.\""

# game/Carl-Mansion2.rpy:66
translate ptbr mansion2_b6a60ac1:

    # ra "\"Hey, you're taking it better than us. Chase was freaking out for hours.\""
    ra "\"Ei, você tá lidando com isso melhor que a gente. O Chase ficou surtando por horas.\""

# game/Carl-Mansion2.rpy:67
translate ptbr mansion2_ee68af63:

    # "I give Raven a side glance."
    "Dou um olhar de soslaio para o Raven."

# game/Carl-Mansion2.rpy:68
translate ptbr mansion2_19d74d4f:

    # j "\"Well, things have been going crazy since you two left the lake."
    j "\"Well, as coisas andam uma loucura desde que vocês dois saíram do lago.\""

# game/Carl-Mansion2.rpy:69
translate ptbr mansion2_ef3994bc:

    # m "\"Like us ending up in this fucking nightmare dimension?\""
    m "\"Tipo a gente vir parar nessa porra de dimensão de pesadelo?\""

# game/Carl-Mansion2.rpy:70
translate ptbr mansion2_da07b81c:

    # j "\"Not just that.\""
    j "\"Não só isso.\""

# game/Carl-Mansion2.rpy:72
translate ptbr mansion2_54097930:

    # "Jenna sets the stool down on the carpet before sticking out her forearm."
    "Jenna coloca o banquinho no tapete antes de estender o antebraço."

# game/Carl-Mansion2.rpy:73
translate ptbr mansion2_0bcf61c5:

    # "That's when I see the crusted blood in her fur in the form of three long lines."
    "É aí que vejo o sangue seco na pelagem dela na forma de três linhas longas."

# game/Carl-Mansion2.rpy:77
translate ptbr mansion2_72beecd9:

    # c "\"What the...\""
    c "\"O que...\""

# game/Carl-Mansion2.rpy:79
translate ptbr mansion2_1e1efd05:

    # j "\"TJ attacked me.\""
    j "\"O TJ me atacou.\""

# game/Carl-Mansion2.rpy:80
translate ptbr mansion2_486a0250:

    # m "\"What!?\""
    m "\"O quê!?\""

# game/Carl-Mansion2.rpy:81
translate ptbr mansion2_62d62e4d:

    # "That sentence doesn't seem to fit together. TJ attacked?"
    "Essa frase não parece fazer sentido. O TJ atacou?"

# game/Carl-Mansion2.rpy:83
translate ptbr mansion2_d24a0e9a:

    # c "\"Why?\""
    c "\"Por quê?\""

# game/Carl-Mansion2.rpy:84
translate ptbr mansion2_9a6611b0:

    # j "\"I have no idea.\""
    j "\"Eu não faço a menor ideia.\""

# game/Carl-Mansion2.rpy:86
translate ptbr mansion2_9e432bef:

    # "The faraway, vacant look Jenna had in her eyes earlier is fading to be replaced by a more concerned expression I better know her for."
    "Aquele olhar distante e vago que a Jenna tinha nos olhos antes vai sumindo, sendo substituído por uma expressão mais preocupada, pela qual a conheço melhor."

# game/Carl-Mansion2.rpy:87
translate ptbr mansion2_8a45818f:

    # j "\"He's been losing it ever since Flynn tried to grab him at the lake.\""
    j "\"Ele tá perdendo a cabeça desde que o Flynn tentou agarrar ele no lago.\""

# game/Carl-Mansion2.rpy:88
translate ptbr mansion2_47e4915a:

    # "I start to feel a little sick to my stomach."
    "Começo a sentir um leve enjoo no estômago."

# game/Carl-Mansion2.rpy:89
translate ptbr mansion2_fdcfd18e:

    # m "\"Why?\""
    m "\"Por quê?\""

# game/Carl-Mansion2.rpy:90
translate ptbr mansion2_56493c73:

    # j "\"He wouldn't tell me. He was just acting anxious, kept looking over his shoulder.\""
    j "\"Ele não quis me falar. Só estava agindo de forma ansiosa, olhando por cima do ombro o tempo todo.\""

# game/Carl-Mansion2.rpy:91
translate ptbr mansion2_05546e1f:

    # m "\"But isn't he sort of like that most of the time?\""
    m "\"Mas ele não é meio assim na maior parte do tempo?\""

# game/Carl-Mansion2.rpy:93
translate ptbr mansion2_d5eab9a5:

    # "Jenna folds her arms then shakes her head."
    "Jenna cruza os braços e balança a cabeça."

# game/Carl-Mansion2.rpy:94
translate ptbr mansion2_da4ef914:

    # j "\"No. He kept looking around, kept saying he was seeing things...\""
    j "\"Não. Ele ficava olhando ao redor, dizendo que estava vendo coisas...\""

# game/Carl-Mansion2.rpy:95
translate ptbr mansion2_511b81e9:

    # "She stops short."
    "Ela para de repente."

# game/Carl-Mansion2.rpy:96
translate ptbr mansion2_7e1c0a15:

    # c "\"...Like what?\""
    c "\"...Tipo o quê?\""

# game/Carl-Mansion2.rpy:97
translate ptbr mansion2_7a7c2ffe:

    # "Jenna looks up."
    "Jenna olha para cima."

# game/Carl-Mansion2.rpy:98
translate ptbr mansion2_522a3e2a:

    # j "\"Sydney.\""
    j "\"O Sydney.\""

# game/Carl-Mansion2.rpy:99
translate ptbr mansion2_92a6bd3f:

    # "We're quiet for a while."
    "Ficamos em silêncio por um tempo."

# game/Carl-Mansion2.rpy:100
translate ptbr mansion2_f6ec178d:

    # ra "\"It seems all of the rumors about this town are true; everyone is crazy.\""
    ra "\"Parece que todos os boatos sobre essa cidade são verdadeiros; todo mundo é louco.\""

# game/Carl-Mansion2.rpy:101
translate ptbr mansion2_fa13f0a1:

    # c "\"This isn't normal at all...even in Echo.\""
    c "\"Isso não é nem um pouco normal... mesmo para Echo.\""

# game/Carl-Mansion2.rpy:103
translate ptbr mansion2_5741367f:

    # "Jenna looks at Raven."
    "Jenna olha para o Raven."

# game/Carl-Mansion2.rpy:104
translate ptbr mansion2_0b74d57c:

    # j "\"I'm sorry. Who are you?\""
    j "\"Desculpa. Quem é você?\""

# game/Carl-Mansion2.rpy:106
translate ptbr mansion2_47b5f3d9:

    # "Raven grins."
    "Raven abre um sorriso."

# game/Carl-Mansion2.rpy:107
translate ptbr mansion2_12472f77:

    # ra "\"No, I'm sorry. I'm Raven!\""
    ra "\"Não, desculpa eu. Sou o Raven!\""

# game/Carl-Mansion2.rpy:108
translate ptbr mansion2_450e0c60:

    # "He sticks out a hand."
    "Ele estende a mão."

# game/Carl-Mansion2.rpy:109
translate ptbr mansion2_7a85f558:

    # "Jenna looks at it before turning to me."
    "Jenna olha para a mão dele antes de se virar para mim."

# game/Carl-Mansion2.rpy:111
translate ptbr mansion2_357c2078:

    # j "\"Chase. Something was going on with Leo, too. He kept asking around for you, then he ran off saying he had to take care of some things.\""
    j "\"Chase. Estava acontecendo alguma coisa com o Leo também. Ele ficou te procurando por todo lado, e depois saiu correndo dizendo que precisava resolver umas coisas.\""

# game/Carl-Mansion2.rpy:113
translate ptbr mansion2_6393d47f:

    # m "\"Oh, I—I don't know why...\""
    m "\"Ah, eu... não sei por quê...\""

# game/Carl-Mansion2.rpy:114
translate ptbr mansion2_ac3f42a1:

    # "I try to think of what Leo might have wanted from me, but I draw a blank; it could be anything."
    "Tento pensar no que o Leo poderia querer de mim, mas dá um branco; podia ser qualquer coisa."

# game/Carl-Mansion2.rpy:115
translate ptbr mansion2_b77084bf:

    # j "\"Anyway, I'd been trying to find TJ for ages.. I don't even know what day it is anymore.\""
    j "\"De qualquer forma, eu estava tentando achar o TJ há eras... Já nem sei mais que dia é hoje.\""

# game/Carl-Mansion2.rpy:116
translate ptbr mansion2_a70d4382:

    # j "\"Tried Carl's house since I'd ran out of any other options.\""
    j "\"Tentei a casa do Carl, já que tinham me acabado as outras opções.\""

# game/Carl-Mansion2.rpy:117
translate ptbr mansion2_fb7b1858:

    # "Jenna goes quiet, then reaches into her pocket and pulls out her phone, holding it up, clearly looking for a signal."
    "Jenna fica em silêncio, depois enfia a mão no bolso e puxa o celular, erguendo-o, claramente procurando sinal."

# game/Carl-Mansion2.rpy:118
translate ptbr mansion2_33a301ad:

    # j "\"Just as I got to your house, Carl, I heard popping sounds.\""
    j "\"Bem quando cheguei na sua casa, Carl, ouvi uns estalos.\""

# game/Carl-Mansion2.rpy:119
translate ptbr mansion2_f6705e5e:

    # "Jenna sighs and puts her phone away again."
    "Jenna suspira e guarda o celular de novo."

# game/Carl-Mansion2.rpy:120
translate ptbr mansion2_fd78ddc1:

    # j "\"Gunshots, I'm pretty sure, coming from Main Street. Something's been happening to everyone.\""
    j "\"Tiros, tenho quase certeza, vindo da Main Street. Algo anda acontecendo com todo mundo.\""

# game/Carl-Mansion2.rpy:121
translate ptbr mansion2_742155f3:

    # "Jenna slides her hands into her back pockets, looking around."
    "Jenna enfia as mãos nos bolsos de trás, olhando ao redor."

# game/Carl-Mansion2.rpy:122
translate ptbr mansion2_030302d5:

    # j "\"And now this...\""
    j "\"E agora isso...\""

# game/Carl-Mansion2.rpy:123
translate ptbr mansion2_8c4e5c77:

    # m "\"Wow.\""
    m "\"Nossa.\""

# game/Carl-Mansion2.rpy:124
translate ptbr mansion2_cf8a7ce3:

    # "So something fucked up is happening all over town."
    "Então tem alguma merda acontecendo na cidade inteira."

# game/Carl-Mansion2.rpy:125
translate ptbr mansion2_2e8be305:

    # "I think about Leo and TJ and my stomach twists at the thought of them being out there."
    "Penso no Leo e no TJ, e meu estômago embrulha só de pensar neles lá fora."

# game/Carl-Mansion2.rpy:126
translate ptbr mansion2_7060b3d5:

    # "I can only hope that they were able to get out somehow."
    "Só posso torcer para que eles tenham conseguido sair de alguma forma."

# game/Carl-Mansion2.rpy:127
translate ptbr mansion2_7cb0a136:

    # j "\"At this point I'm just waiting to wake up.\""
    j "\"A essa altura, só estou esperando acordar.\""

# game/Carl-Mansion2.rpy:128
translate ptbr mansion2_ab3ce721:

    # c "\"We all are.\""
    c "\"Todos nós.\""

# game/Carl-Mansion2.rpy:130
translate ptbr mansion2_e728eeca:

    # ra "\"Yeah! Especially after a giant smoke monster chased us around the dining room.\""
    ra "\"É! Principalmente depois que um monstro de fumaça gigante caçou a gente pela sala de jantar.\""

# game/Carl-Mansion2.rpy:132
translate ptbr mansion2_c8071644:

    # j "\"What?\""
    j "\"O quê?\""

# game/Carl-Mansion2.rpy:133
translate ptbr mansion2_d0dff75a:

    # "Jenna looks at me and Carl."
    "Jenna olha para mim e para o Carl."

# game/Carl-Mansion2.rpy:134
translate ptbr mansion2_1285ca5f:

    # "Carl glances back at me, as if asking me to be the one to explain the impossibility that had just happened."
    "Carl olha de volta para mim, como se me pedisse para ser aquele a explicar a impossibilidade que tinha acabado de acontecer."

# game/Carl-Mansion2.rpy:136
translate ptbr mansion2_969ef3d6:

    # "I take a breath, trying to think of how I'm going to say this."
    "Respiro fundo, tentando pensar em como vou falar isso."

# game/Carl-Mansion2.rpy:137
translate ptbr mansion2_44519499:

    # m "\"So...I think at this point you're going to have to just—just go with whatever this place throws at you, Jenna.\""
    m "\"Então... acho que, a essa altura, você vai ter que simplesmente... aceitar qualquer loucura que este lugar jogar na sua cara, Jenna.\""

# game/Carl-Mansion2.rpy:138
translate ptbr mansion2_296d93f1:

    # ra "\"Yeah, we've all just kind of accepted what's been happening.\""
    ra "\"É, a gente meio que só aceitou o que anda acontecendo.\""

# game/Carl-Mansion2.rpy:139
translate ptbr mansion2_309cc71e:

    # m "\"Well, we have to. Otherwise it would just be us sitting around freaking out about how crazy this all is and not doing anything about it.\""
    m "\"Bem, a gente tem que aceitar. Senão, ia ser só a gente sentado aqui surtando com o quão louco tudo isso é e sem fazer nada a respeito.\""

# game/Carl-Mansion2.rpy:140
translate ptbr mansion2_68035828:

    # c "\"And so far it seems we've at least been moving things forward.\""
    c "\"E, pelo menos até agora, parece que estamos fazendo as coisas avançarem.\""

# game/Carl-Mansion2.rpy:141
translate ptbr mansion2_3836cbfa:

    # "Jenna stares at us."
    "Jenna fica nos encarando."

# game/Carl-Mansion2.rpy:142
translate ptbr mansion2_a3e485b8:

    # j "\"What happened?\""
    j "\"O que aconteceu?\""

# game/Carl-Mansion2.rpy:146
translate ptbr mansion2_ddb86547:

    # "We all stand in front of the wooden door in a half circle, none of us wanting to open it."
    "Todos nós ficamos em frente à porta de madeira em um semicírculo, nenhum de nós querendo abrir."

# game/Carl-Mansion2.rpy:148
translate ptbr mansion2_06eff9e5:

    # j "\"So...this is all to clear James' name?\""
    j "\"Então... tudo isso é para limpar o nome do James?\""

# game/Carl-Mansion2.rpy:149
translate ptbr mansion2_d622376f:

    # c "\"Seems that way.\""
    c "\"Parece que sim.\""

# game/Carl-Mansion2.rpy:150
translate ptbr mansion2_e7387718:

    # j "\"But why go through all of this trouble?\""
    j "\"Mas por que passar por todo esse trabalho?\""

# game/Carl-Mansion2.rpy:151
translate ptbr mansion2_f77c6419:

    # "I rest on my good foot on the carpeted floor while I lean on Carl's back, wanting to give him some relief from carrying me all the time."
    "Apoio meu pé bom no chão acarpetado enquanto me encosto nas costas do Carl, querendo aliviar ele um pouco de me carregar o tempo todo."

# game/Carl-Mansion2.rpy:152
translate ptbr mansion2_c87324bf:

    # m "\"Probably because of the smoke monster thing. It's trying to stop him. Maybe it's making all of these obstacles?\""
    m "\"Provavelmente por causa daquela coisa de monstro de fumaça. Tá tentando impedir ele. Talvez esteja criando todos esses obstáculos?\""

# game/Carl-Mansion2.rpy:153
translate ptbr mansion2_4c7f26ff:

    # j "\"Hmm...\""
    j "\"Hmm...\""

# game/Carl-Mansion2.rpy:154
translate ptbr mansion2_16156f1c:

    # "Jenna had taken our whole description of what had happened in the dining room pretty well."
    "Jenna lidou muito bem com toda a nossa descrição do que tinha acontecido na sala de jantar."

# game/Carl-Mansion2.rpy:155
translate ptbr mansion2_5e61f5b1:

    # "She listened silently while I'd explained what had happened so far."
    "Ela ouviu em silêncio enquanto eu explicava o que tinha acontecido até agora."

# game/Carl-Mansion2.rpy:156
translate ptbr mansion2_baab3ab3:

    # c "\"So, I guess if we can get his story straight, maybe get it out to the town about what really happened, we might be able to get out of here.\""
    c "\"Então, acho que se a gente conseguir esclarecer a história dele, talvez espalhar pra cidade o que realmente aconteceu, a gente consiga sair daqui.\""

# game/Carl-Mansion2.rpy:157
translate ptbr mansion2_26a772c6:

    # "Jenna eyes the door."
    "Jenna observa a porta."

# game/Carl-Mansion2.rpy:158
translate ptbr mansion2_c1b67379:

    # j "\"You think that there's maybe a reason why this monster doesn't want James to get this information out?\""
    j "\"Você acha que talvez tenha um motivo pro monstro não querer que o James espalhe essa informação?\""

# game/Carl-Mansion2.rpy:159
translate ptbr mansion2_233db3f3:

    # "We're quiet for a moment."
    "Ficamos quietos por um momento."

# game/Carl-Mansion2.rpy:160
translate ptbr mansion2_9e9fc14d:

    # m "\"Well, we don't have much else to go on.\""
    m "\"Bem, a gente não tem muito mais o que seguir.\""

# game/Carl-Mansion2.rpy:161
translate ptbr mansion2_fbebee29:

    # "Again, there's a long pause as we all contemplate what the hell might be behind the door."
    "Mais uma vez, há uma longa pausa enquanto todos nós contemplamos o que diabos pode estar atrás da porta."

# game/Carl-Mansion2.rpy:162
translate ptbr mansion2_5fadc855:

    # "That pause is broken by a certain husky, though, as his white hand suddenly reaches out to grasp the handle."
    "Essa pausa é quebrada por um certo husky, no entanto, quando a mão branca dele de repente se estende para segurar a maçaneta."

# game/Carl-Mansion2.rpy:163
translate ptbr mansion2_4cf688e8:

    # ra "\"Maybe we've already done what needs to be done? I'll bet this gets us home!\""
    ra "\"Talvez a gente já tenha feito o que precisava ser feito? Aposto que isso nos leva pra casa!\""

# game/Carl-Mansion2.rpy:164
translate ptbr mansion2_047e85b9:

    # c "\"Raven!\""
    c "\"Raven!\""

# game/Carl-Mansion2.rpy:166
translate ptbr mansion2_b17ab493:

    # "The heavy door pulls open slowly with an unearthly squeal."
    "A porta pesada se abre lentamente com um guincho bizarro."

# game/Carl-Mansion2.rpy:169
translate ptbr mansion2_3e07aee5:

    # "For the brief moment that I'm conscious, I see a black square in front of me that grows in size until it takes up my entire vision."
    "Pelo breve momento em que fico consciente, vejo um quadrado preto na minha frente que cresce de tamanho até ocupar toda a minha visão."

# game/Carl-Mansion2.rpy:170
translate ptbr mansion2_6d97610d:

    # "The muscles in my back and neck seize up and my teeth clench together as my head jerks back."
    "Os músculos das minhas costas e do meu pescoço se contraem e meus dentes se travam enquanto minha cabeça dá um tranco para trás."

# game/Carl-Mansion2.rpy:171
translate ptbr mansion2_bbebd33c:

    # "And then I'm falling..."
    "E então estou caindo..."

# game/Carl-Mansion2.rpy:175
translate ptbr mansion2_e9fa5b01:

    # "There's a rhythmic throbbing in my head."
    "Há uma pulsação rítmica na minha cabeça."

# game/Carl-Mansion2.rpy:176
translate ptbr mansion2_068f670a:

    # "But it's hard to decide if it's coming from inside my head, or outside."
    "Mas é difícil decidir se está vindo de dentro da minha cabeça, ou de fora."

# game/Carl-Mansion2.rpy:177
translate ptbr mansion2_ed05fa06:

    # "The next sense to come back to me is touch; I feel a cold hard hard surface under my back, probably wood judging by the way my claws sink into it."
    "O próximo sentido a voltar para mim é o tato; sinto uma superfície fria e dura sob as minhas costas, provavelmente madeira, a julgar pela forma como minhas garras afundam nela."

# game/Carl-Mansion2.rpy:178
translate ptbr mansion2_308d9904:

    # "I shift around a little, but I don't feel like getting up just yet."
    "Eu me mexo um pouco, mas ainda não estou com vontade de levantar."

# game/Carl-Mansion2.rpy:179
translate ptbr mansion2_4b5da664:

    # "The smell is musty and old."
    "O cheiro é de mofo e velho."

# game/Carl-Mansion2.rpy:180
translate ptbr mansion2_b55c5db4:

    # "I'm reminded of my grandpa's woodshed, a place I'd often go when I played hide and seek."
    "Lembro do galpão de lenha do meu avô, um lugar onde eu ia com frequência quando brincava de esconde-esconde."

# game/Carl-Mansion2.rpy:181
translate ptbr mansion2_d0a58114:

    # "The drumming sound continues and the rhythm makes me think that it's definitely coming from outside my body."
    "O som de batidas continua, e o ritmo me faz pensar que com certeza vem de fora do meu corpo."

# game/Carl-Mansion2.rpy:182
translate ptbr mansion2_6e925145:

    # "It sounds...tribal, in a way."
    "Parece... tribal, de certa forma."

# game/Carl-Mansion2.rpy:183
translate ptbr mansion2_ba0d7482:

    # "Where am I?"
    "Onde eu estou?"

# game/Carl-Mansion2.rpy:184
translate ptbr mansion2_a8732005:

    # "On the edges of my memory are troubling images of endless halls and rooms, the smell of decay and a noose."
    "Nos limites da minha memória estão imagens perturbadoras de corredores e salas infinitas, cheiro de decomposição e uma forca."

# game/Carl-Mansion2.rpy:185
translate ptbr mansion2_1aa2b285:

    # "But I feel like if I block it out and just go back to sleep, I can erase all of it."
    "Mas sinto que se eu ignorar isso e apenas voltar a dormir, posso apagar tudo."

# game/Carl-Mansion2.rpy:186
translate ptbr mansion2_b950697e:

    # "I almost succeed, but then something brings me right out of my reverie."
    "Quase consigo, mas então algo me tira do meu devaneio."

# game/Carl-Mansion2.rpy:187
translate ptbr mansion2_f7b922ba:

    # ra "\"Caaaarl?...Chaaaase?\""
    ra "\"Caaaarl?...Chaaaase?\""

# game/Carl-Mansion2.rpy:188
translate ptbr mansion2_881b0024:

    # "I grimace, the voice reminding me of something dark, cloudy..."
    "Faço uma careta, a voz me lembrando de algo sombrio, nebuloso..."

# game/Carl-Mansion2.rpy:189
translate ptbr mansion2_6cd02182:

    # ra "\"Heeeelp!\""
    ra "\"Ajudaaa!\""

# game/Carl-Mansion2.rpy:190
translate ptbr mansion2_1edd3843:

    # "The much louder yelp that follows has me rolling to my side, cracking my eyes open blearily."
    "O ganido muito mais alto que se segue me faz rolar de lado, abrindo os olhos com dificuldade."

# game/Carl-Mansion2.rpy:194
translate ptbr mansion2_0fe66654:

    # "I'm in a dark room, very dark, the only source of light coming from what looks like a candle on a bedside table."
    "Estou em um quarto escuro, muito escuro, com a única fonte de luz vinda do que parece ser uma vela em uma mesa de cabeceira."

# game/Carl-Mansion2.rpy:195
translate ptbr mansion2_6efe2f24:

    # "A large bed sits next to it."
    "Uma cama grande fica ao lado dela."

# game/Carl-Mansion2.rpy:196
translate ptbr mansion2_d546eb76:

    # "I'm laying near the foot of this bed and, opposite me, I can barely make out a wall next to which is a wooden box."
    "Estou deitado perto do pé desta cama e, à minha frente, mal consigo distinguir uma parede ao lado da qual há uma caixa de madeira."

# game/Carl-Mansion2.rpy:197
translate ptbr mansion2_377639af:

    # ra "\"Heeeeeellp...\""
    ra "\"Ajuuuuda...\""

# game/Carl-Mansion2.rpy:198
translate ptbr mansion2_446112bb:

    # "Raven's plaintive moan forces me to my feet, my joints cracking uncomfortably."
    "O lamento queixoso do Raven me força a levantar, minhas articulações estalando de forma desconfortável."

# game/Carl-Mansion2.rpy:199
translate ptbr mansion2_cf243189:

    # "As I drag my right foot up to stand under me, a blinding pain flashes up my leg, sending bright white across my vision."
    "Ao arrastar o pé direito para me apoiar, uma dor lancinante sobe pela minha perna, deixando minha visão toda branca."

# game/Carl-Mansion2.rpy:200
translate ptbr mansion2_8bbce084:

    # "I let out a muffled scream of pain behind my clenched teeth, closing my eyes as I wait for it to subside."
    "Solto um grito abafado de dor com os dentes cerrados, fechando os olhos enquanto espero passar."

# game/Carl-Mansion2.rpy:201
translate ptbr mansion2_b4286dec:

    # "Memories are starting to flow back to me."
    "As lembranças começam a voltar."

# game/Carl-Mansion2.rpy:202
translate ptbr mansion2_86024088:

    # "There's a doorway in front of me and I start to make my way towards it, hopping slowly on my left foot, holding the right off the ground."
    "Tem um vão de porta na minha frente e começo a ir em direção a ele, pulando devagar no pé esquerdo e mantendo o direito fora do chão."

# game/Carl-Mansion2.rpy:203
translate ptbr mansion2_18b9ddbe:

    # "I come into a small hallway, one that branches to my left into a corridor of darkness."
    "Entro em um pequeno corredor, um que se ramifica à minha esquerda em um corredor de escuridão."

# game/Carl-Mansion2.rpy:204
translate ptbr mansion2_414ce82f:

    # "Right in front of me, however, is a set of stairs."
    "Direto na minha frente, porém, há uma escada."

# game/Carl-Mansion2.rpy:205
translate ptbr mansion2_1326bf4d:

    # "Light glows at the bottom and I'm pretty sure that's where Raven's voice is coming from."
    "Uma luz brilha lá embaixo e tenho quase certeza de que é dali que vem a voz do Raven."

# game/Carl-Mansion2.rpy:206
translate ptbr mansion2_2c5f5df0:

    # "In fact, I'm pretty sure I can hear other voices coming from there as well."
    "Na verdade, tenho quase certeza de que posso ouvir outras vozes vindo de lá também."

# game/Carl-Mansion2.rpy:207
translate ptbr mansion2_5b672b84:

    # "I look down at my ankle, wincing as I see that it's gotten even bigger, more than twice it's original size."
    "Olho para baixo para o meu tornozelo, fazendo uma careta ao ver que ele ficou ainda maior, mais do que o dobro do tamanho original."

# game/Carl-Mansion2.rpy:208
translate ptbr mansion2_d3ec6b01:

    # "I'm starting to think that it's more than a sprain."
    "Estou começando a achar que é mais do que uma torção."

# game/Carl-Mansion2.rpy:209
translate ptbr mansion2_38316958:

    # "As I make my way down the stairs, cringing with every light hop, my stomach starts to sink."
    "Conforme desço a escada, estremecendo a cada pulinho de leve, meu estômago começa a embrulhar."

# game/Carl-Mansion2.rpy:210
translate ptbr mansion2_44213eb0:

    # "I remember now, the weird mansion that we were just in, the doors and hallways and the smoke monster."
    "Eu me lembro agora, da mansão bizarra em que estávamos, as portas e corredores e o monstro de fumaça."

# game/Carl-Mansion2.rpy:211
translate ptbr mansion2_43888319:

    # "And the door we just went through...whatever's happening to us isn't over yet."
    "E a porta pela qual acabamos de passar... o que quer que esteja acontecendo com a gente ainda não acabou."

# game/Carl-Mansion2.rpy:215
translate ptbr mansion2_1280fb92:

    # "When I reach the bottom of the stairs, I find Jenna and Carl standing around a tall, brown wardrobe."
    "Quando chego ao pé da escada, encontro a Jenna e o Carl de pé ao redor de um guarda-roupa alto e marrom."

# game/Carl-Mansion2.rpy:216
translate ptbr mansion2_d2a2b65d:

    # "As I stand there, breathing heavily, Carl turns to see me."
    "Enquanto fico ali, respirando pesado, Carl se vira para me ver."

# game/Carl-Mansion2.rpy:218
translate ptbr mansion2_98a39349:

    # c "\"Chase!\""
    c "\"Chase!\""

# game/Carl-Mansion2.rpy:219
translate ptbr mansion2_631a8188:

    # "He immediately rushes to my side, his hooves clopping loudly against the wooden floor."
    "Ele corre imediatamente para o meu lado, os cascos batendo forte contra o piso de madeira."

# game/Carl-Mansion2.rpy:220
translate ptbr mansion2_5a993649:

    # "I think he's simply coming over to support me, but he wraps me up in a hug."
    "Acho que ele está apenas vindo me apoiar, mas ele me envolve em um abraço."

# game/Carl-Mansion2.rpy:221
translate ptbr mansion2_78ad9c11:

    # c "\"God, I keep worrying that one of us is gonna disappear...I'm glad you're here.\""
    c "\"Meu Deus, fico com medo de que um de nós vá desaparecer... Fico feliz que você esteja aqui.\""

# game/Carl-Mansion2.rpy:222
translate ptbr mansion2_f20793e2:

    # m "\"Y—yeah, I'm fine...I was upstairs in a bedroom, I think.\""
    m "\"É—é, eu tô bem... Eu estava lá em cima em um quarto, eu acho.\""

# game/Carl-Mansion2.rpy:224
translate ptbr mansion2_25bf4e24:

    # "The anxiety I'm feeling over the whole situation goes away just a little, absorbed into the soft warmth of Carl's body."
    "A ansiedade que estou sentindo em relação a toda essa situação diminui um pouco, absorvida pelo calor suave do corpo do Carl."

# game/Carl-Mansion2.rpy:225
translate ptbr mansion2_a0d3cc06:

    # "Over Carl's shoulder I can see Jenna watching us, her eyes narrowed, expression dark."
    "Por cima do ombro do Carl, consigo ver a Jenna nos observando, com os olhos semicerrados e uma expressão sombria."

# game/Carl-Mansion2.rpy:226
translate ptbr mansion2_73d316fa:

    # "I'm about to ask her what's wrong when I hear a loud bang from inside the wardrobe."
    "Estou prestes a perguntar o que há de errado quando ouço um estrondo alto vindo de dentro do guarda-roupa."

# game/Carl-Mansion2.rpy:227
translate ptbr mansion2_48324a08:

    # ra "\"Guys!? Are you still there? I think something touched me!\""
    ra "\"Pessoal!? Vocês ainda estão aí? Acho que alguma coisa me tocou!\""

# game/Carl-Mansion2.rpy:229
translate ptbr mansion2_91f30ada:

    # "Jenna turns back to the wardrobe, silent for a moment, then bends down to look at something."
    "Jenna se vira de volta para o guarda-roupa, em silêncio por um momento, depois se abaixa para olhar para alguma coisa."

# game/Carl-Mansion2.rpy:230
translate ptbr mansion2_18c34f93:

    # ra "\"Guys?\""
    ra "\"Pessoal?\""

# game/Carl-Mansion2.rpy:231
translate ptbr mansion2_5a401587:

    # "I hear a metallic click, then Jenna jumps back as one of the doors swing open and a black and white blur falls out like a rock."
    "Ouço um clique metálico, e então a Jenna pula para trás enquanto uma das portas se abre e um vulto preto e branco cai feito uma pedra."

# game/Carl-Mansion2.rpy:232
translate ptbr mansion2_85b22b08:

    # "Raven face plants neatly into the wooden floor."
    "Raven cai de cara no chão de madeira."

# game/Carl-Mansion2.rpy:233
translate ptbr mansion2_f47a33b8:

    # "He stays there a moment, moaning into the planks before Jenna bends over to help him up."
    "Ele fica ali por um momento, gemendo contra as tábuas, antes de a Jenna se inclinar para ajudá-lo a levantar."

# game/Carl-Mansion2.rpy:234
translate ptbr mansion2_e3c66534:

    # j "\"Are you alright?\""
    j "\"Você tá bem?\""

# game/Carl-Mansion2.rpy:235
translate ptbr mansion2_385b4bd3:

    # ra "\"Urgh....yeah...I just—I just felt like something grabbed me.\""
    ra "\"Urgh... sim... eu só... só senti como se algo tivesse me agarrado.\""

# game/Carl-Mansion2.rpy:236
translate ptbr mansion2_d0a1af16:

    # "I look back up into the wardrobe to find a very bare and empty wooden compartment."
    "Olho de volta para dentro do guarda-roupa e encontro um compartimento de madeira bem vazio."

# game/Carl-Mansion2.rpy:237
translate ptbr mansion2_f2aa3961:

    # "I'm inclined to believe him, though, after everything that's happened."
    "No entanto, estou inclinado a acreditar nele, depois de tudo o que aconteceu."

# game/Carl-Mansion2.rpy:239
translate ptbr mansion2_a0004a6e:

    # ra "\"Wh—where are we?\""
    ra "\"O—onde a gente tá?\""

# game/Carl-Mansion2.rpy:240
translate ptbr mansion2_d332a883:

    # "It's a good question and now with the excitement over I take the opportunity to look around as well."
    "É uma boa pergunta e, agora que a agitação passou, aproveito para dar uma olhada ao redor também."

# game/Carl-Mansion2.rpy:241
translate ptbr mansion2_977fe725:

    # "Everything is wooden; the walls, floor, ceiling."
    "Tudo é de madeira; as paredes, o chão, o teto."

# game/Carl-Mansion2.rpy:242
translate ptbr mansion2_139237f4:

    # "There's a large rug on the floor covered in colorful patterns and shapes."
    "Há um tapete grande no chão coberto de padrões e formas coloridas."

# game/Carl-Mansion2.rpy:243
translate ptbr mansion2_fd4db3ca:

    # "It reminds me of the art projects we'd do in elementary school when learning about the Natives."
    "Isso me lembra os projetos de artes que fazíamos na escola primária ao aprender sobre os indígenas."

# game/Carl-Mansion2.rpy:244
translate ptbr mansion2_14769c0a:

    # "There's a big stone fireplace and two rug-covered chairs in front of it."
    "Há uma grande lareira de pedra e duas cadeiras cobertas de tapetes na frente dela."

# game/Carl-Mansion2.rpy:245
translate ptbr mansion2_0c3984a1:

    # "Jenna gingerly shuts the wardrobe."
    "Jenna fecha o guarda-roupa com cuidado."

# game/Carl-Mansion2.rpy:247
translate ptbr mansion2_5f02bbfa:

    # j "\"So...a log cabin.\""
    j "\"Então... uma cabana de madeira.\""

# game/Carl-Mansion2.rpy:248
translate ptbr mansion2_cd558c54:

    # c "\"Does everyone remember where we were before?\""
    c "\"Todo mundo se lembra de onde a gente estava antes?\""

# game/Carl-Mansion2.rpy:249
translate ptbr mansion2_af73a4b7:

    # m "\"Yeah, that mansion place...\""
    m "\"Sim, aquela mansão...\""

# game/Carl-Mansion2.rpy:250
translate ptbr mansion2_3148f05c:

    # ra "\"So we're still stuck in this...dimension, thing.\""
    ra "\"Então ainda estamos presos nessa... coisa de dimensão.\""

# game/Carl-Mansion2.rpy:251
translate ptbr mansion2_caa6dc46:

    # "I sigh, rubbing my face with one hand while I lean against Carl with the other."
    "Suspiro, esfregando o rosto com uma mão enquanto me apoio no Carl com a outra."

# game/Carl-Mansion2.rpy:253
translate ptbr mansion2_ce5e517e:

    # "I'd long ago given up on trying to figure out exactly what the hell is going on."
    "Já faz muito tempo que desisti de tentar descobrir exatamente o que diabos está acontecendo."

# game/Carl-Mansion2.rpy:254
translate ptbr mansion2_78264e67:

    # "Like Carl said earlier; we just have to keep moving and hope we get out of here."
    "Como o Carl disse antes: só temos que continuar avançando e torcer para sair daqui."

# game/Carl-Mansion2.rpy:256
translate ptbr mansion2_6cd3a7b0:

    # ra "\"What's that sound?\""
    ra "\"Que som é esse?\""

# game/Carl-Mansion2.rpy:257
translate ptbr mansion2_ce814e79:

    # "The drumming that I had thought was coming from within my head has started up again."
    "A batida que eu achava que vinha de dentro da minha cabeça começou de novo."

# game/Carl-Mansion2.rpy:258
translate ptbr mansion2_14b186b8:

    # c "\"Drums?\""
    c "\"Tambores?\""

# game/Carl-Mansion2.rpy:259
translate ptbr mansion2_70a38dd2:

    # "The husky moves towards the wall which consists of several logs stacked horizontally on top of each other."
    "O husky se move em direção à parede, que consiste em várias toras empilhadas horizontalmente umas sobre as outras."

# game/Carl-Mansion2.rpy:260
translate ptbr mansion2_f328f8dd:

    # ra "\"I can't see anything...the cracks are filled in with stuff.\""
    ra "\"Não consigo ver nada... as frestas estão preenchidas com alguma coisa.\""

# game/Carl-Mansion2.rpy:261
translate ptbr mansion2_e29b4fe6:

    # "I look around again, this time more carefully."
    "Olho ao redor de novo, desta vez com mais cuidado."

# game/Carl-Mansion2.rpy:262
translate ptbr mansion2_d38fc1d5:

    # "Right in front of me is a large, log door, not unlike the one we initially came through."
    "Bem na minha frente há uma grande porta de toras, não muito diferente daquela pela qual entramos no início."

# game/Carl-Mansion2.rpy:263
translate ptbr mansion2_15573a30:

    # "On my left side, separated by the stairs, is what looks like the kitchen side of the room."
    "À minha esquerda, separada pela escada, fica o que parece ser o lado da cozinha."

# game/Carl-Mansion2.rpy:264
translate ptbr mansion2_15c5fa33:

    # "In it, there's a small table with two chairs on either side."
    "Nela, há uma mesa pequena com duas cadeiras em cada lado."

# game/Carl-Mansion2.rpy:265
translate ptbr mansion2_cb94fa1a:

    # "There's also a big, black, wood-burning stove next to a few shelves which are full of pots and pans."
    "Há também um fogão a lenha grande e preto ao lado de algumas prateleiras cheias de panelas e frigideiras."

# game/Carl-Mansion2.rpy:266
translate ptbr mansion2_b2c49de1:

    # "Various tools and furniture clutter up the rooms."
    "Vários utensílios e móveis entulham os cômodos."

# game/Carl-Mansion2.rpy:267
translate ptbr mansion2_99e4cce6:

    # "And there's a window."
    "E tem uma janela."

# game/Carl-Mansion2.rpy:268
translate ptbr mansion2_f22d0a78:

    # "I point it out to Carl."
    "Aponto ela para o Carl."

# game/Carl-Mansion2.rpy:269
translate ptbr mansion2_fc3438ba:

    # m "\"Look, let's try and see out through there.\""
    m "\"Olha, vamos tentar ver lá fora por ali.\""

# game/Carl-Mansion2.rpy:270
translate ptbr mansion2_f849f429:

    # "Carl pulls me into the familiar position on his back before clopping over to the window, the sounds a bit louder with my added weight."
    "Carl me puxa para a posição familiar em suas costas antes de andar até a janela, com os passos soando um pouco mais altos com o meu peso adicionais."

# game/Carl-Mansion2.rpy:271
translate ptbr mansion2_2b74f0fa:

    # "Jenna and Raven follow behind."
    "Jenna e Raven vêm logo atrás."

# game/Carl-Mansion2.rpy:275
translate ptbr mansion2_84f78a94:

    # "There's a ledge next to the window, thankfully, and Carl lets me sit on it."
    "Há um parapeito ao lado da janela, felizmente, e Carl me deixa sentar nele."

# game/Carl-Mansion2.rpy:276
translate ptbr mansion2_22408831:

    # "I turn to look out the window while the others crowd around me, resting their hands on the wooden bench."
    "Eu me viro para olhar pela janela enquanto os outros se aglomeram ao meu redor, apoiando as mãos no banco de madeira."

# game/Carl-Mansion2.rpy:278
translate ptbr mansion2_07c3e5bc:

    # "The first thing I notice is a flickering light in the distance, about a hundred yards away."
    "A primeira coisa que noto é uma luz tremeluzente à distância, a cerca de cem metros de distância."

# game/Carl-Mansion2.rpy:279
translate ptbr mansion2_2871c457:

    # "It casts out across the ground around it; shadows from rocks and bushes dance about with the movement of the illumination."
    "Ela se projeta pelo chão ao redor; as sombras das rochas e arbustos dançam com o movimento da iluminação."

# game/Carl-Mansion2.rpy:280
translate ptbr mansion2_6ef855a4:

    # "It's definitely a fire. A large one, probably a bonfire."
    "Com certeza é fogo. Um fogo grande, provavelmente uma fogueira."

# game/Carl-Mansion2.rpy:281
translate ptbr mansion2_417897af:

    # "The blackness around the fire is unnatural, though, just like what I saw through the windows in the mansion."
    "A escuridão ao redor do fogo não é natural, no entanto, exatamente como a que vi pelas janelas da mansão."

# game/Carl-Mansion2.rpy:282
translate ptbr mansion2_cc264982:

    # "It's inky and thick, and has the oppressive air of almost being alive."
    "É espessa e preta como tinta, e tem um ar opressivo de quase estar viva."

# game/Carl-Mansion2.rpy:283
translate ptbr mansion2_212e086d:

    # "No other light comes from what I presume to be the sky, that fire being the only signal that anything exists outside the cabin."
    "Nenhuma outra luz vem do que presumo ser o céu, sendo aquela fogueira o único sinal de que existe algo fora da cabana."

# game/Carl-Mansion2.rpy:284
translate ptbr mansion2_80a631f0:

    # ra "\"A fire...\""
    ra "\"Fogo...\""

# game/Carl-Mansion2.rpy:285
translate ptbr mansion2_7739ade2:

    # "Raven says redundantly."
    "Raven diz, redundantemente."

# game/Carl-Mansion2.rpy:286
translate ptbr mansion2_2cfc75c5:

    # j "\"The drumming, it's coming from it.\""
    j "\"As batidas de tambor, estão vindo de lá.\""

# game/Carl-Mansion2.rpy:287
translate ptbr mansion2_d4b435ab:

    # "Carl reaches out, but his hand looks to immediately press against something."
    "Carl estende a mão, mas ela parece pressionar algo imediatamente."

# game/Carl-Mansion2.rpy:288
translate ptbr mansion2_cd44b2e6:

    # "I reach out too, and feel a solid flat surface where a pane of glass might be set up, but it's clear there's nothing visible there."
    "Eu me estico também e sinto uma superfície plana e sólida onde deveria haver um vidro, mas é claro que não há nada visível ali."

# game/Carl-Mansion2.rpy:289
translate ptbr mansion2_2f278af5:

    # "Observe. Accept. Move on."
    "Observar. Aceitar. Seguir em frente."

# game/Carl-Mansion2.rpy:290
translate ptbr mansion2_a791b9e2:

    # j "\"Hey, look.\""
    j "\"Ei, olhem.\""

# game/Carl-Mansion2.rpy:291
translate ptbr mansion2_1a388628:

    # "I look up in time to see something dark flash across the fire."
    "Olho para cima a tempo de ver algo escuro passar rápido diante da fogueira."

# game/Carl-Mansion2.rpy:292
translate ptbr mansion2_0bb51299:

    # "It disappears into the darkness to the right of the flame, though."
    "Mas some na escuridão à direita das chamas."

# game/Carl-Mansion2.rpy:293
translate ptbr mansion2_ec5c1a9d:

    # ra "\"What was that?\""
    ra "\"O que foi aquilo?\""

# game/Carl-Mansion2.rpy:294
translate ptbr mansion2_1c55e517:

    # c "\"Maybe it was a—a tumbleweed, or something?\""
    c "\"Talvez fosse... uma daquelas plantas rolantes, ou algo assim?\""

# game/Carl-Mansion2.rpy:295
translate ptbr mansion2_be561e08:

    # j "\"No. It was jumping, whatever it was.\""
    j "\"Não. Estava pulando, o que quer que fosse.\""

# game/Carl-Mansion2.rpy:296
translate ptbr mansion2_b04f04c3:

    # "I feel a prickling along my neck and now I'm not really into the idea of just staring out into the darkness."
    "Sinto um arrepio na nuca e agora não estou muito a fim de ficar apenas olhando para a escuridão."

# game/Carl-Mansion2.rpy:297
translate ptbr mansion2_40c3a87d:

    # "But then it happens again, and I see what Jenna's saying."
    "Mas então acontece de novo, e vejo o que a Jenna está dizendo."

# game/Carl-Mansion2.rpy:298
translate ptbr mansion2_fb2aa7f6:

    # "The dark shape starts at the left side of the fire before passing in front of it."
    "A forma escura começa no lado esquerdo do fogo antes de passar na frente dele."

# game/Carl-Mansion2.rpy:299
translate ptbr mansion2_46234f0c:

    # "I get a brief impression of a tail and ears, legs and arms pumping as if jogging in place."
    "Tenho uma breve impressão de uma cauda e orelhas, pernas e braços se movendo como se estivesse correndo no mesmo lugar."

# game/Carl-Mansion2.rpy:300
translate ptbr mansion2_96d18989:

    # "It moves past the flames, then disappears into the darkness again."
    "Ela passa pelas chamas e depois desaparece na escuridão novamente."

# game/Carl-Mansion2.rpy:302
translate ptbr mansion2_8f49a510:

    # m "\"Something's out there...\""
    m "\"Tem alguma coisa lá fora...\""

# game/Carl-Mansion2.rpy:303
translate ptbr mansion2_27faecbd:

    # "We continue to watch, but the drumbeat dies down and, after about a minute, it's clear nothing's moving around out there anymore."
    "Continuamos observando, mas as batidas do tambor diminuem e, depois de cerca de um minuto, fica claro que nada mais está se movendo lá fora."

# game/Carl-Mansion2.rpy:304
translate ptbr mansion2_ec5c1a9d_1:

    # ra "\"What was that?\""
    ra "\"O que foi aquilo?\""

# game/Carl-Mansion2.rpy:305
translate ptbr mansion2_f6a220bd:

    # c "\"Well, uh...\""
    c "\"Bem, err...\""

# game/Carl-Mansion2.rpy:306
translate ptbr mansion2_8941e9d3:

    # "Carl glances at Jenna."
    "Carl olha de relance para a Jenna."

# game/Carl-Mansion2.rpy:307
translate ptbr mansion2_aeffdc13:

    # c "\"The drumbeat sounds kind of native...don't you think?\""
    c "\"As batidas de tambor parecem meio nativas... não acha?\""

# game/Carl-Mansion2.rpy:308
translate ptbr mansion2_ad5f2dd9:

    # "He's clearly waiting for Jenna to confirm."
    "Ele claramente espera que a Jenna confirme."

# game/Carl-Mansion2.rpy:309
translate ptbr mansion2_c7105abf:

    # j "\"Maybe.\""
    j "\"Talvez.\""

# game/Carl-Mansion2.rpy:310
translate ptbr mansion2_b0d4cb57:

    # "There's an awkward silence before Carl coughs."
    "Há um silêncio constrangedor antes de o Carl tossir."

# game/Carl-Mansion2.rpy:312
translate ptbr mansion2_6ffa98bd:

    # c "\"Well, let's think. We weren't able to get out of the mansion until we found that letter, right?\""
    c "\"Bem, vamos pensar. A gente não conseguiu sair da mansão até encontrar aquela carta, certo?\""

# game/Carl-Mansion2.rpy:313
translate ptbr mansion2_6cc60c45:

    # "He looks at me."
    "Ele olha para mim."

# game/Carl-Mansion2.rpy:314
translate ptbr mansion2_c806ebc0:

    # m "\"Yeah.\""
    m "\"É.\""

# game/Carl-Mansion2.rpy:315
translate ptbr mansion2_bd087e1a:

    # "I respond automatically."
    "Respondo automaticamente."

# game/Carl-Mansion2.rpy:316
translate ptbr mansion2_dc800941:

    # c "\"Well, if that's the case then maybe we have to find something in here, right?\""
    c "\"Bem, se esse for o caso, então talvez a gente tenha que encontrar algo aqui dentro, certo?\""

# game/Carl-Mansion2.rpy:317
translate ptbr mansion2_e09b2cb6:

    # ra "\"I guess that would make sense...but what are we supposed to find, another letter?\""
    ra "\"Acho que faria sentido... mas o que a gente deveria encontrar, outra carta?\""

# game/Carl-Mansion2.rpy:318
translate ptbr mansion2_8361ff05:

    # m "\"Yeah, didn't—didn't someone tell you about finding something, that it would open the door?\""
    m "\"Sim, alguém não... não te falou sobre encontrar algo, que isso abriria a porta?\""

# game/Carl-Mansion2.rpy:319
translate ptbr mansion2_176a7b90:

    # c "\"Yeah, and I think it makes sense that whoever set this up would do it in the same way, right?\""
    c "\"Sim, e acho que faz sentido que quem quer que tenha armado isso faria do mesmo jeito, né?\""

# game/Carl-Mansion2.rpy:320
translate ptbr mansion2_be406262:

    # "I sigh and stop staring at the window, my back sore from the twisting motion."
    "Suspiro e paro de encarar a janela, minhas costas doloridas pela posição torcida."

# game/Carl-Mansion2.rpy:321
translate ptbr mansion2_6349e1a3:

    # "I sit straight up on the bench and look back into the cabin."
    "Sento ereto no banco e olho de volta para dentro da cabana."

# game/Carl-Mansion2.rpy:322
translate ptbr mansion2_b501341d:

    # m "\"Well, if we're supposed to find another letter there's a bunch of places to hide it.\""
    m "\"Bem, se a gente tem que encontrar outra carta, tem um monte de lugares para esconder.\""

# game/Carl-Mansion2.rpy:324
translate ptbr mansion2_89cf36c6:

    # j "\"Maybe we should try the door first?\""
    j "\"Talvez a gente devesse tentar a porta primeiro?\""

# game/Carl-Mansion2.rpy:325
translate ptbr mansion2_786f1201:

    # "Jenna walks over to the door and looks it up and down before reaching out to slide back a rusty bolt."
    "Jenna caminha até a porta e a examina de cima a baixo antes de esticar o braço para abrir uma tranca enferrujada."

# game/Carl-Mansion2.rpy:326
translate ptbr mansion2_565e7532:

    # "To my surprise, it moves with only a little resistance."
    "Para minha surpresa, ela se move com pouca resistência."

# game/Carl-Mansion2.rpy:328
translate ptbr mansion2_c6b45a93:

    # ra "\"A—are we sure we wanna go out there? I mean, we don't know who that is running around.\""
    ra "\"A—a gente tem certeza de que quer sair? Quero dizer, não sabemos quem é que tá correndo lá fora.\""

# game/Carl-Mansion2.rpy:329
translate ptbr mansion2_cea8d9b7:

    # "Jenna hesitates, then heaves back on the door...but it doesn't budge, not even an inch."
    "Jenna hesita, depois puxa a porta com força... mas ela não se move, nem um centímetro."

# game/Carl-Mansion2.rpy:330
translate ptbr mansion2_08eba051:

    # "Jenna sighs."
    "Jenna suspira."

# game/Carl-Mansion2.rpy:331
translate ptbr mansion2_dea32763:

    # "Raven bounds up next to Jenna before enthusiastically yanking back on the handle as well."
    "Raven corre para o lado da Jenna antes de puxar entusiasticamente a maçaneta também."

# game/Carl-Mansion2.rpy:332
translate ptbr mansion2_f8abc2c5:

    # "Again, the door holds fast."
    "Mais uma vez, a porta não cede."

# game/Carl-Mansion2.rpy:333
translate ptbr mansion2_bc7b8a95:

    # c "\"Of course.\""
    c "\"Claro.\""

# game/Carl-Mansion2.rpy:334
translate ptbr mansion2_db8abdfe:

    # "Jenna stares at the door a moment before turning to us."
    "Jenna encara a porta por um momento antes de se virar para nós."

# game/Carl-Mansion2.rpy:336
translate ptbr mansion2_6878ae63:

    # j "\"Let's take a look around upstairs. If we're supposed to find something then we should start from top to bottom.\""
    j "\"Vamos dar uma olhada lá em cima. Se a gente tem que achar alguma coisa, devíamos começar de cima para baixo.\""

# game/Carl-Mansion2.rpy:338
translate ptbr mansion2_81e2b450:

    # ra "\"Agreed!\""
    ra "\"De acordo!\""

# game/Carl-Mansion2.rpy:340
translate ptbr mansion2_9513a46f:

    # "Carl bends down to pick me up, but I rest a paw on his shoulder."
    "Carl se abaixa para me pegar, mas coloco a mão no ombro dele."

# game/Carl-Mansion2.rpy:341
translate ptbr mansion2_bc6efb63:

    # m "\"Wait, I don't want you to have to drag me everywhere, let alone up and down the stairs.\""
    m "\"Espera, não quero que você precise me arrastar para todo canto, muito menos escada acima e abaixo.\""

# game/Carl-Mansion2.rpy:342
translate ptbr mansion2_320330ba:

    # "He stops mid-stoop, his face level with mine as he looks at me."
    "Ele para no meio do movimento, com o rosto na altura do meu enquanto me olha."

# game/Carl-Mansion2.rpy:343
translate ptbr mansion2_1341f0ba:

    # c "\"You sure? I don't really wanna leave you alone down here.\""
    c "\"Tem certeza? Não quero muito te deixar sozinho aqui embaixo.\""

# game/Carl-Mansion2.rpy:345
translate ptbr mansion2_6f701938:

    # "As I look back at him I can't help but note the differences that I'd noticed earlier."
    "Ao olhar de volta para ele, não posso deixar de notar as diferenças que tinha percebido antes."

# game/Carl-Mansion2.rpy:346
translate ptbr mansion2_4307f570:

    # "His face has harder lines, his fur duller, eyes somehow deeper...wiser?"
    "O rosto dele tem linhas mais marcadas, a pelagem mais opaca, os olhos de alguma forma mais profundos... mais sábios?"

# game/Carl-Mansion2.rpy:347
translate ptbr mansion2_9c2bfc60:

    # c "\"You alright?\""
    c "\"Você tá bem?\""

# game/Carl-Mansion2.rpy:348
translate ptbr mansion2_9830d9f9:

    # "I break out of my trance and blink."
    "Saio do meu transe e pisco."

# game/Carl-Mansion2.rpy:349
translate ptbr mansion2_f93c4cac:

    # m "\"Y—yeah...yeah, I'll just stay down here and look around where I can.\""
    m "\"É—é... sim, eu vou só ficar aqui embaixo e procurar onde der.\""

# game/Carl-Mansion2.rpy:353
translate ptbr mansion2_abc3f0ff:

    # "Jenna and Raven are already making their way up the stairs, Raven going on about how his family used to have their own log cabin."
    "Jenna e Raven já estão subindo a escada, com o Raven falando sem parar sobre como a família dele costumava ter a própria cabana de madeira."

# game/Carl-Mansion2.rpy:355
translate ptbr mansion2_9997dd17:

    # c "\"Alright, but shout if, uh, if you need anything.\""
    c "\"Tudo bem, mas grita se, err, se precisar de alguma coisa.\""

# game/Carl-Mansion2.rpy:356
translate ptbr mansion2_436795dd:

    # "I smile. At least I feel like some parts of Carl are still familiar."
    "Eu sorrio. Pelo menos sinto que algumas partes do Carl ainda são familiares."

# game/Carl-Mansion2.rpy:358
translate ptbr mansion2_20717b95:

    # "After the ram heads up the stairs, I lean back on my little bench, letting my head tilt back as I close my eyes."
    "Depois que o carneiro sobe a escada, eu me encosto no meu banquinho, deixando a cabeça pender para trás enquanto fecho os olhos."

# game/Carl-Mansion2.rpy:359
translate ptbr mansion2_e85c0164:

    # "Even in this new environment everything is still feeling surreal."
    "Mesmo neste novo ambiente, tudo continua parecendo surreal."

# game/Carl-Mansion2.rpy:360
translate ptbr mansion2_f346349b:

    # "I've come to welcome the feeling, though."
    "No entanto, comecei a acolher essa sensação."

# game/Carl-Mansion2.rpy:361
translate ptbr mansion2_d9ce9378:

    # "It's a nice little barrier to everything that's happening right now."
    "É uma boa barreira contra tudo o que está acontecendo agora."

# game/Carl-Mansion2.rpy:362
translate ptbr mansion2_c4735501:

    # "In some ways I can still pretend that this is a dream."
    "De certa forma, ainda consigo fingir que isso é um sonho."

# game/Carl-Mansion2.rpy:363
translate ptbr mansion2_045ee1b3:

    # "Hell, even now I'm thinking it's a dream; that I'm somehow stuck in one of my paralyses."
    "Porra, até agora estou achando que é um sonho; que de alguma forma estou preso em uma das minhas paralisias."

# game/Carl-Mansion2.rpy:364
translate ptbr mansion2_3b1c8bad:

    # "Maybe I'm in a hospital right now and they're trying to figure out how to pull me out of it..."
    "Talvez eu esteja em um hospital agora e eles estejam tentando descobrir como me tirar disso..."

# game/Carl-Mansion2.rpy:366
translate ptbr mansion2_12168c9e:

    # "That thought has me feeling like I'm being watched and the fur prickles around my neck."
    "Esse pensamento me faz sentir como se estivesse sendo observado, e os pelos da minha nuca se arrepiam."

# game/Carl-Mansion2.rpy:367
translate ptbr mansion2_80d62a75:

    # "I guess it would be kind of awkward if all of those doctors are watching me right now...maybe Carl and Jenna are there too, and Leo, and Flynn, and TJ..."
    "Acho que seria meio estranho se todos aqueles médicos estivessem me assistindo agora... talvez o Carl e a Jenna estivessem lá também, e o Leo, o Flynn, e o TJ..."

# game/Carl-Mansion2.rpy:368
translate ptbr mansion2_10555b56:

    # "The feeling gets stronger, so I turn back around to look out the window."
    "A sensação fica mais forte, então me viro de volta para olhar pela janela."

# game/Carl-Mansion2.rpy:369
translate ptbr mansion2_e96e2dfc:

    # "It's still silent, and the lonely little flame in the distance continues to flicker around the rocks and sage brush."
    "Ainda está tudo em silêncio, e a chaminha solitária ao longe continua a tremeluzir ao redor das pedras e da vegetação rasteira."

# game/Carl-Mansion2.rpy:370
translate ptbr mansion2_7577cc6a:

    # "It makes me wonder how endless this world is."
    "Isso me faz pensar no quão infinito é este mundo."

# game/Carl-Mansion2.rpy:371
translate ptbr mansion2_30567d81:

    # "If we're in some type of ghost dimension being manipulated by what are basically ghost gods, then will this whole ordeal be never-ending?"
    "Se estamos em algum tipo de dimensão fantasma sendo manipulados por o que são basicamente deuses fantasmas, então toda essa provação será interminável?"

# game/Carl-Mansion2.rpy:372
translate ptbr mansion2_a4e7ecba:

    # "The thought twists my stomach so I stop thinking about it."
    "O pensamento embrulha meu estômago, então paro de pensar nisso."

# game/Carl-Mansion2.rpy:373
translate ptbr mansion2_675df49b:

    # "I turn back around and force my eyes to start scanning the kitchen from top to bottom, looking for something, anything that might stand out."
    "Eu me viro de volta e forço meus olhos a começarem a escanear a cozinha de cima a baixo, procurando algo, qualquer coisa que possa se destacar."

# game/Carl-Mansion2.rpy:374
translate ptbr mansion2_717f96d5:

    # "I assume I'm looking for a letter..."
    "Presumo que esteja procurando uma carta..."

# game/Carl-Mansion2.rpy:375
translate ptbr mansion2_11448e26:

    # "...but again, if the rules are limitless in this world, then there's no telling what it might be that we're supposed to find next."
    "...mas, novamente, se as regras são ilimitadas neste mundo, não dá para saber o que deveríamos encontrar em seguida."

# game/Carl-Mansion2.rpy:376
translate ptbr mansion2_b6ea9a15:

    # "I think about vocally asking James, or whoever the hell it is, for some help."
    "Penso em pedir ajuda em voz alta para o James, ou quem quer que seja."

# game/Carl-Mansion2.rpy:377
translate ptbr mansion2_aca9d3d6:

    # "Maybe some kind of hint at least, but there's no way I'm gonna do that without the others with me."
    "Pelo menos algum tipo de dica, mas não tem a menor chance de eu fazer isso sem os outros comigo."

# game/Carl-Mansion2.rpy:378
translate ptbr mansion2_b6bf9606:

    # "I'm thinking about pushing off the bench to start limping around the kitchen when a small scratching sound catches my attention."
    "Penso em me levantar do banco para começar a mancar pela cozinha quando um pequeno som de arranhado chama minha atenção."

# game/Carl-Mansion2.rpy:380
translate ptbr mansion2_a7a9db40:

    # "I hold still, then lean back, tilting my ear towards the sound."
    "Fico imóvel, depois me inclino para trás, inclinando a orelha em direção ao som."

# game/Carl-Mansion2.rpy:381
translate ptbr mansion2_18131c58:

    # "It's muffled, and a bit distant, but it's coming from directly to my left."
    "É abafado e um pouco distante, mas vem diretamente da minha esquerda."

# game/Carl-Mansion2.rpy:382
translate ptbr mansion2_ceb77fd1:

    # "Is it happening on the outside of the cabin?"
    "Está acontecendo do lado de fora da cabana?"

# game/Carl-Mansion2.rpy:383
translate ptbr mansion2_9dca1975:

    # "My fur prickles and I think about calling Carl."
    "Minha pelagem se arrepia e penso em chamar o Carl."

# game/Carl-Mansion2.rpy:384
translate ptbr mansion2_31e280a9:

    # "I can hear the three of them stomping around, talking to each other in muffled voices from upstairs."
    "Consigo ouvir os três andando de um lado para o outro, conversando em vozes abafadas lá em cima."

# game/Carl-Mansion2.rpy:385
translate ptbr mansion2_993b5b71:

    # "I turn around again, this time a little more tentatively."
    "Eu me viro de novo, desta vez um pouco mais hesitante."

# game/Carl-Mansion2.rpy:386
translate ptbr mansion2_9cb3ca1b:

    # "The dancing bonfire continues to glow quietly, no other movement aside from the shadows."
    "A fogueira dançante continua a brilhar silenciosamente, sem nenhum outro movimento além das sombras."

# game/Carl-Mansion2.rpy:387
translate ptbr mansion2_bacfa494:

    # "This time a rustling sound comes from that same spot and I instinctively turn my eyes in its direction."
    "Desta vez, um som de farfalhar vem do mesmo ponto e instintivamente viro meus olhos na direção dele."

# game/Carl-Mansion2.rpy:388
translate ptbr mansion2_74dba477:

    # m "\"Carl?\""
    m "\"Carl?\""

# game/Carl-Mansion2.rpy:389
translate ptbr mansion2_4809d357:

    # "I raise my voice only a little bit, but their conversation carries on upstairs as if I hadn't said anything."
    "Subo o tom de voz só um pouquinho, mas a conversa deles continua lá em cima como se eu não tivesse dito nada."

# game/Carl-Mansion2.rpy:390
translate ptbr mansion2_e2423fcd:

    # "I look up at the ceiling, then back out the window."
    "Olho para o teto, depois de volta para a janela."

# game/Carl-Mansion2.rpy:391
translate ptbr mansion2_91164019:

    # "The rustling sound continues, this time in earnest, as if something's twisting around in the brush."
    "O farfalhar continua, desta vez para valer, como se algo estivesse se contorcendo nos arbustos."

# game/Carl-Mansion2.rpy:392
translate ptbr mansion2_dc196df3:

    # "It's coming from just out of view of the window, right at the base of the house."
    "Vem de logo fora do campo de visão da janela, bem na base da casa."

# game/Carl-Mansion2.rpy:393
translate ptbr mansion2_84079f86:

    # "I hold my breath and lean forward, stretching my neck up to get a better angle and peer down into the darkness."
    "Prendo a respirar e me inclino para frente, esticando o pescoço para conseguir um ângulo melhor e espiar a escuridão lá embaixo."

# game/Carl-Mansion2.rpy:394
translate ptbr mansion2_79941755:

    # "It's really too dark to see much, or at least that's what I was thinking."
    "Está escuro demais para ver muita coisa, ou pelo menos era o que eu achava."

# game/Carl-Mansion2.rpy:395
translate ptbr mansion2_c15537d3:

    # "Almost as if it has it's own glow, a bright, white face stares back at me from the blackness."
    "Quase como se tivesse seu próprio brilho, um rosto branco e brilhante me encara de volta da escuridão."

# game/Carl-Mansion2.rpy:396
translate ptbr mansion2_88745389:

    # "My mind blanks and my body seizes up."
    "Minha mente fica em branco e meu corpo paralisa."

# game/Carl-Mansion2.rpy:397
translate ptbr mansion2_320d11df:

    # "And just like that I'm in a paralysis, forced to stare down at the white face, the black eyes..."
    "E, do nada, fico paralisado, forçado a encarar o rosto branco, os olhos pretos..."

# game/Carl-Mansion2.rpy:398
translate ptbr mansion2_21744cbe:

    # "It's as if the thing is holding me with it's gaze, but as it does its features become more definable."
    "E como se a coisa estivesse me prendendo com o olhar, mas, à medida que faz isso, seus traços se tornam mais definidos."

# game/Carl-Mansion2.rpy:399
translate ptbr mansion2_854e4968:

    # "I see tall ears, a long, pointy muzzle, a band of some type across the thing's forehead..."
    "Vejo orelhas compridas, um focinho longo e pontudo, uma faixa de algum tipo na testa da coisa..."

# game/Carl-Mansion2.rpy:400
translate ptbr mansion2_4c6fa7ad:

    # "???" "\"Stop. It.\""
    "???" "\"Parem. Com. Isso.\""

# game/Carl-Mansion2.rpy:401
translate ptbr mansion2_60a457da:

    # "Something says it very deliberately through their teeth right in my ear."
    "Alguém diz isso muito deliberadamente entre os dentes, bem no meu ouvido."

# game/Carl-Mansion2.rpy:402
translate ptbr mansion2_f09a7945:

    # "At the same time the face flickers and fuzzes, like a TV picture with bad reception."
    "Ao mesmo tempo, o rosto oscila e chia, como uma imagem de TV com sinal ruim."

# game/Carl-Mansion2.rpy:403
translate ptbr mansion2_70c660f1:

    # "The head twitches and shifts, then the muzzle opens and—"
    "A cabeça se contrai e muda de posição, então o focinho se abre e—"

# game/Carl-Mansion2.rpy:405
translate ptbr mansion2_eaf32445:

    # "The cackle that comes forth is all at once terrifying and familiar and at that moment I'm released."
    "A gargalhada que ecoa é ao mesmo tempo aterrorizante e familiar e, naquele momento, sou libertado."

# game/Carl-Mansion2.rpy:407
translate ptbr mansion2_eac1175a:

    # "My vocal chords start working at the same time and I let out a scream as I fall backwards."
    "Minhas cordas vocais começam a funcionar na mesma hora e solto um grito enquanto caio para trás."

# game/Carl-Mansion2.rpy:410
translate ptbr mansion2_ffd923be:

    # "I land on the wooden floor with a loud thud that shakes the pots and pans on the shelves."
    "Caio no chão de madeira com um baque surdo que faz tremer as panelas nas prateleiras."

# game/Carl-Mansion2.rpy:411
translate ptbr mansion2_53d3f4b1:

    # "The room spins and I feel like I'm coming right out of a dream, like I'd been sleeping for ages."
    "A sala gira e sinto como se estivesse saindo de um sonho, como se estivesse dormindo há eras."

# game/Carl-Mansion2.rpy:416
translate ptbr mansion2_05d74fdd:

    # "The next thing I know is that I'm surrounded by the three faces of my friends, all looking down at me."
    "A próxima coisa que percebo é que estou cercado pelos três rostos dos meus amigos, todos me olhando."

# game/Carl-Mansion2.rpy:417
translate ptbr mansion2_95c97bbf:

    # "Carl grabs me under the arms and pulls me into a sitting position, his face worried, but there's something else, too...anger?"
    "Carl me segura por baixo dos braços e me puxa para a posição sentada, o rosto preocupado, mas há algo mais também... raiva?"

# game/Carl-Mansion2.rpy:418
translate ptbr mansion2_c04b7a15:

    # c "\"What happened!?\""
    c "\"O que aconteceu!?\""

# game/Carl-Mansion2.rpy:419
translate ptbr mansion2_7adf9d65:

    # "I'm startled by his abruptness and I stammer through an answer."
    "Fico assustado com a brusquidão dele e gaguejo uma resposta."

# game/Carl-Mansion2.rpy:420
translate ptbr mansion2_ce402156:

    # m "\"I—I, it was a face...out the window.\""
    m "\"Eu—eu, era um rosto... do lado de fora da janela.\""

# game/Carl-Mansion2.rpy:421
translate ptbr mansion2_18247fdf:

    # c "\"What did it say!?\""
    c "\"O que ele disse!?\""

# game/Carl-Mansion2.rpy:422
translate ptbr mansion2_045bb4bc:

    # ra "\"Carl...what are you doing?\""
    ra "\"Carl... o que você tá fazendo?\""

# game/Carl-Mansion2.rpy:423
translate ptbr mansion2_10a31fb3:

    # "Raven reproaches the ram gently, his ears falling."
    "Raven repreende o carneiro de leve, com as orelhas caídas."

# game/Carl-Mansion2.rpy:424
translate ptbr mansion2_52432c14:

    # "Carl glances at the husky, then at Jenna who's been silent so far, then back at me, slowly letting go."
    "Carl olha de relance para o husky, depois para a Jenna, que esteve em silêncio até agora, e depois de volta para mi, me soltando devagar."

# game/Carl-Mansion2.rpy:426
translate ptbr mansion2_850b3f21:

    # c "\"S—sorry, I was just worried about you. What did you see? Did it say anything?\""
    c "\"Des—desculpa, eu só estava preocupado com você. O que você viu? Ele disse alguma coisa?\""

# game/Carl-Mansion2.rpy:427
translate ptbr mansion2_27b55f89:

    # "It takes me a moment to find my voice."
    "Levo um momento para recuperar a voz."

# game/Carl-Mansion2.rpy:428
translate ptbr mansion2_03150001:

    # m "\"Uh, no, no it didn't say anything, just laughed.\""
    m "\"Err, não, não, ele não disse nada, só riu.\""

# game/Carl-Mansion2.rpy:429
translate ptbr mansion2_7a365e2d:

    # c "\"What did it look like?\""
    c "\"Como ele era?\""

# game/Carl-Mansion2.rpy:430
translate ptbr mansion2_a4251a35:

    # m "\"A—a fox, maybe? Had a band over his head.\""
    m "\"Uma—uma raposa, talvez? Tinha uma faixa na cabeça.\""

# game/Carl-Mansion2.rpy:431
translate ptbr mansion2_3e89ae94:

    # "Carl's eyes narrow."
    "Os olhos do Carl se estreitam."

# game/Carl-Mansion2.rpy:433
translate ptbr mansion2_4b9d3721:

    # ra "\"Hey, I found something!\""
    ra "\"Ei, achei uma coisa!\""

# game/Carl-Mansion2.rpy:434
translate ptbr mansion2_e87c9feb:

    # "We all look up at Raven as he holds up a white piece of paper."
    "Todos nós olhamos para o Raven enquanto ele ergue um pedaço de papel branco."

# game/Carl-Mansion2.rpy:435
translate ptbr mansion2_df015456:

    # c "\"What is that?\""
    c "\"O que é isso?\""

# game/Carl-Mansion2.rpy:436
translate ptbr mansion2_0cd432f8:

    # "Carl stands up, staring hard at the paper in Raven's hand."
    "Carl se levanta, encarando fixamente o papel na mão do Raven."

# game/Carl-Mansion2.rpy:437
translate ptbr mansion2_5e472f23:

    # ra "\"I dunno, looks like a photocopy of a newspaper...let's see.\""
    ra "\"Não sei, parece uma fotocópia de um jornal... deixa eu ver.\""

# game/Carl-Mansion2.rpy:438
translate ptbr mansion2_ed6d6713:

    # "Raven turns towards the candle sitting on the desk."
    "Raven se vira em direção à vela sobre a mesa."

# game/Carl-Mansion2.rpy:439
translate ptbr mansion2_216585cc:

    # "Jenna stands behind him."
    "Jenna fica atrás dele."

# game/Carl-Mansion2.rpy:440
translate ptbr mansion2_3f2c65a6:

    # j "\"Meseta boy missing after...\""
    j "\"Garoto de Meseta desaparecido após...\""

# game/Carl-Mansion2.rpy:445
translate ptbr mansion2_16ed1045:

    # ra "\"Whoa!\""
    ra "\"Eita!\""

# game/Carl-Mansion2.rpy:446
translate ptbr mansion2_35bb359e:

    # "Raven flinches back as the paper catches fire, illuminating the entire cabin room."
    "Raven recua quando o papel pega fogo, iluminando todo o cômodo da cabana."

# game/Carl-Mansion2.rpy:447
translate ptbr mansion2_1a823a7b:

    # "Our shadows dance across the log walls."
    "Nossas sombras dançam pelas paredes de tora."

# game/Carl-Mansion2.rpy:448
translate ptbr mansion2_ff1e6f70:

    # "The paper, which Raven had dropped, flutters to the floor, a tongue of angry flame eating it up completely before it hits the floor."
    "O papel, que o Raven tinha deixado cair, flutua até o chão, uma língua de fogo violenta devorando-o por completo antes de tocar o piso."

# game/Carl-Mansion2.rpy:450
translate ptbr mansion2_2058b0a1:

    # "We all stare at the smoldering flake of ash on the ground."
    "Todos nós encaramos o pedacinho de cinza fumegante no chão."

# game/Carl-Mansion2.rpy:453
translate ptbr mansion2_1ad020da:

    # c "\"Raven! Are you kidding me!?\""
    c "\"Raven! Você tá brincando comigo!?\""

# game/Carl-Mansion2.rpy:454
translate ptbr mansion2_d179fd04:

    # ra "\"Wha-I wasn't even that close to the candle!\""
    ra "\"O quê? Eu nem estava tão perto assim da vela!\""

# game/Carl-Mansion2.rpy:455
translate ptbr mansion2_a256c77a:

    # c "\"That might have been what we needed.\""
    c "\"Isso podia ser o que a gente precisava.\""

# game/Carl-Mansion2.rpy:456
translate ptbr mansion2_85f2172a:

    # ra "\"But I—\""
    ra "\"Mas eu—\""

# game/Carl-Mansion2.rpy:457
translate ptbr mansion2_03786b24:

    # "Raven stares at his hands, looking forlornly between them and the candle which seems to flicker innocently on the table."
    "Raven encara as próprias mãos, olhando desolado entre elas e a vela que parece tremeluzir inocentemente sobre a mesa."

# game/Carl-Mansion2.rpy:458
translate ptbr mansion2_1bbe6fc0:

    # "I rest my face in my hands."
    "Apoio meu rosto nas mãos."

# game/Carl-Mansion2.rpy:459
translate ptbr mansion2_a0b7bd6e:

    # m "\"Well, what do we do n—\""
    m "\"Bem, o que a gente faz ag—\""

# game/Carl-Mansion2.rpy:460
translate ptbr mansion2_23ba5927:

    # j "\"He wasn't near the candle.\""
    j "\"Ele não estava perto da vela.\""

# game/Carl-Mansion2.rpy:462
translate ptbr mansion2_6b9ceca7:

    # "I pull my head out of my hands, not because of what Jenna said, but because of the way she said it."
    "Tiro a cabeça das minhas mãos, não pelo que a Jenna disse, mas pela maneira como ela disse."

# game/Carl-Mansion2.rpy:464
translate ptbr mansion2_279c7cd6:

    # ra "\"Huh?\""
    ra "\"Hã?\""

# game/Carl-Mansion2.rpy:465
translate ptbr mansion2_ecd3a89a:

    # j "\"I've got a side angle here. You were at least two feet away.\""
    j "\"Eu tenho uma visão lateral aqui. Você estava a pelo menos uns sessenta centímetros de distância.\""

# game/Carl-Mansion2.rpy:466
translate ptbr mansion2_fa45a7ff:

    # "There's a brief silence."
    "Há um breve silêncio."

# game/Carl-Mansion2.rpy:467
translate ptbr mansion2_d59fa8a3:

    # c "\"Jenna, what are you talking about?\""
    c "\"Jenna, do que você tá falando?\""

# game/Carl-Mansion2.rpy:468
translate ptbr mansion2_c1d83cdb:

    # j "\"I don't know, Carl. What AM I talking about?\""
    j "\"Não sei, Carl. Do que eu ESTOU falando?\""

# game/Carl-Mansion2.rpy:469
translate ptbr mansion2_17a82c79:

    # "Jenna turns to the ram, eyes narrowed, teeth just slightly bared."
    "Jenna se vira para o carneiro, com os olhos semicerrados e os dentes ligeiramente à mostra."

# game/Carl-Mansion2.rpy:471
translate ptbr mansion2_65249113:

    # "I look at Carl."
    "Olho para o Carl."

# game/Carl-Mansion2.rpy:472
translate ptbr mansion2_177d78d0:

    # "He's frowning, a concerned look on his face."
    "Ele está franzindo a testa, com uma expressão preocupada."

# game/Carl-Mansion2.rpy:473
translate ptbr mansion2_f7d5e53c:

    # c "\"Jenna, I don't know what you're talking about.\""
    c "\"Jenna, eu não sei do que você tá falando.\""

# game/Carl-Mansion2.rpy:474
translate ptbr mansion2_9e46d085:

    # j "\"I'm saying there's no way that candle burned that paper.\""
    j "\"Tô dizendo que não tem como aquela vela ter queimado aquele papel.\""

# game/Carl-Mansion2.rpy:475
translate ptbr mansion2_7f722a52:

    # "Carl's concerned expression deepens, but there's also a hint of condescension there."
    "A expressão preocupada do Carl se intensifica, mas também há um tom de condescendência ali."

# game/Carl-Mansion2.rpy:476
translate ptbr mansion2_7349899b:

    # c "\"What else could have done it, Jenna?\""
    c "\"O que mais poderia ter feito isso, Jenna?\""

# game/Carl-Mansion2.rpy:477
translate ptbr mansion2_b7dc95d7:

    # "This time the silence is heavy."
    "Desta vez, o silêncio é pesado."

# game/Carl-Mansion2.rpy:478
translate ptbr mansion2_1217263c:

    # "I'm baffled by the interactions they've been having so far and, judging by the look on Raven's face, so is he."
    "Fico confuso com as interações que eles estão tendo até agora e, a julgar pela expressão no rosto do Raven, ele também está."

# game/Carl-Mansion2.rpy:479
translate ptbr mansion2_b8454c01:

    # ra "\"Hey guys, I'm sorry I burned it...but maybe we can figure something out from the title, uh, Meseta boy missing?\""
    ra "\"Ei, pessoal, desculpa por ter queimado... mas talvez a gente possa descobrir algo pelo título, tipo, garoto de Meseta desaparecido?\""

# game/Carl-Mansion2.rpy:480
translate ptbr mansion2_6358e95a:

    # "I look at Jenna."
    "Olho para a Jenna."

# game/Carl-Mansion2.rpy:481
translate ptbr mansion2_5738daa9:

    # m "\"Oh yeah, Meseta, isn't that—that your tribe, or...\""
    m "\"Ah, sim, Meseta, não é... a sua tribo, ou...\""

# game/Carl-Mansion2.rpy:482
translate ptbr mansion2_6a368c06:

    # j "\"Yep.\""
    j "\"Sim.\""

# game/Carl-Mansion2.rpy:483
translate ptbr mansion2_994854f8:

    # "I feel my face flush as I wonder if I'm being insensitive, like I think she knows everyone from the tribe."
    "Sinto meu rosto corar ao me perguntar se estou sendo insensível, tipo achando que ela conhece todo mundo da tribo."

# game/Carl-Mansion2.rpy:485
translate ptbr mansion2_612f03a1:

    # c "\"But what does that mean? A lot of people go missing out here.\""
    c "\"Mas o que isso significa? Muita gente desaparece por aqui.\""

# game/Carl-Mansion2.rpy:486
translate ptbr mansion2_460bd4af:

    # ra "\"Well, it would have something to do with James, right?\""
    ra "\"Bem, teria algo a ver com o James, né?\""

# game/Carl-Mansion2.rpy:487
translate ptbr mansion2_a11fd115:

    # c "\"How do we know that?\""
    c "\"Como a gente sabe disso?\""

# game/Carl-Mansion2.rpy:488
translate ptbr mansion2_65249113_1:

    # "I look at Carl."
    "Olho para o Carl."

# game/Carl-Mansion2.rpy:489
translate ptbr mansion2_a02f2e94:

    # m "\"Are you okay, man? You've been acting really weird ever since we got here.\""
    m "\"Você tá bem, cara? Você tá agindo muito estranho desde que chegamos aqui.\""

# game/Carl-Mansion2.rpy:490
translate ptbr mansion2_713ffd48:

    # c "\"I think we're all acting a little different after getting here, don't you think?\""
    c "\"Acho que todos nós estamos agindo um pouco diferente depois de chegar aqui, não acha?\""

# game/Carl-Mansion2.rpy:491
translate ptbr mansion2_8941e9d3_1:

    # "Carl glances at Jenna."
    "Carl dá uma olhada de relance para a Jenna."

# game/Carl-Mansion2.rpy:492
translate ptbr mansion2_9f82ccf3:

    # ra "\"Are we fighting again?\""
    ra "\"A gente tá brigando de novo?\""

# game/Carl-Mansion2.rpy:493
translate ptbr mansion2_0e8f31e4:

    # "Staring at the ash on the ground, something I should have realized earlier suddenly hits me."
    "Olhando para as cinzas no chão, algo que eu deveria ter percebido antes de repente me atinge."

# game/Carl-Mansion2.rpy:494
translate ptbr mansion2_6b3ce23a:

    # m "\"Wait a minute...that newspaper; it kind of looked like something that came out of the crawlspace tubs.\""
    m "\"Espera um pouco... aquele jornal; ele meio que parecia algo que veio das caixas do porão.\""

# game/Carl-Mansion2.rpy:495
translate ptbr mansion2_52ee4112:

    # j "\"What do you mean?\""
    j "\"O que você quer dizer?\""

# game/Carl-Mansion2.rpy:496
translate ptbr mansion2_6952daba:

    # m "\"I was looking through some artifacts that Carl's family saved from way back when, for that project I was doing.\""
    m "\"Eu estava examinando alguns artefatos que a família do Carl guardou lá de trás, para aquele projeto que eu estava fazendo.\""

# game/Carl-Mansion2.rpy:497
translate ptbr mansion2_15bd9e0a:

    # "It seems like years ago at this point."
    "Parece que faz anos a essa altura."

# game/Carl-Mansion2.rpy:498
translate ptbr mansion2_8fdb791b:

    # "I snap my fingers."
    "Estalo os dedos."

# game/Carl-Mansion2.rpy:499
translate ptbr mansion2_a64002e1:

    # m "\"And some of the stuff was missing from it, like pages ripped out from Carl's mom's notes that had photocopies of old newspapers.\""
    m "\"E algumas coisas estavam faltando nelas, como páginas arrancadas das anotações da mãe do Carl que tinham fotocópias de jornais velhos.\""

# game/Carl-Mansion2.rpy:500
translate ptbr mansion2_2f89812d:

    # ra "\"So...so was that just a clipping from the notes?\""
    ra "\"Então... então aquilo era só um recorte das anotações?\""

# game/Carl-Mansion2.rpy:501
translate ptbr mansion2_6f57001f:

    # m "\"Maybe? I dunno, but John was native, so maybe it has to do with him?\""
    m "\"Talvez? Não sei, mas o John era nativo, então talvez tenha a ver com ele?\""

# game/Carl-Mansion2.rpy:502
translate ptbr mansion2_a4901b98:

    # "I think back to the small fox I saw through the window, the band across his forehead."
    "Penso de volta na pequena raposa que vi pela janela, com a faixa na testa."

# game/Carl-Mansion2.rpy:503
translate ptbr mansion2_3e7d5d24:

    # "Was that John?"
    "Aquele era o John?"

# game/Carl-Mansion2.rpy:504
translate ptbr mansion2_81f0aef5:

    # j "\"So the ghost just ripped out the pages to show you in this nightmare world? Why didn't he just point them out to you in the real world?\""
    j "\"So o fantasma só arrancou as páginas para te mostrar neste mundo de pesadelo? Por que ele simplesmente não apontou elas para você no mundo real?\""

# game/Carl-Mansion2.rpy:505
translate ptbr mansion2_dd34e176:

    # "I don't really have an answer for that."
    "Eu realmente não tenho uma resposta para isso."

# game/Carl-Mansion2.rpy:506
translate ptbr mansion2_7e086806:

    # j "\"Then we wouldn't have to be going through this shit right now.\""
    j "\"Aí a gente não precisaria estar passando por essa merda agora.\""

# game/Carl-Mansion2.rpy:507
translate ptbr mansion2_2cc7bd33:

    # ra "\"Ghost rules?\""
    ra "\"Regras de fantasmas?\""

# game/Carl-Mansion2.rpy:508
translate ptbr mansion2_d7cd966f:

    # "Raven shrugs."
    "Raven dá de ombros."

# game/Carl-Mansion2.rpy:509
translate ptbr mansion2_d823f23c:

    # j "\"And what if that was our key out of here?\""
    j "\"E se aquilo fosse a nossa chave para sair daqui?\""

# game/Carl-Mansion2.rpy:510
translate ptbr mansion2_d87fd0dc:

    # ra "\"Well, they can't just leave us here, right?\""
    ra "\"Bem, eles não podem simplesmente deixar a gente aqui, né?\""

# game/Carl-Mansion2.rpy:511
translate ptbr mansion2_301281b2:

    # m "\"We don't know anything about where we are, or what these things are capable of...\""
    m "\"Nós não sabemos nada sobre onde estamos, ou do que essas coisas são capazes...\""

# game/Carl-Mansion2.rpy:512
translate ptbr mansion2_287d5729:

    # j "\"So what now, just sit around and wait for something else to happen?\""
    j "\"Então e agora, vamos só ficar sentados esperando outra coisa acontecer?\""

# game/Carl-Mansion2.rpy:514
translate ptbr mansion2_ebee937d:

    # "Carl suddenly sighs."
    "Carl de repente suspira."

# game/Carl-Mansion2.rpy:515
translate ptbr mansion2_dce16a34:

    # c "\"Well, I'm gonna look around some more. You guys do whatever you want.\""
    c "\"Bem, eu vou procurar mais um pouco. Vocês fazem o que quiserem.\""

# game/Carl-Mansion2.rpy:516
translate ptbr mansion2_286dcf5b:

    # "Again I'm taken aback by Carl's demeanor. I've never seen him act like this before."
    "Mais uma vez fico surpreso com o comportamento do Carl. Nunca vi ele agir assim antes."

# game/Carl-Mansion2.rpy:517
translate ptbr mansion2_779029b2:

    # "It's like he's a different person."
    "É como se ele fosse uma pessoa diferente."

# game/Carl-Mansion2.rpy:518
translate ptbr mansion2_b77cb31c:

    # "Without another word, he turns on his hoof and walks away."
    "Sem dizer mais nada, ele dá meia-volta em seu casco e se afasta."

# game/Carl-Mansion2.rpy:522
translate ptbr mansion2_09e3be20:

    # "Over the next several hours we search the cabin from top to bottom."
    "Nas horas seguintes, vasculhamos a cabana de cima a baixo."

# game/Carl-Mansion2.rpy:523
translate ptbr mansion2_97bcf11d:

    # "I hobble around the ground floor, careful not to look out the window, even when the drumming starts up again at a few points."
    "Manquejo pelo térreo, tomando cuidado para não olhar pela janela, mesmo quando as batidas de tambor recomeçam em alguns momentos."

# game/Carl-Mansion2.rpy:524
translate ptbr mansion2_c5a608a2:

    # "I check all of the shelves, under the chairs and tables, in the stove, in the pantry, between the cracks in the floor and walls."
    "Verifico todas as prateleiras, debaixo das cadeiras e mesas, no fogão, na despensa, entre as frestas do chão e das paredes."

# game/Carl-Mansion2.rpy:525
translate ptbr mansion2_0432ada9:

    # "We don't find anything."
    "Não encontramos nada."

# game/Carl-Mansion2.rpy:526
translate ptbr mansion2_1e0ef332:

    # "At some point I almost topple over from dozing off and that's when we call off the search."
    "A certa altura quase caio de sono, e é aí que encerramos as buscas."

# game/Carl-Mansion2.rpy:527
translate ptbr mansion2_bfd6bab0:

    # "There's some discussion as to where we should sleep, if we should do it in shifts."
    "Há uma discussão sobre onde deveríamos dormir, se devíamos fazer turnos."

# game/Carl-Mansion2.rpy:528
translate ptbr mansion2_19ac869c:

    # "Jenna suggests she stay up downstairs while the rest of us sleep, just in case something else happens."
    "Jenna sugere ficar acordada no térreo enquanto o resto de nós dorme, caso aconteça mais alguma coisa."

# game/Carl-Mansion2.rpy:529
translate ptbr mansion2_7a0bc268:

    # "Carl suggests that I sleep in the bed upstairs because of my leg, and I have to agree with him."
    "Carl sugere que eu durma na cama lá de cima por causa da minha perna, e tenho que concordar com ele."

# game/Carl-Mansion2.rpy:530
translate ptbr mansion2_6cb6ae28:

    # "Raven stays downstairs with Jenna, making himself comfortable in one of the chairs."
    "Raven fica lá embaixo com a Jenna, acomodando-se em uma das chairs."

# game/Carl-Mansion2.rpy:531
translate ptbr mansion2_a7b88092:

    # "As Carl hobbles up the stairs with me on his back, Jenna watches us the whole way."
    "Enquanto o Carl sobe as escadas mancando comigo nas costas, Jenna nos observa o caminho todo."

# game/Carl-Mansion2.rpy:535
translate ptbr mansion2_fd41141b:

    # "I sit on the bed, watching as Carl moves about the room, looking behind shelves and under the bed."
    "Sento na cama, observando o Carl se mover pelo quarto, olhando atrás das prateleiras e debaixo da cama."

# game/Carl-Mansion2.rpy:536
translate ptbr mansion2_a2ef0ff5:

    # m "\"Carl, I hate to ask again, but are you okay?\""
    m "\"Carl, odeio perguntar de novo, mas você tá bem?\""

# game/Carl-Mansion2.rpy:538
translate ptbr mansion2_49625a18:

    # c "\"Hmm?\""
    c "\"Hum?\""

# game/Carl-Mansion2.rpy:539
translate ptbr mansion2_b93022fc:

    # "He looks back at me."
    "Ele olha de volta para mim."

# game/Carl-Mansion2.rpy:540
translate ptbr mansion2_38eaba80:

    # c "\"Yeah, I'm fine. I just want to make sure everything is safe for you.\""
    c "\"Sim, eu tô bem. Só quero garantir que tudo esteja seguro pra você.\""

# game/Carl-Mansion2.rpy:541
translate ptbr mansion2_1edb44b8:

    # m "\"Thanks...it's just—it's just that you seem...different, I guess.\""
    m "\"Obrigado... é só—é só que você parece... diferente, sei lá.\""

# game/Carl-Mansion2.rpy:542
translate ptbr mansion2_4a7b86f1:

    # "Carl looks at the ceiling, seemingly thinking."
    "Carl olha para o teto, aparentemente pensando."

# game/Carl-Mansion2.rpy:543
translate ptbr mansion2_fa180996:

    # "It's difficult to make him out in the darkness."
    "É difícil distinguir a silhueta dele na escuridão."

# game/Carl-Mansion2.rpy:544
translate ptbr mansion2_568389ab:

    # "Just like when he had a sheet over his head, I get the weird feeling that who I'm looking at might not be Carl."
    "Exatamente como quando ele estava com o lençol na cabeça, tenho a sensação estranha de que a pessoa para quem estou olhando talvez não seja o Carl."

# game/Carl-Mansion2.rpy:545
translate ptbr mansion2_1fae229f:

    # c "\"I think it's just that this has made me grow up. I realize now how useless I've been.\""
    c "\"Acho que é só que isso me fez amadurecer. Percebo agora o quanto fui inútil.\""

# game/Carl-Mansion2.rpy:546
translate ptbr mansion2_e5585c30:

    # c "\"This is sort of an opportunity for me to actually do something, help people. You know?\""
    c "\"Isso é meio que uma oportunidade pra eu realmente fazer algo, ajudar as pessoas. Sabe?\""

# game/Carl-Mansion2.rpy:547
translate ptbr mansion2_c806ebc0_1:

    # m "\"Yeah.\""
    m "\"É.\""

# game/Carl-Mansion2.rpy:548
translate ptbr mansion2_c4fe0b14:

    # "It sounds nice, but I can't get rid of that nagging feeling that something is off."
    "Parece legal, mas não consigo me livrar daquela sensação incômoda de que algo está errado."

# game/Carl-Mansion2.rpy:549
translate ptbr mansion2_422a29bb:

    # "It's in the way he talks, the way he moves, right down to his facial expressions."
    "Está no jeito que ele fala, no jeito que se move, até nas expressões faciais dele."

# game/Carl-Mansion2.rpy:550
translate ptbr mansion2_2ec8bfb9:

    # "I swing my legs gingerly onto the bed and lay back."
    "Passo minhas pernas com cuidado para a cama e me deito de costas."

# game/Carl-Mansion2.rpy:551
translate ptbr mansion2_e62888fb:

    # "Carl comes over to sit on the other side."
    "Carl vem se sentar do outro lado."

# game/Carl-Mansion2.rpy:552
translate ptbr mansion2_339edb53:

    # m "\"Gonna sleep here, too?\""
    m "\"Vai dormir aqui também?\""

# game/Carl-Mansion2.rpy:553
translate ptbr mansion2_9c17b638:

    # c "\"Yeah. You need me to get around, so I'm gonna be by your side as much as possible."
    c "\"Sim. Você precisa de mim pra se mover, então vou ficar do seu lado o máximo possível.\""

# game/Carl-Mansion2.rpy:554
translate ptbr mansion2_481b9738:

    # m "\"Alright...thanks.\""
    m "\"Tudo bem... obrigado.\""

# game/Carl-Mansion2.rpy:555
translate ptbr mansion2_f246f9cc:

    # "As we lay awkwardly on our backs for a moment, Carl suddenly turns on his side and pulls me into his chest."
    "Enquanto ficamos deitados de costas meio sem jeito por um momento, Carl de repente se vira de lado e me puxa contra o peito dele."

# game/Carl-Mansion2.rpy:556
translate ptbr mansion2_82eeafce:

    # "I'm surprised, and turn instinctively so that he's spooning me."
    "Fico surpreso e me viro instintivamente para que ele me abrace em conchinha."

# game/Carl-Mansion2.rpy:557
translate ptbr mansion2_61be5400:

    # "I guess it makes sense after our semi-confession back in the mansion."
    "Acho que faz sentido depois da nossa quase-confissão lá na mansão."

# game/Carl-Mansion2.rpy:558
translate ptbr mansion2_9d3edd0d:

    # "He nuzzles my neck, but again, the action is weirdly unnatural."
    "Ele roça o focinho no meu pescoço, mas, novamente, o gesto parece estranhamente forçado."

# game/Carl-Mansion2.rpy:560
translate ptbr mansion2_14fbf5bc:

    # "Even with his big, warm body next to mine, it takes me a long time to fall asleep."
    "Mesmo com o corpo grande e quente dele ao lado do meu, levo muito tempo para conseguir dormir."

# game/Carl-Mansion2.rpy:562
translate ptbr mansion2_59c0912f:

    # "I open my eyes and blearily I can make out the dark cabin room."
    "Abro os olhos e, com a visão embaçada, consigo distinguir o quarto escuro da cabana."

# game/Carl-Mansion2.rpy:566
translate ptbr mansion2_e6b82954:

    # "My heart sinks again at realizing where I'm at, but it's more subdued this time."
    "Meu coração aperta de novo ao perceber onde estou, mas é uma sensação mais contida desta vez."

# game/Carl-Mansion2.rpy:567
translate ptbr mansion2_da0c2d9c:

    # "Guess I'm getting used to my new life."
    "Acho que estou me acostumando com a minha nova vida."

# game/Carl-Mansion2.rpy:568
translate ptbr mansion2_6f4ee1f7:

    # "My mouth is dry, very dry, and I feel like I need to find water or I'm not going back to sleep."
    "Minha boca está seca, muito seca, e sinto que preciso achar água ou não vou conseguir voltar a dormir."

# game/Carl-Mansion2.rpy:569
translate ptbr mansion2_deca176b:

    # "I sit up."
    "Eu me sento."

# game/Carl-Mansion2.rpy:570
translate ptbr mansion2_e57869cb:

    # "Carl's moved back to his side of the bed at this point, lying out on his back, snoring."
    "Carl já voltou para o lado dele da cama a essa altura, deitado de costas, roncando."

# game/Carl-Mansion2.rpy:571
translate ptbr mansion2_70e6860f:

    # "Quietly, I get out of the bed, wincing at how creaky the floorboards are."
    "De mansinho, saio da cama, estremecendo com o quanto as tábuas do chão rangem."

# game/Carl-Mansion2.rpy:572
translate ptbr mansion2_98c6ba7d:

    # "I make my way down the stairs, eyes adjusted to the point where I can barely make out the ledges."
    "Vou descendo as escadas, com os olhos já adaptados ao ponto de conseguir discernir mal e mal os degraus."

# game/Carl-Mansion2.rpy:576
translate ptbr mansion2_630e1083:

    # "When I reach the ground level I see that Raven is splayed out on the carpet, snoring as well."
    "Quando chego ao andar de baixo, vejo que o Raven está estatelado no tapete, roncando também."

# game/Carl-Mansion2.rpy:577
translate ptbr mansion2_e2184855:

    # "I shake my head before moving to the kitchen."
    "Balanço a cabeça antes de ir para a cozinha."

# game/Carl-Mansion2.rpy:581
translate ptbr mansion2_8abab7c0:

    # "Jenna isn't there and I wonder where she might be at."
    "Jenna não está ali e me pergunto onde ela poderia estar."

# game/Carl-Mansion2.rpy:582
translate ptbr mansion2_4f847c51:

    # "Was she in that other room upstairs?"
    "Será que ela estava no outro quarto lá de cima?"

# game/Carl-Mansion2.rpy:583
translate ptbr mansion2_64f75ebf:

    # "Maybe I just missed her when I was distracted by Raven."
    "Talvez eu só não tenha visto ela quando me distraí com o Raven."

# game/Carl-Mansion2.rpy:584
translate ptbr mansion2_267fb09b:

    # "Looking around, I see a small cup sitting on the table."
    "Olhando ao redor, vejo um copo pequeno em cima da mesa."

# game/Carl-Mansion2.rpy:585
translate ptbr mansion2_4396baf6:

    # "I'm almost positive it hasn't been there before, but maybe Raven, or Jenna had set it there."
    "Tenho quase certeza de que não estava ali antes, mas talvez o Raven ou a Jenna tenham colocado ele lá."

# game/Carl-Mansion2.rpy:586
translate ptbr mansion2_f090ec7a:

    # "Walking over to it I'm relieved to see that it's filled with what looks like water."
    "Caminhando até lá, fico aliviado ao ver que está cheio de algo que parece água."

# game/Carl-Mansion2.rpy:587
translate ptbr mansion2_71da257c:

    # "I pick it up and sniff at it, not really getting a hint of anything."
    "Eu o pego e dou uma cheirada, sem sentir cheiro de nada na verdade."

# game/Carl-Mansion2.rpy:588
translate ptbr mansion2_ba69c153:

    # "Tentatively, I take a sip..."
    "Hesitante, dou um gole..."

# game/Carl-Mansion2.rpy:589
translate ptbr mansion2_0d7ed84a:

    # "...and immediately spit it out."
    "...e cuspo imediatamente."

# game/Carl-Mansion2.rpy:590
translate ptbr mansion2_25727342:

    # "It's salty, putrid...it tastes like—"
    "É salgado, podre... tem gosto de—"

# game/Carl-Mansion2.rpy:592
translate ptbr mansion2_78485bdb:

    # "I jump and some of the liquid splashes to the floor."
    "Dou um pulo e um pouco do líquido espirra no chão."

# game/Carl-Mansion2.rpy:593
translate ptbr mansion2_4d855516:

    # "Gingerly, I set down the cup, looking into the opposite room."
    "Com cuidado, coloco o copo de volta, olhando para o cômodo da frente."

# game/Carl-Mansion2.rpy:597
translate ptbr mansion2_b36c6b2f:

    # "Everything is still in the other room. I can't even hear Raven snoring anymore."
    "Está tudo parado no outro quarto. Não consigo nem ouvir mais o Raven roncando."

# game/Carl-Mansion2.rpy:599
translate ptbr mansion2_d648550a:

    # "This time I see the wardrobe move, the door specifically."
    "Dessa vez vejo o guarda-roupa se mover, especificamente a porta."

# game/Carl-Mansion2.rpy:600
translate ptbr mansion2_6860b5a2:

    # "I stare, wide-eyed."
    "Fico encarando, de olhos arregalados."

# game/Carl-Mansion2.rpy:601
translate ptbr mansion2_1945844f:

    # "Everything falls still again, but I don't dare move."
    "Tudo fica parado de novo, mas não me atrevo a me mover."

# game/Carl-Mansion2.rpy:602
translate ptbr mansion2_0df0d509:

    # m "\"Jenna?\""
    m "\"Jenna?\""

# game/Carl-Mansion2.rpy:603
translate ptbr mansion2_93a10839:

    # "I whisper loudly."
    "Sussurro alto."

# game/Carl-Mansion2.rpy:604
translate ptbr mansion2_f662a11d:

    # "It wouldn't make any sense why she'd be in there, but who else would it be?\""
    "Não faria o menor sentido ela estar ali dentro, mas quem mais seria?\""

# game/Carl-Mansion2.rpy:605
translate ptbr mansion2_1d73458f:

    # "...Ghosts, of course."
    "...Fantasmas, claro."

# game/Carl-Mansion2.rpy:606
translate ptbr mansion2_97fa5b99:

    # "I'm about to take a step forward, toward the stairs maybe, or to at least wake Raven up, but that's when the small door cracks open."
    "Estou prestes a dar um passo à frente, talvez em direção às escadas, ou pelo menos para acordar o Raven, mas é aí que a portinha se abre de leve."

# game/Carl-Mansion2.rpy:608
translate ptbr mansion2_c9d07164:

    # "I freeze, all of the fur on my body standing up."
    "Eu paraliso, todos os pelos do meu corpo se arrepiando."

# game/Carl-Mansion2.rpy:609
translate ptbr mansion2_bc75ae00:

    # m "\"J—James...\""
    m "\"J—James...\""

# game/Carl-Mansion2.rpy:610
translate ptbr mansion2_4a39c385:

    # "Words die on my tongue as something long and black slides out from behind the door."
    "As palavras morrem na minha boca quando algo longo e preto desliza de trás da porta."

# game/Carl-Mansion2.rpy:611
translate ptbr mansion2_74b3edbe:

    # "It dips down towards the ground and only then does it vaguely take the shape of a foot."
    "Ele se abaixa em direção ao chão e só então assume vagamente a forma de um pé."

# game/Carl-Mansion2.rpy:612
translate ptbr mansion2_4f11c57c:

    # "Another long, black tendril follows, slightly ahead of the first one."
    "Outro tentáculo longo e preto o segue, um pouco à frente do primeiro."

# game/Carl-Mansion2.rpy:613
translate ptbr mansion2_a672ba4d:

    # "When it touches the ground it takes the shape of a hand, resting flat on the wooden floor."
    "Quando toca o chão, assume a forma de uma mão, apoiada no chão de madeira."

# game/Carl-Mansion2.rpy:614
translate ptbr mansion2_66f8f2cf:

    # "I choke and start to try and back away, but then—"
    "Eu me engasgo e começo a tentar recuar, mas então—"

# game/Carl-Mansion2.rpy:617
translate ptbr mansion2_dd7b2348:

    # "The door explodes open and I'm just barely able to make out a galloping black shape before it engulfs me."
    "A porta se escancara de vez e mal consigo discernir um vulto preto galopando antes dele me engolir."

# game/Carl-Mansion2.rpy:618
translate ptbr mansion2_8e07a719:

    # "I collapse back onto the ground, twisting, trying to scream, but the thing is completely covering and smothering me."
    "Caio de costas no chão, me contorcendo, tentando gritar, mas a coisa está me cobrindo e me sufocando completamente."

# game/Carl-Mansion2.rpy:619
translate ptbr mansion2_aeda22c4:

    # "I choke, and gag, feeling like I'm being suffocated, my arms pinned to my sides, my legs rigid."
    "Eu me engasgo e tenho ânsia, sentindo que estou sendo sufocado, com meus braços colados ao corpo, minhas pernas rígidas."

# game/Carl-Mansion2.rpy:620
translate ptbr mansion2_17a7853d:

    # "As I try to yank away from the thing it feels like something is freed from my mouth and I'm able to scream;"
    "Conforme tento me desvencilhar da coisa, sinto como se algo se soltasse da minha boca e consigo gritar;"

# game/Carl-Mansion2.rpy:621
translate ptbr mansion2_89fdbdfd:

    # m "\"Help! Get it off me! Help!!!\""
    m "\"Socorro! Tira isso de cima de mim! Socorro!!!\""

# game/Carl-Mansion2.rpy:623
translate ptbr mansion2_98a39349_1:

    # c "\"Chase!\""
    c "\"Chase!\""

# game/Carl-Mansion2.rpy:624
translate ptbr mansion2_d0adf60a:

    # "The surface underneath me becomes soft, the thing on top of me warm."
    "A superfície debaixo de mim fica macia, e a coisa em cima de mim fica quente."

# game/Carl-Mansion2.rpy:629
translate ptbr mansion2_5c3824c9:

    # "Through bleary eyes, I look up at Carl, just able to make out the curve of his horns."
    "Com os olhos embaçados, olho para o Carl, conseguindo apenas discernir a curva dos seus chifres."

# game/Carl-Mansion2.rpy:630
translate ptbr mansion2_74dba477_1:

    # m "\"Carl?\""
    m "\"Carl?\""

# game/Carl-Mansion2.rpy:631
translate ptbr mansion2_a2b389cb:

    # "I hear movement at the doorway and I glance in that direction to find Jenna standing there, hackles raised, teeth bared."
    "Ouço um movimento no batente da porta e olho naquela direção para ver a Jenna parada ali, com os pelos arrepiados e os dentes arreganhados."

# game/Carl-Mansion2.rpy:633
translate ptbr mansion2_5f6d5a71:

    # m "\"Jenna!?\""
    m "\"Jenna!?\""

# game/Carl-Mansion2.rpy:634
translate ptbr mansion2_e5d9510a:

    # "Before I know what exactly is going on, Jenna sprints across the room and jumps on the bed."
    "Antes de eu entender o que exatamente está acontecendo, Jenna corre pelo quarto e pula na cama."

# game/Carl-Mansion2.rpy:635
translate ptbr mansion2_a463f7d1:

    # "Carl doesn't even have time to turn around before she snatches him up by the horns and yanks his head back violently."
    "Carl nem tem tempo de se virar antes que ela o pegue pelos chifres e puxe sua cabeça para trás violentamente."

# game/Carl-Mansion2.rpy:640
translate ptbr mansion2_081134c5:

    # "The ram lets out a choking sound as he's dragged back and thrown to the floor."
    "O carneiro solta um som abafado de engasgo enquanto é arrastado para trás e arremessado no chão."

# game/Carl-Mansion2.rpy:641
translate ptbr mansion2_75c589da:

    # "Jenna jumps off the bed after him."
    "Jenna pula da cama atrás dele."

# game/Carl-Mansion2.rpy:642
translate ptbr mansion2_fffce029:

    # "From the sounds of it she lands on him."
    "Pelo barulho, parece que ela cai em cima dele."

# game/Carl-Mansion2.rpy:643
translate ptbr mansion2_1c7ac613:

    # "What follows is a series of thuds and smacks."
    "O que se segue é uma série de baques e estalos."

# game/Carl-Mansion2.rpy:644
translate ptbr mansion2_a16ae2d4:

    # "Weakly, I pull myself to the foot of the bed, still completely disorientated."
    "Fraco, me arrasto até o pé da cama, ainda completamente desorientado."

# game/Carl-Mansion2.rpy:645
translate ptbr mansion2_1ca7514d:

    # j "\"I knew it you motherfucking piece of shit!\""
    j "\"Eu sabia, seu pedaço de merda filho da puta!\""

# game/Carl-Mansion2.rpy:646
translate ptbr mansion2_b9e9b0e0:

    # "What I see is Jenna sitting on Carl's back, swinging her fists into his head while the ram tries to cover up."
    "O que vejo é a Jenna sentada nas costas do Carl, descendo os punhos na cabeça dele enquanto o carneiro tenta se proteger."

# game/Carl-Mansion2.rpy:647
translate ptbr mansion2_46f3e470:

    # j "\"You haven't changed at all!\""
    j "\"Você não mudou nada!\""

# game/Carl-Mansion2.rpy:648
translate ptbr mansion2_2353c524:

    # m "\"Jenna, stop!\""
    m "\"Jenna, para!\""

# game/Carl-Mansion2.rpy:649
translate ptbr mansion2_0b20dd82:

    # "I roll of the bed, confused as to why I'm so weak."
    "Eu rolo para fora da cama, confuso sobre o porquê de estar tão fraco."

# game/Carl-Mansion2.rpy:650
translate ptbr mansion2_01d17ec8:

    # "Pain shoots up my leg again, but this time I barely notice it."
    "Uma dor sobe pela minha perna de novo, mas dessa vez mal a noto."

# game/Carl-Mansion2.rpy:651
translate ptbr mansion2_5fae39f0:

    # "There's something around Jenna, something big and black, like a shadow, making her look much bigger than she actually is."
    "Tem algo ao redor da Jenna, algo grande e preto, como uma sombra, fazendo-a parecer muito maior do que realmente é."

# game/Carl-Mansion2.rpy:652
translate ptbr mansion2_6b89c764:

    # "Her fists swing and hit Carl with a force I didn't think she was capable of."
    "Seus punhos voam e atingem o Carl com uma força que eu não achava que ela fosse capaz de ter."

# game/Carl-Mansion2.rpy:653
translate ptbr mansion2_24031894:

    # "Then she grabs Carl by the horns again and yanks back before slamming his face back into the floor."
    "Então ela agarra o Carl pelos chifres de novo e puxa para trás antes de bater a cara dele contra o chão."

# game/Carl-Mansion2.rpy:654
translate ptbr mansion2_a566ce32:

    # m "\"JENNA!\""
    m "\"JENNA!\""

# game/Carl-Mansion2.rpy:655
translate ptbr mansion2_015734ce:

    # "I lunge forward, trying to put myself between the two of them."
    "Eu me lanço à frente, tentando me colocar entre os dois."

# game/Carl-Mansion2.rpy:656
translate ptbr mansion2_ce101269:

    # "Underneath me Carl has gone limp."
    "Debaixo de mim, Carl ficou mole."

# game/Carl-Mansion2.rpy:657
translate ptbr mansion2_c2631401:

    # "Just like Jenna, there's something black and shadowy around him as well, but it's fading, moving away..."
    "Assim como a Jenna, há algo preto e sombrio ao redor dele também, mas está sumindo, se afastando..."

# game/Carl-Mansion2.rpy:658
translate ptbr mansion2_e100ceda:

    # "Jenna's still trying to get at Carl, reaching around me and snarling in my ear; a sound that makes my fur stand on end."
    "Jenna ainda tenta pegar o Carl, esticando os braços ao meu redor e rosnando no meu ouvido; um som que faz meus pelos se arrepiarem."

# game/Carl-Mansion2.rpy:659
translate ptbr mansion2_d4499193:

    # "Then she's gone."
    "Então ela some."

# game/Carl-Mansion2.rpy:660
translate ptbr mansion2_f789a2a7:

    # "I look to my left and see Jenna being drawn back by Raven, his eyes wide with shock."
    "Olho para a minha esquerda e vejo a Jenna sendo puxada para trás pelo Raven, com os olhos dele arregalados de choque."

# game/Carl-Mansion2.rpy:661
translate ptbr mansion2_b5488073:

    # ra "\"What are you doing!?\""
    ra "\"O que você está fazendo!?\""

# game/Carl-Mansion2.rpy:662
translate ptbr mansion2_466613f1:

    # "Jenna struggles in the husky's grasp."
    "Jenna se debate no aperto do husky."

# game/Carl-Mansion2.rpy:663
translate ptbr mansion2_d71c2bea:

    # j "\"I saw him! He was trying to fuck the otter!\""
    j "\"Eu vi! Ele estava tentando foder a lontra!\""

# game/Carl-Mansion2.rpy:664
translate ptbr mansion2_447a4db1:

    # "The otter?"
    "A lontra?"

# game/Carl-Mansion2.rpy:665
translate ptbr mansion2_aa71fd0c:

    # m "\"Jenna, stop! He was helping me!\""
    m "\"Jenna, para! Ele estava me ajudando!\""

# game/Carl-Mansion2.rpy:666
translate ptbr mansion2_a7db5f76:

    # "Raven continues to try and pull Jenna towards the door, but she continues to struggle."
    "Raven continua tentando puxar a Jenna em direção à porta, mas ela continua se debatendo."

# game/Carl-Mansion2.rpy:667
translate ptbr mansion2_7ebec17b:

    # m "\"I was having a nightmare!\""
    m "\"Eu estava tendo um pesadelo!\""

# game/Carl-Mansion2.rpy:669
translate ptbr mansion2_a6870c97:

    # "Jenna's struggling losing some of its vigor, but she continues to snarl in Carl's direction."
    "A luta da Jenna perde um pouco da força, mas ela continua rosnando na direção do Carl."

# game/Carl-Mansion2.rpy:670
translate ptbr mansion2_37ec84d2:

    # m "\"Raven, please get her out of here.\""
    m "\"Raven, por favor, tira ela daqui.\""

# game/Carl-Mansion2.rpy:671
translate ptbr mansion2_de559363:

    # "The shadow around Jenna seems to shrink and her face shows some doubt as she stares at the crumpled form of Carl."
    "A sombra ao redor da Jenna parece encolher e seu rosto mostra certa dúvida enquanto ela encara a figura caída do Carl."

# game/Carl-Mansion2.rpy:672
translate ptbr mansion2_3bb30bad:

    # "After a moment, she seems to let the husky lead her from the room and I hear soothing tones from Raven as he leads her down the stairs."
    "Depois de um momento, ela parece deixar o husky tirá-la do quarto e ouço o tom reconfortante do Raven enquanto a conduz escada abaixo."

# game/Carl-Mansion2.rpy:673
translate ptbr mansion2_9deb0059:

    # "I turn back to Carl who has his arms around his head, face still buried in the ground."
    "Eu me volto para o Carl, que está com os braços em volta da cabeça, o rosto ainda enterrado no chão."

# game/Carl-Mansion2.rpy:674
translate ptbr mansion2_3555f042:

    # "After a while, I see his shoulders heaving with sobs."
    "Depois de um tempo, vejo os ombros dele sacudirem com os soluços."

# game/Carl-Mansion2.rpy:675
translate ptbr mansion2_ff5e2697:

    # "Gently, I pull one of his arms back and he looks up at me."
    "Com cuidado, puxo um dos braços dele e ele olha para mim."

# game/Carl-Mansion2.rpy:676
translate ptbr mansion2_05139fbd:

    # "This time I recognize his face."
    "Dessa vez eu reconheço o rosto dele."

# game/Carl-Mansion2.rpy:682
translate ptbr mansion2_04c48323:

    # "I sit next to Carl on the bed, mopping up his face with his bloodied button up shirt."
    "Sento ao lado do Carl na cama, limpando o rosto dele com sua camisa de botão ensanguentada."

# game/Carl-Mansion2.rpy:683
translate ptbr mansion2_aec25520:

    # "He sits there silently, looking at his hands while I work."
    "Ele se senta ali em silêncio, olhando para as próprias mãos enquanto eu trabalho."

# game/Carl-Mansion2.rpy:684
translate ptbr mansion2_c98e8e92:

    # m "\"At least nothing's broken.\""
    m "\"Pelo menos nada quebrou.\""

# game/Carl-Mansion2.rpy:686
translate ptbr mansion2_6c61bd01:

    # c "\"Dude...what happened?\""
    c "\"Cara... o que aconteceu?\""

# game/Carl-Mansion2.rpy:687
translate ptbr mansion2_a4e2dcd9:

    # "I'm not sure if he's talking about what happened with Jenna, or just everything."
    "Não tenho certeza se ele está falando sobre o que aconteceu com a Jenna ou sobre tudo."

# game/Carl-Mansion2.rpy:688
translate ptbr mansion2_af48717e:

    # m "\"I've been asking that same question since we got here."
    m "\"Venho me fazendo essa mesma pergunta desde que chegamos aqui.\""

# game/Carl-Mansion2.rpy:690
translate ptbr mansion2_b99512b9:

    # "He looks at his hands again."
    "Ele olha para as próprias mãos de novo."

# game/Carl-Mansion2.rpy:691
translate ptbr mansion2_78506951:

    # c "\"I felt...I felt different.\""
    c "\"Eu me senti... eu me senti diferente.\""

# game/Carl-Mansion2.rpy:692
translate ptbr mansion2_bf870949:

    # "I sit back and look him over, satisfied with having cleaned up most of his face."
    "Me sento para trás e o examino, satisfeito por ter limpado a maior parte do rosto dele."

# game/Carl-Mansion2.rpy:693
translate ptbr mansion2_ca0e4896:

    # m "\"You were acting different, too.\""
    m "\"Você estava agindo diferente também.\""

# game/Carl-Mansion2.rpy:694
translate ptbr mansion2_46cc5714:

    # c "\"Like, I felt like I knew everything. I knew what I was doing.\""
    c "\"Tipo, parecia que eu sabia tudo. Que eu sabia o que estava fazendo.\""

# game/Carl-Mansion2.rpy:695
translate ptbr mansion2_3422fe9a:

    # m "\"You were acting really confident.\""
    m "\"Você estava agindo com muita confiança.\""

# game/Carl-Mansion2.rpy:696
translate ptbr mansion2_cbb5ee8c:

    # "I agree and set his bloody shirt off to the side."
    "Concordo e coloco a camisa ensanguentada dele de lado."

# game/Carl-Mansion2.rpy:697
translate ptbr mansion2_3c891f1a:

    # "When I look back at him he seems so sad and beaten down that I have to hug him."
    "Quando olho de volta para ele, ele parece tão triste e derrotado que sou obrigado a lhe dar um abraço."

# game/Carl-Mansion2.rpy:698
translate ptbr mansion2_4e572983:

    # c "\"Dude, you're gonna make me start crying again...\""
    c "\"Cara, cê vai me fazer começar a chorar de novo...\""

# game/Carl-Mansion2.rpy:699
translate ptbr mansion2_da7a01bb:

    # "His voice cracks, but he hugs back anyway."
    "A voz dele falha, mas ele me abraça de volta mesmo assim."

# game/Carl-Mansion2.rpy:700
translate ptbr mansion2_60b44cf5:

    # m "\"I'm just glad you're back. I felt like I was talking to a stranger.\""
    m "\"Só estou feliz por você ter voltado. Sentia como se estivesse conversando com um estranho.\""

# game/Carl-Mansion2.rpy:701
translate ptbr mansion2_e0595a17:

    # "Carl leans against me and sighs."
    "Carl se apoia em mim e suspira."

# game/Carl-Mansion2.rpy:702
translate ptbr mansion2_07ba6c1e:

    # c "\"I don't know if I'm glad, though. It's like I just came down from a huge high.\""
    c "\"Mas não sei se estou feliz. É como se eu estivesse descendo de uma onda gigante.\""

# game/Carl-Mansion2.rpy:703
translate ptbr mansion2_637b968b:

    # "I rub his shoulder for a while before I venture forward with my guess."
    "Esfrego o ombro dele por um tempo antes de me arriscar com o meu palpite."

# game/Carl-Mansion2.rpy:704
translate ptbr mansion2_e2f39ec6:

    # m "\"Was it James?\""
    m "\"Era o James?\""

# game/Carl-Mansion2.rpy:705
translate ptbr mansion2_7db7ecc8:

    # c "\"I—I don't know. Maybe.\""
    c "\"Eu—eu não sei. Talvez.\""

# game/Carl-Mansion2.rpy:706
translate ptbr mansion2_db73523c:

    # "Carl looks at his hands again, like he's questioning if they're even his."
    "Carl olha para as próprias mãos de novo, como se estivesse questionando se elas são mesmo dele."

# game/Carl-Mansion2.rpy:707
translate ptbr mansion2_85d8654f:

    # c "\"I just felt like I knew what I wanted, and when things didn't go the way I thought they would I'd get really pissed.\""
    c "\"Eu só sentia que sabia o que queria, e quando as coisas não saíam do jeito que eu achava que deveriam, eu ficava puto da vida.\""

# game/Carl-Mansion2.rpy:708
translate ptbr mansion2_64b18242:

    # "He's silent for a while, I imagine contemplating what he'd just gone through."
    "Ele fica em silêncio por um tempo; imagino que contemplando o que acabara de passar."

# game/Carl-Mansion2.rpy:709
translate ptbr mansion2_9e26d983:

    # m "\"Jenna isn't really acting like herself either.\""
    m "\"A Jenna também não está agindo muito como ela mesma.\""

# game/Carl-Mansion2.rpy:711
translate ptbr mansion2_4c221d90:

    # "Carl looks up at that."
    "Carl olha para cima ao ouvir isso."

# game/Carl-Mansion2.rpy:712
translate ptbr mansion2_60fad2bb:

    # c "\"Yeah, I felt like whatever was in me...whatever it is really hates what Jenna is doing, for some reason.\""
    c "\"É, eu sentia que o que quer que estivesse em mim... o que quer que seja odeia muito o que a Jenna está fazendo, por algum motivo.\""

# game/Carl-Mansion2.rpy:713
translate ptbr mansion2_4454f959:

    # "Carl looks around at the room, scanning it with his dark, green eyes."
    "Carl olha ao redor do quarto, examinando-o com seus olhos verdes escuros."

# game/Carl-Mansion2.rpy:714
translate ptbr mansion2_193bd8be:

    # c "\"I feel like all of this is some kind of mental fight between James and whatever else is fighting against him.\""
    c "\"Sinto que tudo isso é algum tipo de luta mental entre o James e o que quer que esteja lutando contra ele.\""

# game/Carl-Mansion2.rpy:716
translate ptbr mansion2_bbbd35f3:

    # "He looks back down at his hands."
    "Ele olha de volta para as próprias mãos."

# game/Carl-Mansion2.rpy:717
translate ptbr mansion2_b33552ec:

    # c "\"That's why we have to do all of this.\""
    c "\"É por isso que temos que fazer tudo isso.\""

# game/Carl-Mansion2.rpy:719
translate ptbr mansion2_5faaa17f:

    # "He falls back into silence and I don't ask anymore questions, wanting to let him rest a bit."
    "Ele volta a ficar em silêncio e não faço mais perguntas, querendo deixá-lo descansar um pouco."

# game/Carl-Mansion2.rpy:720
translate ptbr mansion2_53e0787d:

    # "There is one nagging thought that comes to my mind, though;"
    "Mas tem um pensamento incômodo que me vem à mente;"

# game/Carl-Mansion2.rpy:721
translate ptbr mansion2_eead52ba:

    # m "\"This is kinda stupid, but what happened back in the mansion, you know, that thing between us...\""
    m "\"Isso é meio idiota, mas o que aconteceu lá na mansão, sabe, aquela parada entre a gente...\""

# game/Carl-Mansion2.rpy:723
translate ptbr mansion2_4e29fd84:

    # "He looks up at me and I feel my face flush, looking away."
    "Ele olha para mim e sinto meu rosto corar, desviando o olhar."

# game/Carl-Mansion2.rpy:724
translate ptbr mansion2_444ac18c:

    # m "\"I guess I'm wondering if any of that was real. I mean, if it was really you feeling that way.\""
    m "\"Acho que estou me perguntando se alguma parte daquilo foi real. Quero dizer, se era realmente você se sentindo daquele jeito.\""

# game/Carl-Mansion2.rpy:726
translate ptbr mansion2_d6b9ee47:

    # "Carl doesn't say anything so I'm forced to look up at him. When I do he has a sad sort of smile on his face."
    "Carl não diz nada, então sou forçado a olhar para ele. Quando o faço, ele tem uma espécie de sorriso triste no rosto."

# game/Carl-Mansion2.rpy:728
translate ptbr mansion2_bf1c783c:

    # c "\"Dude, I think that was the only part of me that was real.\""
    c "\"Cara, acho que aquela foi a única parte de mim que era real.\""

# game/Carl-Mansion2.rpy:729
translate ptbr mansion2_010b17a4:

    # "Despite where we are, despite everything that's happening, that somehow makes me incredibly happy."
    "Apesa de onde estamos, apesar de tudo o que está acontecendo, isso de alguma forma me deixa incrivelmente feliz."

# game/Carl-Mansion2.rpy:730
translate ptbr mansion2_da9cff7d:

    # "Happy enough to lean forward and kiss him."
    "Feliz o suficiente para me inclinar para a frente e beijá-lo."

# game/Carl-Mansion2.rpy:731
translate ptbr mansion2_a193818b:

    # "He kisses back and while it's barely more than a peck, it has my entire body feeling warm."
    "Ele retribui o beijo e, embora mal passe de um selinho, faz meu corpo inteiro se aquecer."

# game/Carl-Mansion2.rpy:732
translate ptbr mansion2_8bb4c116:

    # "He puts his own arm around me after I pull back and I rest my head on his shoulder."
    "Ele passa o braço ao meu redor depois que me afasto, e eu apoio minha cabeça no ombro dele."

# game/Carl-Mansion2.rpy:734
translate ptbr mansion2_9063d8d0:

    # c "\"I feel like it's gonna try to come back, though.\""
    c "\"Mas sinto que isso vai tentar voltar.\""

# game/Carl-Mansion2.rpy:735
translate ptbr mansion2_dd0ee98f:

    # "I look at him."
    "Olho para ele."

# game/Carl-Mansion2.rpy:736
translate ptbr mansion2_0e6300ee:

    # m "\"What, James?\""
    m "\"O quê, o James?\""

# game/Carl-Mansion2.rpy:737
translate ptbr mansion2_af630e74:

    # c "\"Whatever it is. I can already feel it, like it's on the edge of my mind...\""
    c "\"O que quer que seja. Já consigo sentir, como se estivesse no limite da minha mente...\""

# game/Carl-Mansion2.rpy:738
translate ptbr mansion2_04edce04:

    # m "\"Do you think you can fight it?\""
    m "\"Acha que consegue lutar contra isso?\""

# game/Carl-Mansion2.rpy:739
translate ptbr mansion2_85cd06bd:

    # "Carl sighs, then looks at me."
    "Carl suspira, então olha para mim."

# game/Carl-Mansion2.rpy:740
translate ptbr mansion2_252121ae:

    # c "\"Should I?\""
    c "\"Eu deveria?\""

# game/Carl-Mansion2.rpy:741
translate ptbr mansion2_9d3344cb:

    # m "\"What do you mean?\""
    m "\"Como assim?\""

# game/Carl-Mansion2.rpy:742
translate ptbr mansion2_de8cced6:

    # c "\"I mean...it made me feel amazing, like I could do anything. Maybe we need that?\""
    c "\"Quero dizer... me fez sentir incrível, como se eu pudesse fazer qualquer coisa. Talvez a gente precise disso?\""

# game/Carl-Mansion2.rpy:743
translate ptbr mansion2_e499761a:

    # "I frown."
    "Eu frunzo a testa."

# game/Carl-Mansion2.rpy:744
translate ptbr mansion2_d1151efe:

    # m "\"I dunno...\""
    m "\"Não sei...\""

# game/Carl-Mansion2.rpy:745
translate ptbr mansion2_70bd883b:

    # c "\"Not only that, but I felt like I knew what to do. It might save us.\""
    c "\"Não só isso, mas senti que sabia o que fazer. Pode nos salvar.\""

# game/Carl-Mansion2.rpy:746
translate ptbr mansion2_ab2aabb2:

    # "He stares back into my eyes."
    "Ele encara de volta nos meus olhos."

# game/Carl-Mansion2.rpy:747
translate ptbr mansion2_57eef530:

    # c "\"I know it's not really me, but it'll probably only be for the time that we're here.\""
    c "\"Sei que não sou eu de verdade, mas provavelmente vai ser só pelo tempo que estivermos aqui.\""

# game/Carl-Mansion2.rpy:748
translate ptbr mansion2_3b0cb0c2:

    # "I look away, thinking."
    "Olho para o lado, pensando."

# game/Carl-Mansion2.rpy:749
translate ptbr mansion2_c65a7bf0:

    # c "\"Then I'll be back to my old self.\""
    c "\"Depois eu volto a ser quem eu era.\""

# game/Carl-Mansion2.rpy:750
translate ptbr mansion2_2f219be0:

    # "He squeezes my shoulder."
    "Ele aperta meu ombro."

# game/Carl-Mansion2.rpy:751
translate ptbr mansion2_2d1e37ea:

    # c "\"But it's important to me what you think. We're in this together.\""
    c "\"Mas o que você pensa é importante para mim. Estamos nessa juntos.\""

# game/Carl-Mansion2.rpy:755
translate ptbr mansion2_1815ead9:

    # "No, whether or not it made Carl feel good I can't shake the bad feeling it gives me."
    "Não, quer isso fizesse o Carl se sentir bem ou não, não consigo me livrar do sentimento ruim que isso me traz."

# game/Carl-Mansion2.rpy:756
translate ptbr mansion2_3d008cb9:

    # "I rest a hand on his."
    "Apoio a mão na dele."

# game/Carl-Mansion2.rpy:757
translate ptbr mansion2_86c37272:

    # m "\"No, after everything that's happened I don't trust whatever it is.\""
    m "\"Não, depois de tudo o que aconteceu, eu não confio no que quer que seja isso.\""

# game/Carl-Mansion2.rpy:758
translate ptbr mansion2_7c69e27d:

    # "Carl watches me closely."
    "Carl me observa atentamente."

# game/Carl-Mansion2.rpy:759
translate ptbr mansion2_4f29437b:

    # m "\"Seriously, we need to be more careful. Besides...\""
    m "\"Sério, a gente precisa ter mais cuidado. Além disso...\""

# game/Carl-Mansion2.rpy:760
translate ptbr mansion2_2845c7c2:

    # "I lean my head against his shoulder again."
    "Apoio minha cabeça no ombro dele novamente."

# game/Carl-Mansion2.rpy:761
translate ptbr mansion2_e2e43f19:

    # m "\"We ARE in this together. We don't need that thing meddling with us to get through it.\""
    m "\"Nós ESTAMOS nessa juntos. Não precisamos dessa coisa se metendo com a gente para superar isso.\""

# game/Carl-Mansion2.rpy:762
translate ptbr mansion2_72b9ca34:

    # "I feel some of the tension go out of Carl's muscles and we wrap each other more tightly into our respective embraces."
    "Sinto parte da tensão sumir dos músculos do Carl e nos envolvemos com mais força em nossos respectivos abraços."

# game/Carl-Mansion2.rpy:763
translate ptbr mansion2_27dd1e85:

    # "We sit there for a while, Carl absorbing what I'd just said."
    "Ficamos sentados ali por um tempo, com Carl digerindo o que acabei de dizer."

# game/Carl-Mansion2.rpy:764
translate ptbr mansion2_535f4ca7:

    # "It's clear that whatever is influencing Carl and probably Jenna is powerful and we had to be careful."
    "Fica claro que o que quer que esteja influenciando o Carl e provavelmente a Jenna é poderoso, e que tínhamos que ser cuidadosos."

# game/Carl-Mansion2.rpy:765
translate ptbr mansion2_5f83ce02:

    # "Whatever he decides, I just pray it's the right decision."
    "O que quer que ele decida, só rezo para que seja a decisão certa."

# game/Carl-Mansion2.rpy:771
translate ptbr mansion2_1eae9075:

    # "While I don't exactly like the idea of whatever it is changing Carl influencing him, it might be our only choice."
    "Embora eu não goste muito da ideia do que quer que seja influenciar o Carl e mudá-lo, talvez seja nossa única escolha."

# game/Carl-Mansion2.rpy:772
translate ptbr mansion2_529e4d67:

    # m "\"I think—I think you should probably let it...\""
    m "\"Eu acho—eu acho que você provavelmente deveria deixar...\""

# game/Carl-Mansion2.rpy:773
translate ptbr mansion2_818f3f74:

    # c "\"Yeah?\""
    c "\"É?\""

# game/Carl-Mansion2.rpy:774
translate ptbr mansion2_17c262eb:

    # "Carl looks at me and I can tell he's a little surprised."
    "Carl olha para mim e percebo que ele está um pouco surpreso."

# game/Carl-Mansion2.rpy:775
translate ptbr mansion2_6f686fab:

    # m "\"Maybe. It's basically trying to help us, right? And if it's James he knows exactly what we need to do.\""
    m "\"Talvez. Basicamente está tentando nos ajudar, né? E se for o James, ele sabe exatamente o que precisamos fazer.\""

# game/Carl-Mansion2.rpy:776
translate ptbr mansion2_85118972:

    # c "\"Yeah...\""
    c "\"É...\""

# game/Carl-Mansion2.rpy:777
translate ptbr mansion2_c695073b:

    # "Carl sounds a little reluctant, but I can tell he's starting to agree with me."
    "Carl parece um pouco relutante, mas percebo que ele está começando a concordar comigo."

# game/Carl-Mansion2.rpy:778
translate ptbr mansion2_b167ba9d:

    # m "\"And it'll only be for the time that we're here. He just wants to show us his story, then we can get out.\""
    m "\"E vai ser só pelo tempo que estivermos aqui. Ele só quer nos mostrar a história dele, depois podemos sair.\""

# game/Carl-Mansion2.rpy:779
translate ptbr mansion2_3bf35674:

    # "I don't mention that a more confident Carl will make everything easier as well."
    "Não menciono que um Carl mais confiante também facilitaria tudo."

# game/Carl-Mansion2.rpy:780
translate ptbr mansion2_3eeaee4f:

    # "I just had to make sure that he and Jenna were carefully kept separate."
    "Eu só tinha que garantir que ele e a Jenna fossem mantidos separados com cuidado."

# game/Carl-Mansion2.rpy:781
translate ptbr mansion2_33d0efe0:

    # m "\"Either way, we ARE in this together. I'll make sure things don't get out of hand between you and...it.\""
    m "\"De qualquer forma, nós ESTAMOS nessa juntos. Vou garantir que as coisas não saiam do controle entre você e... isso.\""

# game/Carl-Mansion2.rpy:782
translate ptbr mansion2_27dd1e85_1:

    # "We sit there for a while, Carl absorbing what I'd just said."
    "Ficamos sentados ali por um tempo, com Carl digerindo o que acabei de dizer."

# game/Carl-Mansion2.rpy:783
translate ptbr mansion2_535f4ca7_1:

    # "It's clear that whatever is influencing Carl and probably Jenna is powerful and we had to be careful."
    "Fica claro que o que quer que esteja influenciando o Carl e provavelmente a Jenna é poderoso, e que tínhamos que ser cuidadosos."

# game/Carl-Mansion2.rpy:784
translate ptbr mansion2_5f83ce02_1:

    # "Whatever he decides, I just pray it's the right decision."
    "O que quer que ele decida, só rezo para que seja a decisão certa."

translate ptbr strings:

    # game/Carl-Mansion2.rpy:753
    old "Fight it."
    new "Lute contra isso."

    # game/Carl-Mansion2.rpy:753
    old "Let it help us."
    new "Deixe que nos ajude."

